#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/hub-e2e-subset — the hub browser subset consumer-ci.yml runs against this engine.
#
#   bin/hub-e2e-subset paths <list> <hub-dir>     print the listed spec paths, one per line;
#                                                 exit 1 naming every listed file the hub
#                                                 checkout does not have
#   bin/hub-e2e-subset audit <list> <report.json> exit 1 unless every listed file executed
#                                                 at least one test and none was skipped
#   bin/hub-e2e-subset triage <list> <report.json> <hub-dir>
#                                                 print the ONE E2E_LANE line naming the
#                                                 lane and the spec files that made it red;
#                                                 always exit 0 (it reports, never gates).
#                                                 SETUP_OUTCOMES="<step-id>=<outcome> ..."
#                                                 (in job order) names a setup step that
#                                                 went red before Playwright could run
#
# WHY THE AUDIT. Playwright's exit code says the tests it RAN passed. It cannot say it
# ran the ones we asked for: a listed spec whose every test is quarantined (the job
# passes --grep-invert @quarantine), skipped or fixme'd contributes nothing and the
# job still exits 0. The receipt is the only place that shows it. The list file's
# header says why these specs (.github/hub-e2e-subset.txt).
#
# Stdlib only: it audits the lane, so a bundle problem in the lane must not break it.

require "json"

module HubE2eSubset
  module_function

  def read_list(path)
    File.readlines(path, chomp: true).map { |l| l.sub(/#.*/, "").strip }.reject(&:empty?)
  end

  def missing(list, hub_dir)
    list.reject { |rel| File.file?(File.join(hub_dir, rel)) }
  end

  # Playwright names a suite's file relative to testDir ("navbar_layout.spec.js");
  # the list names it relative to the hub ("e2e/navbar_layout.spec.js"). Compare on
  # the part after e2e/ so a nested spec dir still matches.
  def key(rel) = rel.sub(%r{\Ae2e/}, "")

  # => { "navbar_layout.spec.js" => { ran: n, skipped: n } }
  def tally(report)
    rows = Hash.new { |h, k| h[k] = { ran: 0, skipped: 0 } }
    walk = lambda do |suite, file|
      file = suite["file"] || file
      Array(suite["specs"]).each do |spec|
        Array(spec["tests"]).each do |test|
          results = Array(test["results"])
          if results.empty? || results.all? { |r| r["status"] == "skipped" }
            rows[file][:skipped] += 1
          else
            rows[file][:ran] += 1
          end
        end
      end
      Array(suite["suites"]).each { |child| walk.call(child, file) }
    end
    Array(report["suites"]).each { |s| walk.call(s, nil) }
    rows
  end

  LANE = "hub-browser"
  FAILED_RESULTS = %w[failed timedOut interrupted].freeze

  # A test failed when Playwright's own verdict is "unexpected"; a report without the
  # test-level status falls back to its results (a retried test that passed is "flaky",
  # not a failure, so the verdict field wins whenever it is present).
  def failed_test?(test)
    return test["status"] == "unexpected" if test.key?("status")

    results = Array(test["results"])
    !results.empty? && results.all? { |r| FAILED_RESULTS.include?(r["status"]) }
  end

  # => ["e2e/a.spec.js", ...] in the list's own spelling where the list names the file.
  def failing_files(list, report)
    by_key = list.to_h { |rel| [key(rel), rel] }
    files = []
    walk = lambda do |suite, file|
      file = suite["file"] || file
      Array(suite["specs"]).each do |spec|
        files << file if Array(spec["tests"]).any? { |t| failed_test?(t) }
      end
      Array(suite["suites"]).each { |child| walk.call(child, file) }
    end
    Array(report["suites"]).each { |s| walk.call(s, nil) }
    files.compact.uniq.map { |f| by_key.fetch(f, f) }
  end

  # "apt=success bundle=failure npm=skipped" => ["bundle"]: the setup steps (apt, Ruby,
  # bundle, Node, npm ci, the browser install, the migrations) that went red, in job order.
  # The workflow passes every setup step's outcome, so a red before Playwright is named
  # by its step id instead of reading as a missing receipt.
  def failed_setup(outcomes)
    outcomes.to_s.split.filter_map do |pair|
      id, outcome = pair.split("=", 2)
      id if outcome == "failure"
    end
  end

  # The one line. Checked in the order the job runs, so it names the FIRST thing that
  # went red: the list against the checkout, then a setup step, then the receipt's
  # failures, then the receipt's own errors, then the coverage audit.
  def triage_line(list, report_path, hub_dir, setup_outcomes = nil)
    head = "::error::E2E_LANE #{LANE} RED"
    return "#{head}: the hub checkout never landed at #{hub_dir}; the lane failed before any spec" unless File.directory?(hub_dir)

    gone = missing(list, hub_dir)
    return "#{head}: listed spec(s) missing from the hub checkout (renamed or deleted): #{gone.join(', ')}" unless gone.empty?

    red_setup = failed_setup(setup_outcomes).first
    return "#{head}: setup step #{red_setup} failed before any spec ran (see that step's log)" if red_setup
    return "#{head}: no receipt at #{report_path}; Playwright never finished (see its step log)" unless File.file?(report_path)

    report = JSON.parse(File.read(report_path))
    failing = failing_files(list, report)
    return "#{head}: #{failing.length} failing spec file(s): #{failing.join(', ')}" unless failing.empty?

    errors = Array(report["errors"])
    unless errors.empty?
      first = errors.first["message"].to_s.lines.first.to_s.strip
      return "#{head}: #{errors.length} Playwright error(s) outside any test (config, boot or webServer): #{first}"
    end

    flagged = audit_failures(list, report).map { |f| f.split(" ", 2).first }
    return "#{head}: listed spec(s) ran no test or skipped some: #{flagged.join(', ')}" unless flagged.empty?

    "#{head}: no failing spec in the receipt; read the failed step's log"
  rescue JSON::ParserError => e
    "#{head}: the receipt at #{report_path} is not JSON (#{e.message.lines.first.strip})"
  end

  def audit_failures(list, report)
    rows = tally(report)
    list.filter_map do |rel|
      row = rows.fetch(key(rel), { ran: 0, skipped: 0 })
      if row[:ran].zero?
        "#{rel} executed no test (#{row[:skipped]} skipped) — absent from the receipt, " \
          "quarantined, skipped or renamed"
      elsif row[:skipped].positive?
        "#{rel} skipped #{row[:skipped]} test(s); the subset runs whole or says why"
      end
    end
  end
end

if $PROGRAM_NAME == __FILE__
  cmd, list_path, target = ARGV
  abort "usage: bin/hub-e2e-subset paths|audit|triage <list> <hub-dir|report.json> [hub-dir]" unless list_path && target
  list = HubE2eSubset.read_list(list_path)
  abort "#{list_path} names no spec" if list.empty?

  case cmd
  when "paths"
    gone = HubE2eSubset.missing(list, target)
    unless gone.empty?
      warn "::error::HUB E2E SUBSET: RED — the hub checkout has no #{gone.join(', ')}."
      warn "  The hub renamed or deleted a listed spec. Repoint or drop it in #{list_path}."
      exit 1
    end
    puts list
  when "audit"
    abort "HUB E2E SUBSET: RED — no receipt at #{target}; the lane did not run to the end" unless File.file?(target)
    failures = HubE2eSubset.audit_failures(list, JSON.parse(File.read(target)))
    if failures.empty?
      puts "HUB E2E SUBSET: GREEN — all #{list.length} listed specs executed, none skipped"
    else
      warn "HUB E2E SUBSET: RED"
      failures.each { |f| warn "  ✗ #{f}" }
      exit 1
    end
  when "triage"
    puts HubE2eSubset.triage_line(list, target, ARGV[3].to_s, ENV["SETUP_OUTCOMES"])
  else
    abort "unknown command #{cmd.inspect}: paths | audit | triage"
  end
end
