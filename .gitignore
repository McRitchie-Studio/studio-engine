/.worktrees/

# The browser lane (e2e/). All build output or run output — nothing here is source.
# No trailing slash and no leading slash: '/node_modules/' is a DIRECTORY
# pattern and does not match a symlink, so a machine-local link into another
# worktree was committed and reached accepted.
node_modules
# A desk that links its packages writes .npmrc (script-shell = the npm script guard,
# the hub's bin/lib/desk_node_modules.rb); ignored so the desk stays clean for `git worktree remove`.
/.npmrc
/test-results/
/playwright-report/
/e2e-report.json
/e2e-report-shard-*.json
# The dummy's public folder holds no committed file. A few minitest suites write a
# file here and remove it in teardown, and labs older than tmp/e2e-lab wrote their
# assets here (the next boot removes those).
/test/dummy/public/

# Rails writes here when e2e/boot.rb boots the dummy (the theme CSS cache), and
# e2e/boot.rb writes the lab's own public folder and database to tmp/e2e-lab.
/tmp/
/test/dummy/tmp/

# Screenshots dropped at the repo root by a build or review pass. No root image is
# source (engine images live under app/assets/images/), so a stray capture here is
# never committed by accident again.
/*.png
/*.jpg
/*.jpeg
