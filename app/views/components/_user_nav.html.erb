<%# Shared right-side navbar user section.

    Slot locals (all optional). Each slot names a partial to render in
    that position — a String partial path, or a Hash of
    { partial: "path", locals: { ... } } when the partial needs locals:
      balance_slot     — balance display, rendered at the start of the
                         top row (e.g. a wallet balance link)
      extra_icons_slot — app-specific icon buttons, rendered before the
                         admin gear + theme toggle
      div2_slot        — replaces the default second row (the wallet
                         address + level progress bar) entirely
                         (e.g. a seeds bar)

    Config, not locals: the signed-in name is Studio.navbar_user_name
    (default display_name) and the signed-out button reads
    Studio.sign_in_label (default "Log in"); lib/studio/navbar_identity.rb.
    Studio.navbar_avatar_badge (default nil) draws one partial over the
    avatar, and Studio.navbar_menu_trigger (default nil) replaces the admin
    dropdown in the icon rail; lib/studio/navbar_slots.rb.
    Studio.navbar_account_sidebar (default nil) makes the account control
    open a host sidebar; lib/studio/navbar_account_sidebar.rb.

    Legacy string locals (deprecated): balance_html, extra_icons_html,
    div2_html — pre-rendered HTML injected via raw. Still honored when
    the matching slot local is absent, so existing call sites render
    unchanged. Prefer the slot locals for new work; they go through the
    normal partial pipeline instead of trusting a raw string.
%>
<% balance_slot     ||= nil %>
<% extra_icons_slot ||= nil %>
<% div2_slot        ||= nil %>
<% balance_html     ||= nil %>
<% extra_icons_html ||= nil %>
<% div2_html        ||= nil %>
<%# Slot resolution: the slot local wins when both a slot and its legacy
    string are passed. Returns nil when neither is present. %>
<% studio_nav_slot = lambda do |slot, legacy_html|
     if slot.is_a?(Hash)
       render slot[:partial], **slot.fetch(:locals, {})
     elsif slot.present?
       render slot.to_s
     elsif legacy_html.present?
       raw legacy_html
     end
   end %>

<%# Where the account control (the username and the avatar, one control) points
    when it is a link: an app with no link sidebar. Where the sidebar renders,
    the control opens it instead (Div 3 below).

    A HOST'S OWN account_path WINS: an app that already has an account page keeps
    it rather than being repointed at a thinner /profile by a routine dependency
    bump. An app adopting /profile flips over by DELETING its account route, so
    the last step of the migration is the deliberate one.

    NO CONSUMER EXERCISES THAT BRANCH TODAY, and the comment here said otherwise
    until 2026-08-14. turf-monster is the only app with an account_path, and it
    ships its own app/views/components/_user_nav.html.erb — a host view SHADOWS
    the engine's in this non-isolated engine, so turf never renders THIS file.
    The rule is for apps that adopt /profile later.

    nil when NEITHER exists, and then the name and avatar render as plain text.
    They used to render `href="#"`, which was not a graceful degradation but a
    dead link. Who that actually reached: mcritchie-industries and
    acquisition-studio — the consumers rendering this partial rather than a fork
    of it. A link that goes nowhere looks identical to one that works until it is
    clicked, which is why nobody reported it.
%>
<%# Studio.navbar_menu_trigger: the host's menu control in the admin
    dropdown's seat (the icon rail from md, and the signed-out rail). %>
<% menu_trigger = respond_to?(:studio_navbar_menu_trigger) ? studio_navbar_menu_trigger : nil %>
<% studio_nav_destination =
     if defined?(account_path)
       account_path
     elsif defined?(profile_path)
       profile_path
     end %>

<div class="flex gap-2">
  <% if logged_in? %>
    <%# Left column: Div 1 + Div 2 stacked.
        min-w-0 belongs HERE, on the flex item of the nav root: a flex item
        defaults to min-width auto, and without it this column refuses to
        shrink below balance + icons. On a 320px phone with a balance the
        reserved column is 147px, and a column that will not give pushed the
        avatar 17px past the screen edge (e2e/header_phone_width.spec.js).
        It is a centred flex column, so with no second row the icons sit level
        with the name and avatar rather than at the top of the bar.
        data-nav-rows says which navbar this is: "1" when no second row renders,
        and then engine.css sizes the account on the rule of 3 (THE ACCOUNT
        ROW there). A two-row nav keeps the engine's 2rem avatar under its row. %>
    <% div2_content = studio_nav_slot.call(div2_slot, div2_html) %>
    <% server_level = current_user.respond_to?(:level) && current_user.level.present? ? current_user.level : nil %>
    <% wallet_connected = current_user.respond_to?(:truncated_solana) && current_user.try(:solana_connected?) %>
    <% nav_rows = div2_content.present? || server_level || wallet_connected ? 2 : 1 %>
    <div class="flex-1 min-w-0 flex flex-col justify-center" data-nav-tools data-nav-rows="<%= nav_rows %>">
      <%# Div 1 (Bigger): balance + icons. %>
      <div class="flex items-center gap-2 leading-none" :style="'padding: 0 6px;' + ($store.devMode ? 'background: cornflowerblue;' : '')">
        <%= studio_nav_slot.call(balance_slot, balance_html) %>
        <div class="flex items-center gap-2 ml-auto self-end">
          <%# The theme toggle leads the rail, then the app's icons, then the
              gear. Desktop only: below md the engine navbar's phone row draws
              the theme toggle, so a second one here put two on every phone. The
              signed-out bar has always done it this way (layouts/_navbar). %>
          <span class="hidden md:flex" data-nav-theme-toggle="desktop"><%= render "components/theme_toggle_morph" %></span>
          <%= studio_nav_slot.call(extra_icons_slot, extra_icons_html) %>
          <%# Skipped when the link sidebar carries the admin menu — two cog
              glyphs side by side read as a double gear. Desktop only, like
              the theme toggle: below md the navbar's phone row draws the cog,
              so a second one here put two on an admin's phone. %>
          <% if menu_trigger %>
          <span class="hidden md:block" data-nav-menu-trigger><%= studio_navbar_slot_tag(menu_trigger) %></span>
          <% else %>
          <%= render "components/admin_dropdown", display_class: "hidden md:block" unless respond_to?(:studio_sidebar_replaces_admin_menu?) && studio_sidebar_replaces_admin_menu? %>
          <% end %>
        </div>
      </div>
      <% if div2_content.present? %>
        <%# Div 2 replaced by the consumer's slot (div2_slot or legacy div2_html). %>
        <%= div2_content %>
      <% elsif server_level || wallet_connected %>
        <%# Div 2 (Smaller): wallet address (left) + level (right) with progress
            bar. Renders only when it has something to show — an off-chain,
            level-less user gets NO second row, so the
            nav collapses to one line instead of an empty progress strip. %>
        <div x-data="{
               barWidth: 0,
               displayLevel: <%= server_level || 1 %>,
               leveledUp: false,
               init() {
                 var self = this;
                 var data = this.getSeedsData();
                 if (data) {
                   self.displayLevel = data.level;
                   setTimeout(function() { self.barWidth = data.progress; }, 150);
                 }
               },
               getSeedsData() {
                 try {
                   var raw = localStorage.getItem('seedsNavbar');
                   if (!raw) return null;
                   return JSON.parse(raw);
                 } catch(e) { return null; }
               },
               replayLevel() {
                 var self = this;
                 var data = this.getSeedsData();
                 var finalPct = data ? data.progress : self.barWidth;
                 self.displayLevel = Math.max(1, self.displayLevel - 1);
                 self.barWidth = 60;
                 setTimeout(function() { self.barWidth = 100; }, 300);
                 setTimeout(function() { self.displayLevel += 1; self.leveledUp = true; }, 1500);
                 setTimeout(function() { self.leveledUp = false; self.barWidth = 0; }, 2800);
                 setTimeout(function() { self.barWidth = finalPct; }, 3000);
               },
               handleSeedsUpdate(d) {
                 var self = this;
                 if (d.levelUp) {
                   self.barWidth = d.oldPct;
                   setTimeout(function() { self.barWidth = 100; }, 300);
                   setTimeout(function() { self.displayLevel = d.newLevel; self.leveledUp = true; }, 1500);
                   setTimeout(function() { self.leveledUp = false; self.barWidth = 0; }, 2800);
                   setTimeout(function() { self.barWidth = d.progress; }, 3000);
                 } else {
                   self.displayLevel = d.level;
                   self.barWidth = d.progress;
                 }
               }
             }"
             @navbar-replay-level.window="replayLevel()"
             @navbar-seeds-update.window="handleSeedsUpdate($event.detail)"
             class="relative mt-0.5" style="height: 14px;">
          <%# Fill bar %>
          <div class="absolute inset-y-0 left-0 rounded z-0" style="background: var(--color-cta-fill, var(--color-cta)); transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);" :style="{ width: barWidth + '%' }"></div>
          <%# Text layer 1: muted (visible outside bar) %>
          <div class="absolute inset-0 flex items-center justify-between px-1.5 font-mono text-muted z-[1] nav-bar-text">
            <span>
              <% if wallet_connected %>
                <%= current_user.truncated_solana %>
              <% end %>
            </span>
            <% if server_level %>
              <span :class="leveledUp && 'nav-level-pop'" x-text="'Level ' + displayLevel">Level <%= server_level %></span>
            <% end %>
          </div>
          <%# Text layer 2: white (clip-path reveals where bar covers) %>
          <div class="absolute inset-0 flex items-center justify-between px-1.5 font-mono text-white z-[2] nav-bar-text" :style="{ 'clip-path': 'inset(0 ' + (100 - barWidth) + '% 0 0)' }">
            <span>
              <% if wallet_connected %>
                <%= current_user.truncated_solana %>
              <% end %>
            </span>
            <% if server_level %>
              <span :class="leveledUp && 'nav-level-pop'" x-text="'Level ' + displayLevel">Level <%= server_level %></span>
            <% end %>
          </div>
        </div>
        <style>
          @keyframes navLevelPop {
            0% { transform: scale(1); }
            15% { transform: scale(1.5); }
            35% { transform: scale(1.2); }
            50% { transform: scale(1.4); }
            70% { transform: scale(1.1); }
            100% { transform: scale(1); }
          }
          .nav-level-pop { animation: navLevelPop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); }
          .nav-bar-text { font-size: 10px; }
        </style>
      <% end %>
    </div>
    <%# Div 3 (Account): the name and the avatar are ONE control, one tab
        stop — they used to be two links to the same place.
        Below md the name is screen-reader text and the avatar stands alone,
        so a phone never shows the name truncated to "Guest 55…"; from md up
        it shows beside the avatar and truncates when the row is tight.

        The control never shrinks (the avatar must stay on screen); the icon
        column beside it is what gives way. So the name cannot truncate by
        flex shrinking: from md up its box carries a max width instead, and
        the name ellipsizes inside it. The avatar is aria-hidden: the name is
        the control's accessible name.

        WHERE THE LINK SIDEBAR RENDERS, THE ACCOUNT OPENS IT. The sidebar
        heads with the engine's "You > Profile" section, so the name and avatar open it as the gear does
        (studio_account_opens_sidebar?, which StudioSidebarHelper answers with
        studio_sidebar?; a host may define its own). It is then a BUTTON, not a
        link: it does not navigate, and a screen reader announces "Alex, button,
        dialog" rather than a link that goes nowhere it says. studio/link_sidebar
        claims its click from the document, before Alpine binds, as it does the
        gear's. An app with no sidebar keeps the link to the account page. %>
    <%# Studio.navbar_account_sidebar: a HOST sidebar the control opens
        instead (a button toggling the host's store flag, built by the engine
        from validated names). It wins over the link sidebar and the account
        link. It carries data-profile-image-toggle, so a host handler that
        claims its triggers in the capture phase, before Alpine binds, claims
        this one; the guarded @click is the path when nothing claims it. Its
        controls may not name the engine's own link sidebar ids, refused at
        assignment (lib/studio/navbar_account_sidebar.rb). %>
    <% account_sidebar = respond_to?(:studio_navbar_account_sidebar) ? studio_navbar_account_sidebar : nil %>
    <% account_opens_sidebar = !account_sidebar && respond_to?(:studio_account_opens_sidebar?) && studio_account_opens_sidebar? %>
    <% account_classes = "group flex items-center gap-2 flex-shrink-0" %>
    <%# Studio.navbar_phone_name: the name shows below md too, capped, and
        fades at its edge when it overflows (engine.css, THE PHONE NAME). %>
    <% phone_name = Studio.navbar_phone_name %>
    <% account_inner = capture do %>
      <% if phone_name %><span class="min-w-0 max-w-[4.5rem] min-[400px]:max-w-[6rem] md:max-w-40" data-nav-name-phone><% else %><span class="sr-only md:not-sr-only md:max-w-40"><% end %><span class="block truncate text-right text-heading font-semibold text-base leading-none transition<%= " group-hover:text-primary" if account_sidebar || account_opens_sidebar || studio_nav_destination %>" data-nav-name><%= Studio.navbar_user_name_for(current_user, self) %></span></span>
      <span class="flex-shrink-0 flex items-center" aria-hidden="true">
        <%= render "components/avatar", user: current_user, size: "nav" %>
      </span>
    <% end %>
    <% if account_sidebar %>
      <% account_js = studio_navbar_account_sidebar_expressions(account_sidebar) %>
      <%= tag.button type: "button", class: "#{account_classes} cursor-pointer rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40",
                     data: { nav_account: "", profile_image_toggle: "" },
                     aria: { controls: account_sidebar[:controls], haspopup: "dialog" },
                     ":aria-expanded": account_js[:expanded], "@click.stop": account_js[:toggle],
                     "x-bind:style": "$store.devMode && 'background: lightgreen'" do %><%= account_inner %><% end %>
    <% elsif account_opens_sidebar %>
      <button type="button" class="<%= account_classes %> cursor-pointer rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" data-nav-account data-profile-image-toggle
              aria-controls="studio-link-sidebar studio-link-sidebar-mobile" aria-haspopup="dialog"
              :aria-expanded="$store.sidebars && $store.sidebars.linkTreeOpen ? 'true' : 'false'"
              x-bind:style="$store.devMode && 'background: lightgreen'"><%= account_inner %></button>
    <% elsif studio_nav_destination %>
      <%= link_to account_inner, studio_nav_destination, class: account_classes, "data-nav-account": "", "x-bind:style": "$store.devMode && 'background: lightgreen'" %>
    <% else %>
      <span class="<%= account_classes %>" data-nav-account x-bind:style="$store.devMode && 'background: lightgreen'"><%= account_inner %></span>
    <% end %>
    <%# Studio.navbar_avatar_badge: one partial over the avatar's upper-left
        corner, the way a notification dot rides a profile picture. Its seat
        is a SIBLING of the account control, never inside it: the control stays
        one tab stop, and the badge may carry its own button (a button inside a
        link or button is invalid and reaches a screen reader as nothing).
        The seat comes right after the control, and engine.css (THE AVATAR
        BADGE) places it out of flow over the avatar, which ends the row, so the
        row gives it no width. nil (the default) renders the same bytes as
        before. %>
    <% avatar_badge = respond_to?(:studio_navbar_avatar_badge) ? studio_navbar_avatar_badge : nil %>
    <% if avatar_badge %>
    <div data-nav-avatar-badge><%= studio_navbar_slot_tag(avatar_badge) %></div>
    <% end %>
  <% else %>
    <% if menu_trigger %>
    <span class="hidden md:block" data-nav-menu-trigger><%= studio_navbar_slot_tag(menu_trigger) %></span>
    <% else %>
    <%= render "components/admin_dropdown", display_class: "hidden md:block" unless respond_to?(:studio_sidebar_replaces_admin_menu?) && studio_sidebar_replaces_admin_menu? %>
    <% end %>
    <%# Desktop only, as above: the phone row carries the toggle below md. %>
    <span class="hidden md:flex" data-nav-theme-toggle="desktop"><%= render "components/theme_toggle_morph" %></span>
    <div class="flex items-center gap-3 ml-auto">
      <%= link_to Studio.sign_in_label, login_path, class: "text-heading hover:text-primary text-sm font-semibold transition" %>
      <%= link_to "Sign up", signup_path, class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>
