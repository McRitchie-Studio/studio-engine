<%# The link sidebar — the engine's out-of-the-box navigation panel (lifted
    from the mcritchie-studio hub). Renders the host's Studio.sidebar_sections
    as a slide-out link tree in dual desktop/mobile panels. Render it once,
    outside any sticky/backdrop-filter header (a fixed panel inside one
    positions against the header, not the viewport); the engine navbar does
    this automatically when sections are declared. %>
<% sections = studio_sidebar_sections %>
<% sidebar_admin = respond_to?(:admin?) && admin? %>
<%# THE PANEL'S TITLE. Signed in, admin included: the name the navbar shows, from the
    same call. Signed out: a greeting by the browser's local time, which the server
    cannot know, so studio/link_sidebar writes the word over this default before the
    panel opens (greetingFor). The panel is hidden until then, so nothing flashes.

    It goes in the panel's lead slot (title_html), not its title. A title names the
    panel through aria-labelledby, and "Good morning" or "Alex" is no name for a
    menu: the panel keeps "Admin menu" or "Links menu" as its aria-label. %>
<% sidebar_signed_in = respond_to?(:logged_in?) && logged_in? %>
<% sidebar_user = sidebar_signed_in && respond_to?(:current_user) ? current_user : nil %>
<% sidebar_title_class = "type-subhead text-heading truncate pr-3" %>
<% sidebar_title_html =
     if sidebar_user
       sidebar_name = Studio.navbar_user_name_for(sidebar_user, self).to_s.squish
       tag.p(sidebar_name, class: sidebar_title_class, title: sidebar_name, data: { link_sidebar_title: "" })
     elsif !sidebar_signed_in
       tag.p("Good morning", class: sidebar_title_class, data: { link_sidebar_title: "", link_sidebar_greeting: "" })
     end %>
<%# THE GROUPS. No section shows a label word and none shows the admin chip: a divider
    separates the groups. The words stay as each group's accessible name, so a screen
    reader still announces them. An empty section draws no group, or its two dividers
    would touch.

    A ROW IS ONE LINE AT REST, with or without a desc:, so the spacing never changes. A
    desc: fades in on hover or keyboard focus, and nothing moves to make room: it sits
    absolutely in the row's padding as the label lifts by a transform. engine.css, THE
    SIDEBAR ROW'S DESCRIPTION, holds the rules. A row with no desc: gains no attribute. %>
<% sidebar_group = lambda do |title:, admin:, first:, &block|
     name = [title.presence, ("admin" if admin)].compact.join(", ").presence
     tag.div(role: "group", aria: { label: name }, class: ["py-1", ("border-t border-subtle" unless first)], &block)
   end %>
<% close_action = "$store.sidebars.linkTreeOpen = false" %>

<style>
  /* Clip horizontal overflow so the off-canvas start/end frame of the slide
     never flashes a scrollbar. `clip` (not `hidden`) does not create a scroll
     container, so sticky headers keep working. Scoped here — not engine.css —
     so apps that declare no sections get zero global CSS change. */
  html { overflow-x: clip; }
</style>

<%# The open flag ($store.sidebars.linkTreeOpen) and the document handlers that
    flip it are studio/link_sidebar, a nonced module the head loads. This anchor
    is the link-sidebar controller's element. %>
<template data-studio-controller="link-sidebar"></template>

<% body_html = capture do %>
  <nav class="flex-1 min-h-0 overflow-y-auto py-1" aria-label="Studio links">
    <% sections.select { |section| section[:links].any? }.each_with_index do |section, index| %>
      <%= sidebar_group.call(title: section[:title], admin: section[:admin], first: index.zero?) do %>
      <% section[:links].each do |link| %>
        <% target = link[:target].presence %>
        <%= link_to link[:href],
              class: "group flex items-center gap-3 px-4 py-3 text-sm text-body hover:text-heading hover:bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-inset transition",
              target: target,
              rel: target == "_blank" ? "noopener" : nil,
              "data-sidebar-row-described": (link[:desc].present? ? "" : nil),
              "@click": close_action do %>
          <% if link[:hover_emoji].present? %>
            <%= render "components/emoji_swap",
                  base: link[:emoji],
                  hover: link[:hover_emoji],
                  class_name: "text-lg leading-none" %>
          <% else %>
            <span class="text-lg leading-none flex-shrink-0"><%= link[:emoji] %></span>
          <% end %>
          <% if link[:desc].present? %>
            <span class="relative min-w-0 flex-1">
              <span class="block font-medium truncate" data-sidebar-row-label><%= link[:label] %></span>
              <span class="block truncate text-xs text-muted" data-sidebar-row-desc><%= link[:desc] %></span>
            </span>
          <% else %>
            <span class="min-w-0">
              <span class="block font-medium truncate"><%= link[:label] %></span>
            </span>
          <% end %>
        <% end %>
      <% end %>
      <% end %>
    <% end %>

    <%# THE GEO SIGNPOST — how a sidebar-chrome app gets geo signage at all.

        This panel IS the admin menu wherever the host declares an admin-flagged
        section (studio_sidebar_replaces_admin_menu?), and in exactly that case
        the engine suppresses components/_admin_dropdown — so before this block
        every app on this chrome was guaranteed NEVER to see the row the 0.58.0
        signpost added, including the one carrying the largest admin surface in
        the ecosystem. mcritchie-studio is that one:
        app/views/layouts/application.html.erb renders this partial, and
        app/helpers/link_tree_helper.rb stamps `admin: true` on every admin
        section it declares. mcritchie-industries is the other.

        Engine-owned rather than host-declared on purpose. Appending it to
        Studio.sidebar_sections instead would make studio_sidebar? and
        studio_sidebar_replaces_admin_menu? true for apps that declare NO
        sections — raising a sidebar where none existed and taking Theme,
        Navbar and Error Logs away from apps that rely on the dropdown.

        EXACTLY ONE HOME PER APP, which is what the second half of the gate
        buys. A host that declares only PUBLIC sections keeps the dropdown —
        the engine navbar renders BOTH chromes for that shape, deliberately, so
        its admins never lose Theme, Navbar and Error Logs. Signposting geo here
        as well would show such an admin the same row twice, in two menus open
        at the same time. So the row goes wherever the admin menu IS: the
        dropdown for that shape, this panel for the shape that suppresses the
        dropdown.

        The predicate is `studio_sidebar_replaces_admin_menu?` (see
        StudioSidebarHelper), computed here from the sections already in hand
        rather than called: this partial renders in hosts and test rigs that
        provide studio_sidebar_sections without the rest of the helper, and a
        bare call would raise for them. The two must stay the same question —
        if the helper's rule changes, this changes with it. %>
    <% if sidebar_admin && sections.any? { |section| section[:admin] } %>
      <%= sidebar_group.call(title: "Geo", admin: true, first: false) do %>
        <%= render "components/geo_signpost", variant: :sidebar, close_action: close_action %>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% footer_html = capture do %>
  <% if logged_in? %>
    <div class="border-t border-subtle p-2">
      <%= link_to logout_path,
            class: "flex items-center gap-3 rounded-md px-4 py-3 text-sm text-body hover:text-heading hover:bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 transition",
            "@click": close_action do %>
        <span>👋</span><span>Log out</span>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render "components/sidebar_panel",
      id: "studio-link-sidebar",
      title_html: sidebar_title_html,
      open: "$store.sidebars.linkTreeOpen",
      body_html: body_html,
      footer_html: footer_html,
      close_action: close_action,
      outside_action: close_action,
      escape_action: close_action,
      display_class: "hidden md:flex",
      role: "navigation",
      aria_label: sidebar_admin ? "Admin menu" : "Links menu" %>

<%= render "components/sidebar_panel",
      id: "studio-link-sidebar-mobile",
      title_html: sidebar_title_html,
      open: "$store.sidebars.linkTreeOpen",
      body_html: body_html,
      footer_html: footer_html,
      close_action: close_action,
      outside_action: close_action,
      escape_action: close_action,
      display_class: "flex md:hidden",
      width_class: "w-full",
      role: "navigation",
      aria_label: sidebar_admin ? "Admin menu" : "Links menu" %>
