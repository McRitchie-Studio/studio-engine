<%# Base navbar partial — apps can override by creating their own app/views/layouts/_navbar.html.erb
    Locals (all optional):
      show_logged_in  — override for logged_in? (default: real session)
      preview         — if true, disables scroll handler and sticky positioning
      balance_html    — raw HTML for balance display (passed through to _user_nav)
      extra_icons_html — raw HTML for extra icon buttons (passed through to _user_nav)
      balance_slot, extra_icons_slot, div2_slot, div2_html
                      — components/_user_nav's slot locals (a partial path, or
                        { partial:, locals: }), forwarded to it as given. A
                        balance_slot reserves the balance column as balance_html
                        does. extra_icons_slot is rendered here, so the link
                        sidebar's trigger still follows it; like the user nav,
                        a slot wins over its legacy _html string.
      brand_heading   — boolean, draw the brand title as the page's h1 (default: true).
                        Pass false on a page that carries its own h1: the brand is
                        drawn as a div with the same classes and contents.
%>
<% show_user = local_assigns.fetch(:show_logged_in, logged_in?) %>
<% is_preview = local_assigns.fetch(:preview, false) %>
<%# Smooth-load self-pin (engine 0.26): when the app opts into Studio.smooth_load,
    the sticky header names itself as the shared view-transition group
    (vt-pinned-header) so page content transitions beneath a navbar that stays
    put — hosts no longer shadow this partial just to add the class. Non-preview
    branch ONLY: preview renders can repeat per page, and a duplicate
    view-transition-name silently disables every transition. With the flag off,
    nothing extra renders. %>
<% pin_header = Studio.smooth_load && !is_preview %>
<% balance_html = local_assigns.fetch(:balance_html, nil) %>
<% extra_icons_html = local_assigns.fetch(:extra_icons_html, nil) %>
<%# The user nav's slot locals, forwarded only when passed, so a navbar that
    passes none renders the user nav exactly as before. %>
<% user_nav_slots = local_assigns.slice(:balance_slot, :div2_slot, :div2_html).compact %>
<% extra_icons_slot = local_assigns[:extra_icons_slot] %>
<% if extra_icons_slot.present? %>
  <% extra_icons_html = extra_icons_slot.is_a?(Hash) ? render(extra_icons_slot[:partial], **extra_icons_slot.fetch(:locals, {})) : render(extra_icons_slot.to_s) %>
<% end %>
<% brand_tag = local_assigns.fetch(:brand_heading, true) ? "h1" : "div" %>
<%# Out-of-the-box navigation (engine 0.30): when the host declares
    Studio.sidebar_sections, the navbar mounts the link-sidebar trigger in its
    icon rails and renders the slide-out panels after the header. With no
    sections (the default) all of this is skipped — the navbar is unchanged.
    Preview renders skip it too: the /admin/navbar page renders this partial
    repeatedly and the panels carry page-unique ids. %>
<% sidebar_active = !is_preview && respond_to?(:studio_sidebar?) && studio_sidebar? %>
<%# Studio.navbar_links: links for the desktop bar and phone row.
    Empty by default, which renders the same bytes as before. %>
<% navbar_links = respond_to?(:studio_navbar_links) ? studio_navbar_links : [] %>
<%# Studio.navbar_items: partials after the links, in both rows. Empty by
    default, which renders the same bytes as before. %>
<% navbar_items = respond_to?(:studio_navbar_items) ? studio_navbar_items : [] %>
<%# Studio.navbar_signed_out_cta: signed out, the primary button can carry a
    call to action instead of sign-in. nil (the default) renders the same bytes
    as before. Set, sign-in stays one tap away as a quiet text link: beside the
    button from md, and in the phone row below md, where the top row has no
    room for two controls beside the brand. %>
<% signed_out_cta = !show_user && respond_to?(:studio_navbar_signed_out_cta) ? studio_navbar_signed_out_cta : nil %>
<% if sidebar_active %>
  <% sidebar_trigger_desktop = capture { render "components/link_sidebar_trigger", class_name: "hidden md:inline-flex" } %>
  <% extra_icons_html = safe_join([extra_icons_html, sidebar_trigger_desktop].compact) %>
<% end %>
<%
  words = Studio.app_name.split
  last_word = words.pop
  prefix = words.join(" ")
  logo_path = Studio.logo_for("Navbar Logo")
  wordmark = Studio.navbar_wordmark
  # Studio.navbar_brand: the host's logo, its size and alt, and the title as
  # words with the host's classes. nil (the default) draws as before.
  brand = Studio.navbar_brand
  logo_path = brand[:logo] if brand && brand[:logo]
  logo_alt = (brand && brand[:alt]) || Studio.app_name
  logo_size = brand && brand[:logo_size]
  brand_words = brand && brand[:words]
%>

<%# nav-shell is the --nav-p scope: the engine's nav-collapse controller (studio/nav_collapse) writes
    the collapse progress, 0 expanded .. 1 collapsed, on THIS element once per
    animation frame, and the band table below derives the row padding, logo size
    and title sizes from it with calc(). Nothing on the collapse path carries a
    time-based transition — the head's comment carries the measurements that
    bought that. transition-shadow stays: box-shadow paints, it never reflows,
    so it cannot move content under the reader.
    The controller toggles the scrolled classes (the shadow) when the scroll
    passes its hysteresis.
    Preview keeps nav-shell (the calc()s have to resolve) but no controller — the
    /navbar review page drives --nav-p from its own Scrolled toggle, and its
    :class reads that toggle's `scrolled`. %>
<%# data-pin names this header as a layer of the pinned stack, so
    layouts/studio/_head publishes --pin-nav-h and --pin-nav-bottom for it and
    anything below can position off it in pure CSS. The legacy --nav-h /
    --nav-bottom keep publishing unchanged; this is additive. %>
<%# The bare x-data is the Alpine scope the header's descendants still bind
    through ($store.devMode on the user nav, the sidebar trigger's @click):
    Alpine initializes directives only inside a component, and the header was
    that component while navCollapse() lived on it. %>
<%# data-nav-timeline opts into the scroll-driven collapse (Studio.navbar_scroll_timeline,
    or a scroll_timeline: local for one render; engine.css, THE SCROLL-DRIVEN
    COLLAPSE). Never on a preview: the /navbar page drives --nav-p itself. %>
<% scroll_timeline = local_assigns.fetch(:scroll_timeline, Studio.navbar_scroll_timeline) %>
<%# Studio.navbar_root_hook puts data-navbar-root on the header, live and
    preview; Studio.navbar_z_tier layers the live header at --z-nav on the
    shared scale (engine.css) instead of z-50. Both off renders as before. %>
<header <%= "data-navbar-root ".html_safe if Studio.navbar_root_hook %>data-pin="nav"<% unless is_preview %> x-data data-studio-controller="nav-collapse" data-nav-collapse-scrolled-class="shadow-lg border-b border-subtle is-scrolled"<%= " data-nav-timeline" if scroll_timeline %><% end %>
        <%# top-0, a STATIC value, and never a custom property. Any bars render as
            this header's sibling in normal flow (studio/banners/_stack), so they
            already occupy their own height above it and there is nothing to
            offset by. An offset read from a runtime-published property is what
            made this header jump: it painted at a server estimate, moved when the
            measurement landed, moved again on a webfont swap, and drew twice
            during a view transition composited at two different tops. Only CSS
            can set this top now, so none of that is reachable. %>
        class="nav-shell <%= is_preview ? 'bg-page' : "#{'vt-pinned-header ' if pin_header}sticky top-0 #{Studio.navbar_z_tier ? 'z-[var(--z-nav)]' : 'z-50'} bg-page transition-shadow duration-300" %>"
        <%= %(:class="scrolled && 'shadow-lg border-b border-subtle is-scrolled'").html_safe if is_preview %>>
  <style>
    /* THE PHONE STEP IS A SHARE OF THE VIEWPORT, NOT A CONSTANT, and that is the
       whole width fix. 14rem is 224px — 57% of a 390px screen — handed to a
       flex-shrink-0 column, so the left column was left 166px for a 48px logo,
       a 4px gap, 32px of padding and whatever the app is called. MEASURED on
       /lab/bar_stack?signed_in=1 at 390x844, app_name "McRitchie Industries":
       the title's own box ran to x=175.3 inside a column whose border box ends
       at x=166, and "Industries" painted ON TOP of the wallet address in the
       column beside it. documentElement.scrollWidth was 390 against a
       clientWidth of 390 the entire time — the page did not scroll sideways,
       so every document-level check of this header was green while the header
       was visibly broken.

       min() rather than a new breakpoint: the cap still resolves to 14rem on
       anything at or above ~487px, so this band's desktop-side behaviour is
       byte-identical and only the phone widths move. 46vw is not a taste
       value — it is the largest share that still leaves the left column the
       191px a 48px logo, its gap, its padding and a ten-character word need at
       360px, the narrowest mainstream Android. Below that the title truncates
       (see min-w-0 + truncate on the markup) instead of spilling.

       BOTH LINES, and that is not redundancy. .user-nav-col is a hard width
       (a host passing balance_html reserves the seat) and .user-nav-fit is a
       cap (no balance, so the column hugs its content). They are two different
       properties and a fix to one leaves the other exactly as broken. */
    .user-nav-col { width: min(14rem, 46vw); }
    /* No balance content → no reserved column. The nav hugs its icons and
       name instead of floating in the balance's empty seat. max-width steps
       mirror the col's clamps: the item is flex-shrink-0, so without them a
       long nowrap username sizes the column past a narrow viewport. */
    .user-nav-fit { max-width: min(14rem, 46vw); }
    /* THE SAME SHARE IN THE NEXT BAND UP, and leaving it out was measurably
       worse than not fixing the first one. With only the base band capped, a
       412px screen (Pixel-class, and the 400px band's own territory) gave the
       title 84px while a 390px screen gave it 107 — a WIDER phone showing LESS
       of the app's name. Monotone or it is not fixed. min(15rem, 46vw) resolves
       to the plain 15rem at ~522px and up, so everything above this band's
       phone edge is unchanged. */
    @media (min-width: 400px) { .user-nav-col { width: min(15rem, 46vw); } .user-nav-fit { max-width: min(15rem, 46vw); } }
    @media (min-width: 768px) { .user-nav-col { width: 20rem; } .user-nav-fit { max-width: 20rem; } }
    /* The COLLAPSE band table used to live here, which meant only an app
       rendering THIS partial got it. Three of five apps fork the navbar, so each
       was left to hand-write its own — the way four independent copies happened
       in the first place. It ships from engine.css now (every consuming app
       imports it), so a forking app OPTS IN with `nav-shell` +
       data-studio-controller="nav-collapse" (or x-data="navCollapse()",
       the Alpine shim) and overrides only the endpoints that differ.

       THE OPT-IN IS NOT THE WHOLE JOB — this is the partial a forker actually
       reads, so the caveat belongs here too rather than only beside the band
       table. A hand-written header must also REMOVE the bindings that fight the
       primitive (a :class size swap on the row, x-bind:class on the logo AND on
       the title, transition-all alongside) and ADD the hooks the table keys on
       (nav-row, nav-logo, nav-title, and the mobile-only nav-logo-link). The
       title swap matters most: it is DISCRETE, which is the 1px reverse lurch
       the primitive exists to delete. Full accounting in engine.css. */
  </style>
  <%# Studio.navbar_header_bars: bars INSIDE the pinned header, above its row,
      so they never scroll away: a control an admin must not lose (an
      impersonation bar's JS-free "Return to <admin>" button). An ambient
      label belongs in the bar stack above the header, which scrolls. Being in
      the header costs one thing, stated: the header is a stacking context, so
      these never rise over an open modal. On the scroll timeline engine.css
      (THE IN-HEADER BARS) carries them down by the band so they hold at the
      window's top. Never on a preview, and [] (the default) renders nothing. %>
  <% header_bars = !is_preview && respond_to?(:studio_navbar_header_bars) ? studio_navbar_header_bars : [] %>
  <% if header_bars.any? %>
  <div data-nav-header-bars><% header_bars.each do |bar| %><%= studio_navbar_slot_tag(bar) %><% end %></div>
  <% end %>
  <div class="nav-row flex items-center">
    <%# Left side: logo + nav %>
    <%# min-w-0 THREE TIMES, on every flex item between the row and the title.
        A flex item's default min-width is auto, which floors it at its own
        min-content — so ONE of these left out puts the floor back and the
        title spills across the gap again. The chain is: row item (.flex-1) ->
        its inner flex -> the logo link. The <h1> is the fourth link and carries
        its own min-w-0 below. %>
    <div class="flex-1 min-w-0 px-4">
      <div class="flex items-center gap-6 min-w-0">
        <%= link_to root_path, class: "nav-logo-link inline-flex items-center gap-3 group min-w-0" do %>
          <% if wordmark %>
          <%# Studio.navbar_wordmark: the brand lockup (icon + words as one
              artwork) replaces the logo AND the title text. Both theme files
              render; engine.css (.nav-wordmark-light / -dark) shows the one
              matching the root's `dark` class, so a toggle needs no script.
              The brand_tag still wraps it, so the page keeps its h1 and the
              h1's accessible name is the alt text. Height follows
              --nav-logo-size; width is the artwork's own, shrinking with the
              column (the min-w-0 chain above; the brand box's own min-width 0
              is in engine.css) rather than spilling. %>
          <<%= brand_tag %> class="nav-wordmark-brand">
            <img src="<%= wordmark[:light] %>" alt="<%= Studio.app_name %>" class="nav-wordmark nav-wordmark-light">
            <img src="<%= wordmark[:dark] %>" alt="<%= Studio.app_name %>" class="nav-wordmark nav-wordmark-dark">
          </<%= brand_tag %>>
          <% else %>
          <% if logo_path %>
            <%# No w-*/h-* utility here: .nav-shell .nav-logo sizes it off --nav-p.
                transition-transform, NOT transition-all — the hover lift still
                eases, while width/height follow the finger with no clock. %>
            <img src="<%= logo_path %>" alt="<%= logo_alt %>"<% if logo_size %> width="<%= logo_size %>" height="<%= logo_size %>"<% end %> class="nav-logo rounded-full shadow-lg <%= "group-hover:scale-105 transition-transform duration-300" unless is_preview %>">
          <% end %>
          <%# truncate on the SPANS, not the h1. .nav-title is itself a flex
              container (a column below 768px, a baseline row above), so the
              overflow that has to be clipped belongs to each word's own box —
              `truncate` on the h1 would clip the flex CONTAINER and leave the
              spans drawing outside it, which is the bug rather than the fix. %>
          <% if brand_words %>
          <<%= brand_tag %> class="nav-title font-extrabold text-heading tracking-tight min-w-0"><% brand_words.each do |word| %><span class="<%= [word[:class], "truncate"].compact.join(" ") %>"><%= word[:text] %></span><% end %></<%= brand_tag %>>
          <% else %>
          <<%= brand_tag %> class="nav-title font-extrabold text-heading tracking-tight min-w-0"><span class="truncate"><%= prefix %></span><span class="text-primary truncate"><%= last_word %></span></<%= brand_tag %>>
          <% end %>
          <% end %>
        <% end %>
        <%# Desktop nav — Studio.navbar_links, then Studio.navbar_items. data-nav-links, only where the
            header is on the scroll timeline (so an opted-out header stays
            byte-identical): it slides left by what the scaled brand gives up
            (engine.css, THE SCROLL-DRIVEN COLLAPSE). %>
        <nav <%= "data-nav-links " if scroll_timeline && !is_preview %>class="hidden md:flex items-center gap-4"<%= ' aria-label="Main"'.html_safe if navbar_links.any? %>>
          <% navbar_links.each do |link| %>
          <%= studio_navbar_link_tag(link, size: "text-sm") %>
          <% end %>
          <% navbar_items.each do |item| %>
          <%= studio_navbar_slot_tag(item) %>
          <% end %>
        </nav>
      </div>
    </div>
    <%# Right side: user nav. The fixed column (matches sidebar width) exists
        to seat a balance in the top row; with no balance content it shrinks
        to fit. %>
    <div class="<%= balance_html.present? || user_nav_slots[:balance_slot].present? ? 'user-nav-col' : 'user-nav-fit' %> flex-shrink-0 pl-0 pr-4 md:px-4">
      <% if show_user %>
        <%= render "components/user_nav", balance_html: balance_html, extra_icons_html: extra_icons_html, **user_nav_slots %>
      <% else %>
        <div class="flex items-center justify-end gap-3">
          <%= sidebar_trigger_desktop if sidebar_active %>
          <span class="hidden md:flex"><%= render "components/theme_toggle_morph" %></span>
          <% if signed_out_cta %>
          <%# sign_in_link: false drops the quiet link (the CTA is the sign-in);
              sign_in_path points it elsewhere; modal: opens a modal from the
              button, its path the fallback (lib/studio/navbar_signed_out_cta.rb). %>
          <% unless signed_out_cta[:sign_in_link] == false %>
          <%= link_to Studio.sign_in_label, signed_out_cta[:sign_in_path] || login_path, class: "hidden md:inline text-sm font-semibold text-secondary hover:text-primary whitespace-nowrap transition", data: { nav_sign_in: "" } %>
          <% end %>
          <%= link_to signed_out_cta[:label], signed_out_cta[:path], class: "btn btn-primary whitespace-nowrap", data: { nav_signed_out_cta: "" }, **studio_navbar_cta_modal_options(signed_out_cta) %>
          <% else %>
          <%= link_to Studio.sign_in_label, login_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <%# Mobile sub-navbar: compact row hidden on desktop — Studio.navbar_links, then Studio.navbar_items, on the left %>
  <div class="flex md:hidden items-center gap-3 px-4 py-1.5 border-t border-subtle bg-surface-alt">
    <% if navbar_links.any? %>
    <nav aria-label="Main" class="flex items-center gap-3 overflow-x-auto">
      <% navbar_links.each do |link| %>
      <%= studio_navbar_link_tag(link, size: "text-xs") %>
      <% end %>
    </nav>
    <% end %>
    <% navbar_items.each do |item| %>
    <%= studio_navbar_slot_tag(item) %>
    <% end %>
    <span class="ml-auto flex items-center gap-3">
      <% if signed_out_cta && signed_out_cta[:sign_in_link] != false %>
      <%= link_to Studio.sign_in_label, signed_out_cta[:sign_in_path] || login_path, class: "text-xs font-semibold text-secondary hover:text-primary whitespace-nowrap transition", data: { nav_sign_in: "" } %>
      <% end %>
      <%= render "components/link_sidebar_trigger" if sidebar_active %>
      <%# Studio.navbar_menu_trigger takes the admin dropdown's seat here too. %>
      <% menu_trigger = respond_to?(:studio_navbar_menu_trigger) ? studio_navbar_menu_trigger : nil %>
      <% if menu_trigger %>
      <%= studio_navbar_slot_tag(menu_trigger) %>
      <% else %>
      <%= render "components/admin_dropdown" unless sidebar_active && studio_sidebar_replaces_admin_menu? %>
      <% end %>
      <%= render "components/theme_toggle_morph" %>
    </span>
  </div>
</header>
<%# The panels mount OUTSIDE the header: the sticky header's backdrop-filter
    creates a containing block, which would pin a fixed panel to the header
    instead of the viewport. %>
<%= render "components/link_sidebar" if sidebar_active %>
