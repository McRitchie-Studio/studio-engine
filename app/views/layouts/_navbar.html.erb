<%# Base navbar partial — apps can override by creating their own app/views/layouts/_navbar.html.erb
    Locals (all optional):
      show_logged_in  — override for logged_in? (default: real session)
      preview         — if true, disables scroll handler and sticky positioning
      balance_html    — raw HTML for balance display (passed through to _user_nav)
      extra_icons_html — raw HTML for extra icon buttons (passed through to _user_nav)
      show_logout_link — boolean, show "Log out" link in user nav (passed through to _user_nav)
%>
<% show_user = local_assigns.fetch(:show_logged_in, logged_in?) %>
<% is_preview = local_assigns.fetch(:preview, false) %>
<%# Smooth-load self-pin (engine 0.26): when the app opts into Studio.smooth_load,
    the sticky header names itself as the shared view-transition group
    (vt-pinned-header) so page content transitions beneath a navbar that stays
    put — hosts no longer shadow this partial just to add the class. Non-preview
    branch ONLY: preview renders can repeat per page, and a duplicate
    view-transition-name silently disables every transition. With the flag off,
    nothing extra renders. %>
<% pin_header = Studio.smooth_load && !is_preview %>
<% balance_html = local_assigns.fetch(:balance_html, nil) %>
<% extra_icons_html = local_assigns.fetch(:extra_icons_html, nil) %>
<% show_logout_link = local_assigns.fetch(:show_logout_link, false) %>
<%# Out-of-the-box navigation (engine 0.30): when the host declares
    Studio.sidebar_sections, the navbar mounts the link-sidebar trigger in its
    icon rails and renders the slide-out panels after the header. With no
    sections (the default) all of this is skipped — the navbar is unchanged.
    Preview renders skip it too: the /admin/navbar page renders this partial
    repeatedly and the panels carry page-unique ids. %>
<% sidebar_active = !is_preview && respond_to?(:studio_sidebar?) && studio_sidebar? %>
<% if sidebar_active %>
  <% sidebar_trigger_desktop = capture { render "components/link_sidebar_trigger", class_name: "hidden md:inline-flex" } %>
  <% extra_icons_html = safe_join([extra_icons_html, sidebar_trigger_desktop].compact) %>
<% end %>
<%
  words = Studio.app_name.split
  last_word = words.pop
  prefix = words.join(" ")
  logo_path = Studio.logo_for("Navbar Logo")
%>

<%# nav-shell is the --nav-p scope: navCollapse() (layouts/studio/_head) writes
    the collapse progress, 0 expanded .. 1 collapsed, on THIS element once per
    animation frame, and the band table below derives the row padding, logo size
    and title sizes from it with calc(). Nothing on the collapse path carries a
    time-based transition — the head's comment carries the measurements that
    bought that. transition-shadow stays: box-shadow paints, it never reflows,
    so it cannot move content under the reader.
    Preview keeps nav-shell (the calc()s have to resolve) but no x-data — the
    /navbar review page drives --nav-p from its own Scrolled toggle. %>
<%# data-pin names this header as a layer of the pinned stack, so
    layouts/studio/_head publishes --pin-nav-h and --pin-nav-bottom for it and
    anything below can position off it in pure CSS. The legacy --nav-h /
    --nav-bottom keep publishing unchanged; this is additive. %>
<header data-pin="nav" <%= 'x-data="navCollapse()"'.html_safe unless is_preview %>
        <%# top-0, a STATIC value, and never a custom property. Any bars render as
            this header's sibling in normal flow (studio/banners/_stack), so they
            already occupy their own height above it and there is nothing to
            offset by. An offset read from a runtime-published property is what
            made this header jump: it painted at a server estimate, moved when the
            measurement landed, moved again on a webfont swap, and drew twice
            during a view transition composited at two different tops. Only CSS
            can set this top now, so none of that is reachable. %>
        class="nav-shell <%= is_preview ? 'bg-page' : "#{'vt-pinned-header ' if pin_header}sticky top-0 z-50 bg-page transition-shadow duration-300" %>"
        :class="scrolled && 'shadow-lg border-b border-subtle is-scrolled'">
  <style>
    .user-nav-col { width: 14rem; }
    /* No balance content → no reserved column. The nav hugs its icons and
       name instead of floating in the balance's empty seat. max-width steps
       mirror the col's clamps: the item is flex-shrink-0, so without them a
       long nowrap username sizes the column past a narrow viewport. */
    .user-nav-fit { max-width: 14rem; }
    @media (min-width: 400px) { .user-nav-col { width: 15rem; } .user-nav-fit { max-width: 15rem; } }
    @media (min-width: 768px) { .user-nav-col { width: 20rem; } .user-nav-fit { max-width: 20rem; } }
    /* The COLLAPSE band table used to live here, which meant only an app
       rendering THIS partial got it. Three of six apps fork the navbar, so each
       was left to hand-write its own — the way four independent copies happened
       in the first place. It ships from engine.css now (every consuming app
       imports it), so a forking app OPTS IN with `nav-shell` +
       x-data="navCollapse()" and overrides only the endpoints that differ.

       THE OPT-IN IS NOT THE WHOLE JOB — this is the partial a forker actually
       reads, so the caveat belongs here too rather than only beside the band
       table. A hand-written header must also REMOVE the bindings that fight the
       primitive (a :class size swap on the row, x-bind:class on the logo AND on
       the title, transition-all alongside) and ADD the hooks the table keys on
       (nav-row, nav-logo, nav-title, and the mobile-only nav-logo-link). The
       title swap matters most: it is DISCRETE, which is the 1px reverse lurch
       the primitive exists to delete. Full accounting in engine.css. */
  </style>
  <div class="nav-row flex items-center">
    <%# Left side: logo + nav %>
    <div class="flex-1 px-4">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "nav-logo-link inline-flex items-center gap-3 group" do %>
          <% if logo_path %>
            <%# No w-*/h-* utility here: .nav-shell .nav-logo sizes it off --nav-p.
                transition-transform, NOT transition-all — the hover lift still
                eases, while width/height follow the finger with no clock. %>
            <img src="<%= logo_path %>" alt="<%= Studio.app_name %>" class="nav-logo rounded-full shadow-lg <%= "group-hover:scale-105 transition-transform duration-300" unless is_preview %>">
          <% end %>
          <h1 class="nav-title font-extrabold text-heading tracking-tight"><span><%= prefix %></span><span class="text-primary"><%= last_word %></span></h1>
        <% end %>
        <%# Desktop nav — apps should override this partial to add links here %>
        <nav class="hidden md:flex items-center gap-4">
        </nav>
      </div>
    </div>
    <%# Right side: user nav. The fixed column (matches sidebar width) exists
        to seat a balance in the top row; with no balance content it shrinks
        to fit. %>
    <div class="<%= balance_html.present? ? 'user-nav-col' : 'user-nav-fit' %> flex-shrink-0 pl-0 pr-4 md:px-4">
      <% if show_user %>
        <%= render "components/user_nav", balance_html: balance_html, extra_icons_html: extra_icons_html, show_logout_link: show_logout_link %>
      <% else %>
        <div class="flex items-center justify-end gap-3">
          <%= sidebar_trigger_desktop if sidebar_active %>
          <span class="hidden md:flex"><%= render "components/theme_toggle_morph" %></span>
          <%= link_to "Log in", login_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
  <%# Mobile sub-navbar: compact row hidden on desktop — apps should override to add links %>
  <div class="flex md:hidden items-center gap-3 px-4 py-1.5 border-t border-subtle bg-surface-alt">
    <span class="ml-auto flex items-center gap-3">
      <%= render "components/link_sidebar_trigger" if sidebar_active %>
      <%= render "components/admin_dropdown" unless sidebar_active && studio_sidebar_replaces_admin_menu? %>
      <%= render "components/theme_toggle_morph" %>
    </span>
  </div>
</header>
<%# The panels mount OUTSIDE the header: the sticky header's backdrop-filter
    creates a containing block, which would pin a fixed panel to the header
    instead of the viewport. %>
<%= render "components/link_sidebar" if sidebar_active %>
