<%# Toast notification system — floating toasts that overlay the page %>
<%#   window.dispatchEvent(new CustomEvent('toast', { detail: { %>
<%#     type: 'notice',           -- 'notice' or 'alert' %>
<%#     title: 'Header',          -- bold title (auto: "Success"/"Error" if omitted) %>
<%#     message: 'Subtext',       -- description text %>
<%#     image: '/avatar.jpg',     -- optional image URL (shows icon if omitted) %>
<%#     dismissible: true,        -- show X button (default: true) %>
<%#     buttons: [{ label, style, onclick }], -- optional action buttons %>
<%#     duration: 4000            -- auto-dismiss ms (default: 4000, 0 = stay, auto 0 when buttons) %>
<%#     blurShadow: false         -- frosted glass halo behind the toast %>
<%#   } })) %>

<style>
  /* Z-indexes are CSS-var-driven so consumer apps can override without
     !important. The per-app names stay — they are the published seam — but the
     DEFAULT now comes from the shared layer scale in engine.css rather than a
     bare 60/55 that sat below every app navbar. A toast is the one thing that
     must surface over an open modal, so --z-toast is above --z-modal and an app
     that never overrides gets that for free. Apps that DO override should set
     the tier (--z-toast) instead, and drop the per-component name.

     ABOVE THE BANNER TOO, and the fallbacks below have to say so. A toast and
     the environment bars share the top of the viewport, and with a modal open
     engine.css lifts those bars to --z-banner at top 0 — which used to sit at
     500, over the toast's 400, so the toast's Dismiss button was covered and a
     click landed on the banner. A toast carrying buttons is given duration 0 by
     the manager below, so that button is its only exit: covered, the toast was
     stuck forever. The tiers were reordered (engine.css carries the argument);
     these literals are what an app gets when the engine sheet is absent, so
     they must carry the SAME order or that app keeps the bug. */
  #toast-container { z-index: var(--studio-toast-z, var(--z-toast, 500)); }
  .toast-shadow-all {
    box-shadow: 0 0 30px rgba(0,0,0,0.4), 0 0 10px rgba(0,0,0,0.2);
  }
  .toast-shadow-top {
    box-shadow: 0 -8px 30px rgba(0,0,0,0.4), -8px 0 30px rgba(0,0,0,0.4), 8px 0 30px rgba(0,0,0,0.4);
  }
  .toast-shadow-bottom {
    box-shadow: 0 8px 30px rgba(0,0,0,0.4), -8px 0 30px rgba(0,0,0,0.4), 8px 0 30px rgba(0,0,0,0.4);
  }
  .toast-card {
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .dark .toast-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .toast-blur-glow {
    position: absolute;
    inset: -3rem -4rem;
    border-radius: 2rem;
    filter: blur(30px);
    pointer-events: none;
  }
  .toast-blur-glow {
    background: rgba(0, 0, 0, 0.06);
  }
  /* Slash form only: the theme's -rgb vars are space lists, so the legacy
     comma form is invalid and painted no halo (legacy_rgba_var_guard_test.rb). */
  .dark .toast-blur-glow {
    background: rgb(var(--color-primary-500-rgb) / 0.12);
  }
  .toast-wrapper {
    position: relative;
    transition: transform 0.5s ease,
                opacity 0.4s ease,
                margin-top 0.4s ease,
                max-height 0.4s ease;
  }
  .toast-page-blur {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: radial-gradient(ellipse 70% 80% at 50% 0%, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 0%, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0) 100%);
    pointer-events: none;
    z-index: var(--studio-toast-blur-z, var(--z-toast-blur, 499));
    transition: opacity 0.5s ease;
    background: rgba(255, 255, 255, 0.15);
  }
  .dark .toast-page-blur {
    background: rgba(255, 255, 255, 0.5);
  }
</style>

<% messages = flash.select { |type, _| %w[notice alert].include?(type) } %>
<% initial_json = messages.map { |type, msg| { type: type, message: msg } }.to_json %>

<%# The queue is studio/toast ($store.toasts): it listens for the `toast` window
    event and seeds the flash below. The bare x-data is the Alpine scope the
    bindings need; the toast controller binds the queue to this root's lifetime. %>
<div x-data
     data-studio-controller="toast"
     data-toast-initial-value="<%= initial_json %>">

  <%# ── Page blur — half-ellipse backdrop blur behind toasts ── %>
  <div class="toast-page-blur"
       :style="'opacity: ' + ($store.toasts.hasVisible() ? '1' : '0')"></div>

  <div id="toast-container"
       class="fixed top-0 left-1/2 flex flex-col items-center pointer-events-none"
       style="transform: translateX(-50%); padding: 1rem; width: 100%; max-width: 30rem;">

  <template x-for="(toast, index) in $store.toasts.toasts" :key="toast.id">
    <div :style="$store.toasts.toastStyle(index)"
         class="toast-wrapper w-full"
         @click="$store.toasts.handlePeekClick(index)">

      <%# ── Blur glow (optional) — uses filter:blur on a colored div, not backdrop-filter ── %>
      <template x-if="toast.blurShadow">
        <div class="toast-blur-glow"></div>
      </template>

      <%# ── Toast card — z-index above all blur backdrops ── %>
      <div class="relative pointer-events-auto bg-surface rounded-lg p-4 w-full flex gap-3 toast-card"
           :class="$store.toasts.toastShadowClass(index)"
           role="status">

        <%# ── Image or icon ── %>
        <template x-if="toast.image">
          <img :src="toast.image" class="w-10 h-10 rounded-full object-cover shrink-0" style="margin-top: 2px;">
        </template>
        <template x-if="!toast.image">
          <div class="w-10 h-10 rounded-full flex items-center justify-center bg-inset shrink-0" style="margin-top: 2px;">
            <svg x-show="toast.type === 'notice'" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color: var(--color-success-ink)" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
            </svg>
            <svg x-show="toast.type !== 'notice'" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color: var(--color-danger)" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
          </div>
        </template>

        <%# ── Content ── %>
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2">
            <span x-text="toast.title" class="text-heading font-semibold text-sm"></span>
            <template x-if="toast.dismissible">
              <button @click.stop="$store.toasts.dismiss(toast.id)"
                      class="text-muted hover:text-heading shrink-0 cursor-pointer"
                      aria-label="Dismiss">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </template>
          </div>
          <template x-if="toast.message">
            <p x-text="toast.message" class="text-secondary text-sm" style="margin-top: 2px;"></p>
          </template>
          <template x-if="toast.buttons && toast.buttons.length > 0">
            <div class="flex gap-2" style="margin-top: 0.75rem;">
              <template x-for="btn in toast.buttons" :key="btn.label">
                <button @click.stop="if (btn.onclick) btn.onclick(); $store.toasts.dismiss(toast.id)"
                        class="btn btn-sm"
                        :class="btn.style === 'primary' ? 'btn-primary' : btn.style === 'danger' ? 'btn-danger' : 'btn-outline'">
                  <span x-text="btn.label"></span>
                </button>
              </template>
            </div>
          </template>
        </div>
      </div>
    </div>
  </template>
  </div>
</div>

