    so any board consumer has it with zero per-app wiring, mirroring canvas_confetti. %>
<%= javascript_include_tag "studio/sortable", defer: true, "data-turbo-track": "reload" %>
<script>
  window.fireSuccessConfetti = function() {
    if (typeof confetti === 'undefined') return;
    var colors = window.CONFETTI_COLORS || ['#4BAF50', '#8E82FE', '#06D6A0', '#FF7C47', '#FFD700', '#00BFFF', '#FF6B9D', '#C084FC'];
    confetti({ particleCount: 150, spread: 100, origin: { x: 0.5, y: 0.5 }, colors: colors, zIndex: 9999, startVelocity: 45, gravity: 0.8, ticks: 300, scalar: 1.2 });
    setTimeout(function() { confetti({ particleCount: 80, angle: 60, spread: 60, origin: { x: 0, y: 0.6 }, colors: colors, zIndex: 9999, startVelocity: 55, gravity: 1, ticks: 250 }); }, 150);
    setTimeout(function() { confetti({ particleCount: 80, angle: 120, spread: 60, origin: { x: 1, y: 0.6 }, colors: colors, zIndex: 9999, startVelocity: 55, gravity: 1, ticks: 250 }); }, 150);
    setTimeout(function() { confetti({ particleCount: 100, spread: 160, origin: { x: 0.5, y: 0.3 }, colors: colors, zIndex: 9999, startVelocity: 30, gravity: 1.2, ticks: 200, scalar: 0.8 }); }, 400);
  };
</script>
<script>
  // Nav spinner — scale morph between theme toggle and loading spinner
  // Minimum display time prevents quick flashes; per-app via
  // Studio.nav_spinner_min_ms (smooth-load apps drop it to ~300).
  window._navSpinnerShownAt = 0;
  window._navSpinnerMinMs = <%= Studio.nav_spinner_min_ms.to_i %>;
  window.showNavSpinner = function() {
    window._navSpinnerShownAt = Date.now();
    document.querySelectorAll('.nav-toggle-icon').forEach(function(e) { e.style.opacity = '0'; e.style.transform = 'scale(0) rotate(90deg)'; });
    document.querySelectorAll('.nav-spinner-icon').forEach(function(e) { e.style.opacity = '1'; e.style.transform = 'scale(1) rotate(0deg)'; });
  };
  window.hideNavSpinner = function() {
    var elapsed = Date.now() - window._navSpinnerShownAt;
    var remaining = Math.max(0, window._navSpinnerMinMs - elapsed);
    setTimeout(function() {
      document.querySelectorAll('.nav-toggle-icon').forEach(function(e) { e.style.opacity = '1'; e.style.transform = 'scale(1) rotate(0deg)'; });
      document.querySelectorAll('.nav-spinner-icon').forEach(function(e) { e.style.opacity = '0'; e.style.transform = 'scale(0) rotate(-90deg)'; });
    }, remaining);
  };
  // Reset spinner state before Turbo caches the page
  document.addEventListener('turbo:before-cache', function() {
    document.querySelectorAll('.nav-toggle-icon').forEach(function(e) { e.style.opacity = '1'; e.style.transform = 'scale(1) rotate(0deg)'; });
    document.querySelectorAll('.nav-spinner-icon').forEach(function(e) { e.style.opacity = '0'; e.style.transform = 'scale(0) rotate(-90deg)'; });
  });
</script>
<script>
  document.addEventListener('alpine:init', () => {
    Alpine.store('devMode', localStorage.getItem('devMode') === 'true');
    Alpine.store('theme', {
      value: localStorage.getItem('theme') || 'dark',
      get isDark() { return this.value === 'dark'; },
      toggle() {
        document.documentElement.classList.add('theme-transition');
        document.documentElement.classList.toggle('dark');
        this.value = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', this.value);
        setTimeout(() => document.documentElement.classList.remove('theme-transition'), 300);
      }
    });
  });
</script>

<style>
  /* studio-engine: a sticky navbar that shrinks on scroll changes layout
     above the fold — Chrome/Firefox scroll-anchoring then compensates by
     moving scrollY, which re-crosses the collapse threshold and bounces.
     Disabling anchoring document-wide stops scrollY being dragged by the
     navbar resize. */
  body { overflow-anchor: none; }
</style>
<script>
  // studio-engine: publish the sticky header's live geometry as CSS custom
  // properties so fixed/sticky elements can position off it without hardcoded
  // px. Tracks every resize, including scroll-collapse animations, and
  // re-attaches after Turbo nav.
  //
  //   --nav-h      the header's HEIGHT
  //   --nav-bottom the header's BOTTOM EDGE, in viewport coordinates
  //
  // They are equal only when the header sits at the top of the viewport, which
  // is why one was long mistaken for the other. An app that stacks chrome ABOVE
  // the header — an environment banner rendered before the navbar, as
  // mcritchie-industries does — pushes the header down, and a `fixed` overlay
  // positioned at --nav-h then rides UP over the header by exactly the height of
  // that chrome. Use --nav-h to size something as tall as the header; use
  // --nav-bottom to start something underneath it.
  (function () {
    if (!window.ResizeObserver) return;
    var ro = null;
    var queued = false;
    var pins = [];
    // The names this publisher has written, so a DEPARTED layer can be cleared.
    var published = {};

    // ONE MEASUREMENT PER ELEMENT PER FRAME, and every read before every write.
    //
    // publish() and publishPin() each kept reads-before-writes INTERNALLY, and
    // that was not enough: the frame ran publish(current) — which WRITES two
    // inherited custom properties on documentElement — and then the pin loop,
    // whose first act is a getBoundingClientRect(). A read after a write to the
    // root forces a fresh layout, so the thrash this file removed came straight
    // back one function boundary over. Measured by review at 6x CPU throttle
    // over 175 frames, pin loop on vs off: frames past 20ms 62 vs 42, median
    // 17.7 vs 14.9ms, p90 34.2 vs 26.0ms; at 10x, 84/180 vs 4/180.
    //
    // The header was also measured TWICE — once as `current`, once as pin
    // `nav` — for values proven identical across 40 frames. It is a pin like
    // any other now; the only thing special about it is that it ALSO writes the
    // legacy --nav-h / --nav-bottom that studio/_sidebar_panel and
    // turf-monster's scroll-margin-top already read.
    function readPin(pin) {
      return {
        pin: pin,
        h: pin.el.offsetHeight,
        bottom: Math.max(0, pin.el.getBoundingClientRect().bottom)
      };
    }
    function writeReading(r) {
      var style = document.documentElement.style;
      var pin = r.pin;
      if (r.h !== pin.lastH) {
        pin.lastH = r.h;
        style.setProperty('--pin-' + pin.name + '-h', r.h + 'px');
        if (pin.legacy) style.setProperty('--nav-h', r.h + 'px');
      }
      if (r.bottom !== pin.lastBottom) {
        pin.lastBottom = r.bottom;
        style.setProperty('--pin-' + pin.name + '-bottom', r.bottom + 'px');
        if (pin.legacy) style.setProperty('--nav-bottom', r.bottom + 'px');
      }
    }
    function publishAll() {
      var readings = [];
      var i;
      for (i = 0; i < pins.length; i++) readings.push(readPin(pins[i]));
      for (i = 0; i < readings.length; i++) writeReading(readings[i]);
    }
    function schedule() {
      if (queued || !pins.length) return;
      queued = true;
      window.requestAnimationFrame(function () { queued = false; publishAll(); });
    }
    // ONE construction site. Two of them let attach() replace the observer that
    // registerPins() had already put the pins on, silently dropping every live
    // observation — caught by test_pins_share_one_observer_and_one_frame, which
    // counts them for exactly that reason.
    function ensureObserver() {
      if (!ro) ro = new ResizeObserver(schedule);
      return ro;
    }
    function registerPins() {
      ensureObserver();
      pins = [];
      var seen = {};
      var header = document.querySelector('header');
      var nodes = document.querySelectorAll('[data-pin]');
      for (var i = 0; i < nodes.length; i++) {
        var name = nodes[i].getAttribute('data-pin');
        // An unnamed pin would write `--pin--h`, a valid property name and a
        // silent nonsense one. Skip it rather than publish it.
        if (!name) continue;
        seen[name] = true;
        pins.push({
          el: nodes[i],
          name: name,
          // The header keeps publishing --nav-h / --nav-bottom, from the SAME
          // measurement, so it is never measured twice.
          legacy: nodes[i] === header,
          lastH: null,
          lastBottom: null
        });
        ro.observe(nodes[i]);
      }
      // CLEAR WHAT LEFT. A layer goes away three ways: display:none and x-show
      // both keep the node, so it measures 0 and drops out of a consumer's
      // max() on its own. REMOVAL does not — nothing is left to measure, the
      // last published value stands forever, and a consumer sits at the height
      // of a strip that is gone. Review measured a removed 300px strip holding
      // --pin-apps-bottom at 300px against a real stack bottom of 160px: a
      // permanent 140px error, and a direct contradiction of this primitive's
      // headline promise.
      for (var name2 in published) {
        if (published.hasOwnProperty(name2) && !seen[name2]) {
          document.documentElement.style.removeProperty('--pin-' + name2 + '-h');
          document.documentElement.style.removeProperty('--pin-' + name2 + '-bottom');
        }
      }
      published = seen;
      publishAll();
    }
    // ATTACH IS NOW JUST A RE-SCAN. The header used to be tracked separately as
    // `current`, with its own observe and its own publish; it is a pin named
    // "nav" like any other, so registerPins() covers it. What survives is the
    // release promise: a page with no pinned chrome at all disconnects the
    // observer rather than leaving it on detached nodes, and the properties keep
    // their last value rather than being driven to 0 by an all-zero rect.
    //
    // A page that never has a <header> is served too — the observer is built by
    // ensureObserver() from registerPins(), not from a has-header branch. It was
    // only reachable from that branch before, so pins on a headerless layout were
    // permanently dead.
    function attach() {
      if (ro) ro.disconnect();
      registerPins();
      if (!pins.length && ro) { ro.disconnect(); ro = null; }
    }
    document.addEventListener('DOMContentLoaded', attach);
    document.addEventListener('turbo:load', attach);
    // A Turbo Stream replaces nodes WITHOUT a turbo:load, which is how a
    // captured pin goes stale. Re-register on the next frame, once the stream
    // has actually patched the DOM.
    document.addEventListener('turbo:before-stream-render', function () {
      window.requestAnimationFrame(registerPins);
    });
    // Registered ONCE at script eval, not inside attach(), so a Turbo nav
    // re-scans instead of stacking another listener per visit.
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  })();
</script>

<style>
  /* studio-engine: --nav-p, the sticky header's COLLAPSE PROGRESS, 0 (expanded)
     to 1 (collapsed). Third of the header properties published from this file,
     and the only one that is an INPUT to the header rather than a measurement
     of it — --nav-h and --nav-bottom above say how big it is, this says how far
     through its collapse it has got.

     REGISTERED, not merely declared. Untyped, `calc(3rem - 1rem * var(--nav-p))`
     is invalid at computed-value time on a page that has never scrolled and
     every collapsing dimension drops to its unstyled default; the <number> type
     is what makes the arithmetic legal and the initial value real. Registration
     also makes it INTERPOLABLE, which is how /navbar's Scrolled toggle animates
     the whole collapse by transitioning one property. */
  @property --nav-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
</style>
<script>
  // studio-engine: navCollapse — the scroll-linked navbar collapse.
  //
  // Publishes --nav-p on the <header> once per animation frame from
  // window.scrollY. The navbar's own stylesheet derives every collapsing
  // dimension from it with calc(), so the header moves only in a frame the
  // finger moved it, and stops the instant the finger does.
  //
  // It replaces `@scroll.window="scrolled = scrolled ? (scrollY > 5) : (scrollY
  // > 60)"` plus `transition-all duration-300`. That pair let the FINGER set a
  // step and an ease curve own everything after it. Measured in turf-monster at
  // 390x844 before the change: the header ran 178px -> 139px and 34 of those
  // 39px of document reflow landed AFTER the scroll had stopped, over 232ms, at
  // up to 3px per frame of content nobody asked to move -- plus a 1px REVERSE
  // lurch in the frame the class flipped, where a discrete text-3xl -> text-xl
  // swap collided with the stylesheet's own `transition: font-size`.
  //
  // ADOPTING IT: put `nav-shell` and `x-data="navCollapse()"` on the header,
  // give each breakpoint band a `--nav-ramp`, and write the collapsing
  // dimensions as calc()s off --nav-p. This file ships NO sizing opinion, so an
  // app whose navbar collapses to different endpoints than the engine's adopts
  // the mechanism without touching its markup.
  //
  // Four details are load-bearing:
  //
  //   passive + rAF — the listener never blocks the compositor and coalesces a
  //   burst of scroll events (iOS momentum fires far above 60Hz) into one write
  //   per frame. The write lands on the HEADER, not :root: an inherited custom
  //   property written on :root dirties style for the whole document every
  //   frame, and it would leak the live page's scroll progress into the preview
  //   headers on /navbar.
  //
  //   the smoothstep — collapsing a sticky, IN-FLOW header pulls the page up,
  //   so during the collapse content moves by the scroll AND by the shrink:
  //   faster than the finger, always. That is inherent; reclaiming the vertical
  //   space is the point. What is tunable is the shape of the burst. --nav-ramp
  //   is sized at 3x the band's collapse total and the ramp is smoothstepped,
  //   whose slope is zero at both ends, so content speed LEAVES 1x, peaks near
  //   1.5x mid-ramp, and returns to 1x with no velocity step. A linear ramp
  //   equal to the collapse hits 2x and steps straight back to 1x.
  //
  //   the short-page guard — collapsing shortens the document by the collapse
  //   total. On a page with barely more than that to scroll, the collapse
  //   deletes the very scroll room that triggered it, the browser clamps
  //   scrollY to 0, and the navbar flaps open and shut forever. roomExpanded
  //   adds back the shrink ALREADY applied, so the measurement cannot chase
  //   itself as it collapses.
  //
  //   reduced motion — scroll-linked motion has no clock left to slow down, but
  //   resizing type under a moving finger is itself the motion some readers are
  //   asking us to drop. Under the query --nav-p snaps 0/1 on the old
  //   60/5 hysteresis instead of interpolating.
  window.navCollapse = function () {
    return {
      scrolled: false,
      p: 0,
      _ramp: 144,
      _maxPx: 5,
      _reduce: null,
      _onScroll: null,
      _onResize: null,
      _onReduce: null,
      init: function () {
        var self = this;
        var el = this.$el;
        var queued = false;

        this._reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        function readRamp() {
          var style = getComputedStyle(el);
          var raw = parseFloat(style.getPropertyValue('--nav-ramp'));
          self._ramp = raw > 0 ? raw : 144;
          var step = parseFloat(style.getPropertyValue('--nav-max-step'));
          self._maxPx = step > 0 ? step : 5;
        }

        function apply() {
          queued = false;
          var ramp = self._ramp;
          // Clamped: rubber-band overscroll reports a NEGATIVE scrollY, and a
          // negative progress inflates the navbar past its expanded size.
          var y = Math.max(0, window.scrollY);

          // The height the document WOULD have with the navbar expanded. The
          // add-back is the whole trick — see the guard note above.
          var roomExpanded = document.documentElement.scrollHeight
                             - window.innerHeight
                             + ramp * self.p;

          // WHERE THE COLLAPSE WANTS TO BE, from scroll position alone.
          var target;
          var snap = false;
          if (roomExpanded < ramp + 24) {
            target = 0;
            snap = true;
          } else if (self._reduce.matches) {
            target = (self.p > 0 ? y > 5 : y > 60) ? 1 : 0;
            snap = true;
          } else {
            var t = Math.min(1, y / ramp);
            target = t * t * (3 - 2 * t);
          }

          // THE RATE LIMIT — how far the collapse may travel in ONE frame.
          //
          // Position-linked progress fixed motion that OUTLIVED the gesture. It
          // also guaranteed the opposite defect: if scrollY moves 90px between
          // two frames, so does the header's whole range. Measured in
          // turf-monster at 390x844, worst single-frame header height change by
          // scroll profile —
          //
          //     8px/frame (slow, deliberate)   3.9px
          //    24px/frame (normal swipe)      14.1px
          //    momentum flick                 39.0px   <- the ENTIRE collapse
          //    hard flick                     39.0px
          //
          // 39px is the full 178 -> 139. It was found on a phone: slow
          // scrolling looked right, a flick jumped. The measurements behind the
          // original primitive all walked a constant 8px/frame, which is
          // exactly the case that already worked.
          //
          // So the TARGET stays position-linked and the STEP is clamped. What
          // makes this safe is that a slow scroll never REACHES the clamp —
          // under --nav-max-step of header travel per frame the branch below
          // returns `target` untouched, so the slow feel is not approximated,
          // it is the same arithmetic.
          //
          // maxStep is derived, not tuned per band: engine.css sizes --nav-ramp
          // at 3x the band's collapse total, so a cap of MAX px/frame is
          // 3*MAX/ramp in --nav-p units. Mobile (ramp 120) gives 4.9px/frame,
          // desktop (ramp 144) 5.0px. Retune --nav-ramp without keeping that 3x
          // relation and this cap silently drifts with it.
          var p;
          if (snap) {
            // A guard refusal and a reduced-motion state are DECISIONS, not
            // motion; ramping them would animate the very thing each exists to
            // avoid.
            p = target;
          } else {
            var maxStep = (3 * self._maxPx) / ramp;
            var delta = target - self.p;
            p = Math.abs(delta) <= maxStep
              ? target
              : self.p + (delta > 0 ? maxStep : -maxStep);
          }

          if (p !== self.p) {
            self.p = p;
            el.style.setProperty('--nav-p', p.toFixed(4));
          }

          // KEEP FRAMES COMING WHILE CATCHING UP. Nothing else will schedule
          // one: the finger is off, so no more scroll events arrive, and
          // without this the collapse freezes wherever the clamp left it. It
          // converges LINEARLY and lands exactly — about 4 frames (~67ms) from
          // a hard flick — rather than crawling asymptotically the way the
          // 300ms ease this replaced did.
          if (!snap && p !== target) {
            queued = true;
            requestAnimationFrame(apply);
          }

          // The shadow is the one thing still on a clock, and it may stay
          // there: box-shadow paints, it never reflows, so it cannot move
          // content. Hysteresis keeps it from strobing at the boundary.
          var lit = self.scrolled ? y > 5 : y > 60;
          if (lit !== self.scrolled) self.scrolled = lit;
        }

        this._onScroll = function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(apply);
        };
        this._onResize = function () { readRamp(); self._onScroll(); };
        this._onReduce = apply;

        readRamp();
        apply();

        window.addEventListener('scroll', this._onScroll, { passive: true });
        window.addEventListener('resize', this._onResize, { passive: true });
        if (this._reduce.addEventListener) this._reduce.addEventListener('change', this._onReduce);
      },
      destroy: function () {
        // A Turbo visit tears the header down and builds a new one; without
        // this every visit would stack another listener on window.
        if (this._onScroll) window.removeEventListener('scroll', this._onScroll);
        if (this._onResize) window.removeEventListener('resize', this._onResize);
        if (this._reduce && this._reduce.removeEventListener && this._onReduce) {
          this._reduce.removeEventListener('change', this._onReduce);
        }
      }
    };
  };
</script>

