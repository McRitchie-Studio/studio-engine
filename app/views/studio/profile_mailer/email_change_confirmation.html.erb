<%# Body only — branded_mailer supplies the banner + card.

    Copy and button come from the CATALOGUE so an operator can edit them on
    /admin/emails, with the same mailer-wins-when-present fallback the magic-link
    view uses. A host that renders this view without setting the ivars still gets
    the registry defaults rather than an empty email.
%>
<%
  body      = @body.presence      || Studio::EmailCatalog.body(:email_change_confirmation)
  cta_text  = @cta_text.presence  || (Studio::EmailCatalog.cta_enabled?(:email_change_confirmation) ? Studio::EmailCatalog.cta_text(:email_change_confirmation) : nil)
  cta_color = @cta_color.presence || Studio::EmailCatalog.cta_color(:email_change_confirmation)
%>
<h1 style="margin:0 0 18px;font-size:22px;line-height:1.3;color:#1f2a1c;">Confirm your new email</h1>

<% if body.present? %>
  <%= simple_format body, { style: "margin:0 0 24px;font-size:16px;line-height:1.6;color:#3f4a3c;" }, sanitize: true %>
<% end %>

<%# THE TWO ADDRESSES, SPELLED OUT. This email is the only place the person can
    see what they are approving before it happens — and the whole reason it is
    sent to the CURRENT address is so the holder of that inbox decides. Hiding
    the destination behind a button would defeat that. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px;">
  <tr>
    <td style="padding:14px 16px;background:#f4f6f3;border-radius:10px;font-size:15px;line-height:1.6;color:#3f4a3c;">
      <strong style="color:#2f3a2c;">From:</strong> <%= @current_email %><br>
      <strong style="color:#2f3a2c;">To:</strong> <%= @new_email %>
    </td>
  </tr>
</table>

<% if cta_text.present? %>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
    <tr><td align="center" bgcolor="<%= cta_color %>" style="border-radius:10px;">
      <a href="<%= @confirm_url %>" style="display:inline-block;padding:16px 40px;font-size:17px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><%= cta_text %></a>
    </td></tr>
  </table>
<% end %>

<p style="margin:28px 0 0;font-size:13px;line-height:1.5;color:#6b756a;text-align:center;">
  This link expires in <%= (Studio::EmailChangeToken::TTL / 60) %> minutes and can only be used once.
  Until you confirm, your address stays <strong style="color:#2f3a2c;"><%= @current_email %></strong>.
</p>

<p style="margin:24px 0 0;font-size:12px;line-height:1.4;color:#8a948a;text-align:center;">
  Button not working? Copy and paste this link:<br>
  <a href="<%= @confirm_url %>" style="font-size:11px;line-height:1.5;color:<%= cta_color %>;word-break:break-all;"><%= @confirm_url %></a>
</p>
