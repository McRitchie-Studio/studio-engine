<%
  tone = local_assigns.fetch(:tone, :environment).to_sym
  density = local_assigns.fetch(:density, :normal).to_sym
  message = local_assigns.fetch(:message)
  actions = local_assigns[:actions]

  # Branded off the app's OWN theme tokens rather than hardcoded hexes, so a host
  # that retunes --color-warning / --color-danger gets a banner that matches it.
  # The gradient is a translucent black wash over the token — deliberately not
  # color-mix(), which would need a modern-browser floor for pure decoration, and
  # deliberately not two hardcoded stops, which cannot follow a themed colour.
  tones = {
    environment: {
      background: "linear-gradient(90deg, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0.04) 100%), " \
                  "var(--color-warning, #FF7C47)",
      color: "#ffffff",
      shadow: "0 2px 8px rgba(0,0,0,0.25)"
    },
    impersonation: {
      background: "linear-gradient(90deg, rgba(0,0,0,0.30) 0%, rgba(0,0,0,0.06) 100%), " \
                  "var(--color-danger, #EF4444)",
      color: "#ffffff",
      shadow: "0 2px 8px rgba(0,0,0,0.25)"
    }
  }

  # INTRINSIC height — content decides, and the LAYOUT absorbs the result: the
  # stack sits in normal flow, so a bar simply occupies the height it needs and
  # nothing has to measure it. (It once did measure, publishing --studio-bars-h;
  # that jumped, and 0.39.0 removed it.) An earlier cut declared a fixed height
  # so the stack could compute its total server-side; that was rejected
  # deliberately — and the reason still holds — because it cannot express
  # a bar that needs to be taller, or two bars stacked, without every consuming
  # app being reworked. The apps should respond to what the bar needs, not the
  # other way round.
  density_styles = {
    compact: "font-size:12px; font-weight:700; padding:2px 12px;",
    normal: "font-size:14px; font-weight:700; padding:8px 16px;"
  }

  style = tones.fetch(tone)
%>

<div class="w-full" style="background:<%= style.fetch(:background) %>; color:<%= style.fetch(:color) %>; box-shadow:<%= style.fetch(:shadow) %>;">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3" style="<%= density_styles.fetch(density) %>">
    <span class="min-w-0 truncate"><%= message %></span>
    <% if actions.present? %>
      <div class="shrink-0 flex items-center gap-2"><%= actions %></div>
    <% end %>
  </div>
</div>
