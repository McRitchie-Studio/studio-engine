<%# locals: (integration:, connections:, return_to:, linked:) %>
<%# One integration's card: status, what keeps it off, Connect (a POST, with
    the account field when the admin names the account at Connect), and its
    connections with Disconnect. No token, and no part of one, is shown. %>
<% provider = integration.provider %>
<% status = integration.status %>
<section class="card p-4" data-studio-integration-card="<%= integration.key %>" data-status="<%= status %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-heading font-semibold">
      <% if linked %><a href="<%= integration_path_for(integration) %>" class="hover:underline"><%= integration.label %></a><% else %><%= integration.label %><% end %>
    </h2>
    <span class="badge" data-studio-integration-status><%= integration.status_label %></span>
  </div>
  <p class="text-sm text-secondary mt-1"><%= integration.summary %></p>

  <% integration.missing.each do |reason| %>
    <p class="text-sm text-muted mt-2" data-studio-integration-missing><%= reason %></p>
  <% end %>

  <% if connections.any? %>
    <ul class="mt-3 divide-y divide-subtle" data-studio-integration-connections>
      <% connections.each do |connection| %>
        <li class="py-2 flex flex-wrap items-center justify-between gap-2" data-studio-integration-connection="<%= connection.id %>">
          <div>
            <p class="text-sm text-heading font-medium"><%= connection.label %></p>
            <p class="text-xs text-muted">
              Connected <%= connection.connected_at.utc.strftime("%Y-%m-%d %H:%M UTC") %><% if connection.connected_by.present? %> by <%= connection.connected_by %><% end %><% if connection.metadata.to_h["environment"].present? %> · <%= connection.metadata["environment"] %><% end %>
            </p>
          </div>
          <%= button_to "Disconnect", integration_disconnect_path(integration, connection), method: :delete,
                        params: { return_to: }, class: "btn btn-outline btn-sm",
                        form: { data: { turbo_confirm: "Disconnect #{connection.label}?" } } %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: integration_connect_path(integration), method: :post, local: true,
                class: "mt-3 flex flex-wrap items-end gap-2", data: { studio_integration_connect: integration.key, turbo: false } do |form| %>
    <%= hidden_field_tag :return_to, return_to %>
    <% if provider.account_source == :connect %>
      <label class="text-sm text-secondary">
        <span class="block mb-1"><%= integration.definition.account_label %></span>
        <%= text_field_tag provider.account_param, nil, class: "input-field py-2", required: true, autocomplete: "off",
                           placeholder: integration.definition.account_hint %>
      </label>
    <% end %>
    <%= form.submit(connections.any? ? "Connect another" : "Connect", class: "btn btn-primary btn-sm") %>
  <% end %>
</section>
