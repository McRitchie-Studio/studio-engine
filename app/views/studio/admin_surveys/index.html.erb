<%# /admin/surveys — every survey with its funnel (Studio::AdminSurveysController).
    "Started" counts responses with at least one answer: a row is created on the
    first answer, never on a page view. %>
<% content_for(:title, "Surveys") %>
<div class="max-w-4xl mx-auto px-4 py-6" data-admin-surveys>
  <h1 class="text-2xl font-extrabold text-heading mb-1">Surveys</h1>
  <p class="text-sm text-secondary mb-6">Defined in <code>config/surveys/</code>. A response counts as started at its first answer.</p>

  <% if @rows.empty? %>
    <div class="empty-state">
      <p class="text-heading font-semibold mb-1">No surveys yet</p>
      <p class="text-sm text-muted">Define one with <code>Studio.define_survey</code> — see the engine's docs/SURVEYS.md.</p>
    </div>
  <% else %>
    <div class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b border-subtle">
            <th scope="col" class="px-4 py-3 label-upper font-medium">Survey</th>
            <th scope="col" class="px-4 py-3 label-upper font-medium text-right">Started</th>
            <th scope="col" class="px-4 py-3 label-upper font-medium text-right">Completed</th>
            <th scope="col" class="px-4 py-3 label-upper font-medium text-right">Completion</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr class="border-b border-subtle last:border-0" data-admin-survey-row="<%= row[:slug] %>">
              <td class="px-4 py-3">
                <a href="<%= admin_survey_path(row[:slug]) %>" class="font-semibold text-heading hover:underline"><%= row[:survey]&.title || row[:slug] %></a>
                <div class="text-xs text-muted font-mono">/surveys/<%= row[:slug] %><% unless row[:survey] %> · definition removed<% end %></div>
              </td>
              <td class="px-4 py-3 text-right tabular-nums text-body" data-stat="started"><%= row[:started] %></td>
              <td class="px-4 py-3 text-right tabular-nums text-body" data-stat="completed"><%= row[:completed] %></td>
              <td class="px-4 py-3 text-right tabular-nums font-semibold text-heading" data-stat="rate"><%= row[:started].zero? ? "—" : "#{row[:rate]}%" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
