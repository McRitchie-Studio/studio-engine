<%# locals: (app_name:, home_path:, logo: nil, back_path: nil, heading: :h1) %>
<%# THE NOT-FOUND PAGE: what a lost visitor sees on an unknown address or a
    record that is not there (docs/NOT_FOUND_PAGE.md). Studio::NotFoundController
    renders it inside the app's own layout, from the app's Studio config:

      app_name   Studio.app_name: named in the button home.
      home_path  the app's root: the primary button.
      logo       the app's brand mark (Studio.navbar_brand's logo, else the
                 Navbar Logo theme image). nil draws no image.
      back_path  a page on this app the visitor came from: a second link back.
                 nil draws no second link.
      heading    the title's tag: :h1 on the page, a lower level where the page
                 is shown inside another (the style guide's card).

    Theme tokens only, so it reads in light and dark. The static last resort,
    public/404.html, carries the same words and the same data-test hooks. %>
<section class="mx-auto w-full max-w-md px-4 py-16 sm:py-24 text-center" data-studio-not-found data-test="not-found" aria-labelledby="studio-not-found-title">
  <% if logo.present? %>
    <img src="<%= logo %>" alt="<%= app_name %>" width="64" height="64" class="mx-auto mb-6 h-16 w-16 object-contain" data-studio-not-found-logo>
  <% end %>
  <p class="type-fine font-semibold uppercase tracking-wide text-primary-ink mb-2">404 &middot; Not found</p>
  <%= content_tag heading, "This page isn’t here", id: "studio-not-found-title", class: "type-h2 text-heading mb-3" %>
  <p class="type-body text-secondary mb-8">The address may be mistyped, or the page may have moved. Head back home and pick up from there.</p>
  <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
    <a href="<%= home_path %>" class="btn btn-primary w-full sm:w-auto" data-test="not-found-home">Back to <%= app_name %></a>
    <% if back_path.present? %>
      <a href="<%= back_path %>" class="btn btn-outline w-full sm:w-auto" data-test="not-found-back">Go back</a>
    <% end %>
  </div>
</section>
