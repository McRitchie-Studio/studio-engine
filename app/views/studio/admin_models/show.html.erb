<% content_for(:title, "#{@config.fetch(:label)} - Models - Admin") %>

<div class="max-w-7xl mx-auto px-4 pb-8 space-y-6">
  <%# The title and a tab per model, one sticky row, as on /admin/style. A tab is a
      link, so the open one is the page's own model. %>
  <nav class="sticky -mx-4 mt-6 px-4 py-2 bg-surface border-y border-subtle flex items-center gap-2"
       style="top: var(--pin-stack-bottom, var(--nav-bottom, var(--nav-h, 0px))); z-index: var(--z-sticky, 30)"
       aria-label="Models">
    <h1 class="text-xl font-bold text-heading shrink-0">Models</h1>
    <div class="fade-edge-x overflow-x-auto min-w-0 flex-1">
      <div class="flex items-center gap-2 min-w-max px-8">
        <% admin_model_configs.each do |key, config| %>
          <% open = key.to_s == @key %>
          <%= link_to config.fetch(:label), admin_model_path(key),
                class: "btn btn-sm #{open ? 'btn-primary' : 'btn-neutral'}",
                aria: { current: (open ? "page" : nil) } %>
        <% end %>
      </div>
    </div>
  </nav>

  <p class="text-muted text-sm">
    <%= @config.fetch(:description) %>.
    Page <%= @page %> of <%= @total_pages %>, <%= @total_count %> total.
  </p>

  <section class="card overflow-hidden">
    <%= render admin_models_table_partial(@key), records: @records %>
  </section>

  <nav class="flex items-center justify-between gap-3" aria-label="<%= @config.fetch(:label) %> pagination">
    <% if @page > 1 %>
      <%= link_to "Previous", admin_model_path(@key, page: @page - 1), class: "btn btn-outline" %>
    <% else %>
      <span class="btn btn-outline opacity-50 pointer-events-none">Previous</span>
    <% end %>

    <span class="text-xs text-muted">
      Showing <%= @records.size %> records on page <%= @page %>
    </span>

    <% if @page < @total_pages %>
      <%= link_to "Next", admin_model_path(@key, page: @page + 1), class: "btn btn-outline" %>
    <% else %>
      <span class="btn btn-outline opacity-50 pointer-events-none">Next</span>
    <% end %>
  </nav>
</div>
