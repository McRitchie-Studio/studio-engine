<%# Styles and scripts for the booking frame and the booking popup. Rendered
    once per page, by `studio_booking_assets` (the frame and the popup both ask).
    Scoped CSS for the reason studio/site_footer/_assets gives. %>
<style>
  /* The inline frame. Google's page cannot be themed, so the panel is white. */
  /* content-box, so the heights below are the WINDOW onto the frame whatever
     reset the host runs: under border-box the border would eat 2px of the crop. */
  .booking-frame { box-sizing: content-box; margin-inline: auto; overflow: hidden; background: #fff; border-radius: .75rem;
    border: 1px solid var(--color-border, rgb(127 127 127 / .25));
    /* A booking link on this page scrolls here; land below the pinned navbar. */
    scroll-margin-top: calc(var(--nav-bottom, 4rem) + 1rem); }
  .booking-frame iframe { display: block; width: 100%; border: 0; height: 1200px; }
  /* From 640px up Google lays the month beside the slots. A cropped wrapper
     carries its own numbers (Studio::Booking.crop_style): how far the frame is
     pulled up, the window's height, and the frame's full height. A wrapper with
     no crop carries none, and shows the frame whole at the default height. */
  @media (min-width: 640px) {
    .booking-frame iframe { height: var(--booking-frame-height, 732px); }
    .booking-frame-cropped { height: var(--booking-crop-window); transition: height .25s ease; }
    .booking-frame-cropped iframe { margin-top: calc(-1 * var(--booking-crop-offset)); transition: margin-top .25s ease; }
    .booking-frame-cropped.is-open { height: var(--booking-frame-height, 732px); }
    .booking-frame-cropped.is-open iframe { margin-top: 0; }
  }
  /* Scripts off: the frame never gets its src, so it is hidden and a plain link
     stands in its place (the <noscript> in studio/booking/_frame). */
  .booking-frame-noscript { margin: 0; padding: 3rem 1.5rem; text-align: center; color: #111; }
  .booking-frame-noscript a { color: #4338ca; font-weight: 700; text-decoration: underline; }
  .booking-frame-note { margin: 1rem 0 0; text-align: center; font-size: .875rem; line-height: 1.25rem; color: var(--color-text-muted, inherit); }
  .booking-frame-note a { color: var(--color-primary, #8b5cf6); }
  .booking-frame-note a:hover { text-decoration: underline; }

  /* The popup. */
  .booking-popup { width: min(960px, calc(100vw - 2rem)); height: min(800px, calc(100vh - 3rem)); height: min(800px, calc(100dvh - 3rem)); max-width: none; max-height: none;
    /* Tailwind's reset zeroes a dialog's margin, which is what centres it. */
    margin: auto; inset: 0;
    padding: 0; border: 1px solid rgb(127 127 127 / .3); border-radius: .75rem; overflow: hidden;
    background: var(--color-surface, #fff); color: var(--color-text-body, inherit); }
  .booking-popup[open] { display: flex; flex-direction: column; }
  .booking-popup::backdrop { background: rgb(15 12 31 / .72); backdrop-filter: blur(3px); }
  .booking-popup-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0;
    padding: .6rem .75rem .6rem 1.1rem; }
  .booking-popup-title { font-weight: 700; color: var(--color-text, inherit); }
  /* THE WAY OUT HAS TO BE UNMISSABLE. Once focus is inside Google's frame the
     Escape key goes to Google, not to this dialog, and nothing here can change
     that. So Close is a solid, full-size button, not a quiet glyph, and a click
     anywhere on the backdrop closes too. */
  /* Ink on surface, inverted: the theme's text colour as the fill and its
     surface as the label. That pair is the theme's own highest contrast in both
     modes (white on the primary measured 3.10:1, under the 4.5:1 a label needs). */
  .booking-popup-close { flex: none; min-height: 2.75rem; padding: .5rem 1.1rem; border-radius: .5rem; border: 0;
    background: var(--color-text, #111827); color: var(--color-surface, #fff); font: inherit; font-size: .95rem; font-weight: 700; cursor: pointer; }
  .booking-popup-close:hover { filter: brightness(1.12); }
  .booking-popup-close:focus-visible { outline: 3px solid var(--color-primary, #8b5cf6); outline-offset: 2px; }
  /* The page behind does not scroll while the dialog is open. Pure CSS, so every
     way of closing it (the button, the backdrop, Escape) lifts the lock. On html
     rather than body for the reason studio/modals/_host gives. */
  html:has(dialog[data-booking-dialog][open]) { overflow: hidden; }
  .booking-popup iframe { flex: 1; width: 100%; border: 0; background: #fff; }
  @media (prefers-reduced-motion: reduce) { .booking-frame, .booking-frame iframe { transition: none; } }
</style>

<script>
  // The inline frame: assign src after `load`, once the frame is near the
  // viewport, and open the crop when focus moves into the frame.
  //
  // THE GUARDS ARE THE ENGINE'S OWN NAMES, AND THE ELEMENTS ARE THE ENGINE'S OWN
  // (data-studio-booking), for the reason studio/site_footer/_assets gives for
  // the map: an app that still renders a local booking script guards it with
  // the unprefixed names and marks its frame, dialog and links with the same
  // data-booking-* attributes. Sharing either lets one script stand the other
  // down across a Turbo visit, or act on elements that are not its own.
  (function () {
    if (window.__studioBookingFramesArmed) return;
    window.__studioBookingFramesArmed = true;

    // ASK GOOGLE ONCE. Two things can ask for a frame: scrolling near it, and a
    // booking link that jumps to it. Assigning src a second time, even to the
    // same URL, is a second request, so whoever comes second finds it set.
    function load(frame) {
      if (!frame.getAttribute('src')) frame.src = frame.dataset.src;
    }
    window.__studioBookingLoad = load;

    function arm() {
      document.querySelectorAll('iframe[data-booking-frame][data-studio-booking][data-src]').forEach(function (frame) {
        if (frame.__bookingArmed) return;
        frame.__bookingArmed = true;
        if (typeof IntersectionObserver !== 'function') { load(frame); return; }
        var watcher = new IntersectionObserver(function (entries) {
          if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
          watcher.disconnect();
          load(frame);
        }, { rootMargin: '200px' });
        watcher.observe(frame);
      });
    }

    function armAfterLoad() {
      if (document.readyState === 'complete') arm();
      else window.addEventListener('load', arm, { once: true });
    }

    // Focus moving into the frame is the one signal a cross-origin frame gives
    // its parent. It means the visitor has started using the calendar.
    function openActive() {
      var active = document.activeElement;
      if (!active || !active.matches || !active.matches('iframe[data-booking-frame][data-studio-booking]')) return;
      var wrap = active.closest('[data-booking-wrap][data-studio-booking]');
      if (wrap) wrap.classList.add('is-open');
    }

    // THE WINDOW BLURS ONCE. Focus that moves from one frame straight into
    // another never comes back through this window, so no second blur announces
    // the second frame, and on a page with two cropped frames it would stay
    // cropped under the visitor's cursor. So while focus is away in a frame and a
    // cropped wrapper is still shut, look again a few times a second. It stops
    // when focus returns here or nothing is left to open, and a page with one
    // frame never starts it: that frame is open by then.
    var watching = null;
    function shut() { return document.querySelector('[data-booking-wrap][data-studio-booking][data-booking-crop]:not(.is-open)'); }
    function stopWatching() { if (watching) { clearInterval(watching); watching = null; } }

    window.addEventListener('blur', function () {
      openActive();
      var active = document.activeElement;
      if (watching || !active || active.tagName !== 'IFRAME' || !shut()) return;
      watching = setInterval(function () {
        openActive();
        if (!shut()) stopWatching();
      }, 250);
    });
    window.addEventListener('focus', stopWatching);

    document.addEventListener('turbo:load', armAfterLoad);
    armAfterLoad();
  })();
</script>

<script>
  // Any a[data-booking-popup] link opens the booking dialog instead of leaving
  // the page. Delegated from document, so it survives Turbo body swaps. A
  // modified click (new tab, new window) is left alone, and so is everything
  // when the dialog is missing or <dialog> is unsupported: the link's own href
  // then takes the visitor to the booking page.
  //
  // ON A PAGE THAT ALREADY SHOWS THE INLINE FRAME the link goes to that frame
  // instead: it scrolls there, opens the crop and moves focus in. A popup would
  // be a second copy of the calendar on top of the first.
  (function () {
    if (window.__studioBookingPopupArmed) return;
    window.__studioBookingPopupArmed = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest && event.target.closest('a[data-booking-popup][data-studio-booking]');
      if (!link) return;
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      var inline = document.querySelector('iframe[data-booking-frame][data-studio-booking]');
      if (inline) {
        event.preventDefault();
        var wrap = inline.closest('[data-booking-wrap][data-studio-booking]');
        if (wrap) wrap.classList.add('is-open');
        // Before `load` the frame keeps waiting: its own script assigns src then.
        if (document.readyState === 'complete' && window.__studioBookingLoad) window.__studioBookingLoad(inline);
        var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        (wrap || inline).scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
        inline.focus({ preventScroll: true });
        return;
      }

      var dialog = document.querySelector('dialog[data-booking-dialog][data-studio-booking]');
      if (!dialog || typeof dialog.showModal !== 'function') return;

      event.preventDefault();
      var frame = dialog.querySelector('iframe[data-booking-popup-frame]');
      if (frame && !frame.getAttribute('src')) frame.src = frame.dataset.src;
      if (!dialog.open) dialog.showModal();
    });

    // A click on the backdrop lands on the dialog element itself.
    document.addEventListener('click', function (event) {
      if (event.target.matches && event.target.matches('dialog[data-booking-dialog][data-studio-booking]')) event.target.close();
    });

    // Never snapshot the dialog open: a restored page would show it stuck. And
    // never snapshot its frame loaded: a restored page would ask Google for a
    // popup nobody has opened. The src goes back to waiting in data-src.
    document.addEventListener('turbo:before-cache', function () {
      var dialog = document.querySelector('dialog[data-booking-dialog][data-studio-booking]');
      if (!dialog) return;
      if (dialog.open) dialog.close();
      var frame = dialog.querySelector('iframe[data-booking-popup-frame]');
      if (frame) frame.removeAttribute('src');
    });
  })();
</script>
