<%# locals: (soul:, name:, copy: nil) %>
<%# Hold to talk, in the composer's mic slot (studio/agent_chat/_form;
    docs/AGENT_CHAT.md, "Talking by voice"). The engine's microphone chip and
    recorder capture the take; studio/agent_chat_voice (the lazy
    "agent-chat-voice" controller) embeds it on this device when the page names
    an embedder, posts it to POST /voice/takes and sends the words to the chat.
    No audio is kept. Status lines are set as text.

    Scoped CSS for the reason studio/voice/_styles gives: it must render in an
    app whose Tailwind build never saw this file. The status line keeps its one
    line even when empty, so a line that comes or goes while a finger holds the
    button does not move the button. %>
<% words = Studio::AgentChat.voice_copy(copy) %>
<style>
  .studio-agent-voice { display: grid; gap: .25rem; padding: 0 .25rem .25rem; min-width: 0; }
  .studio-agent-voice-status { min-height: 1.25rem; margin: 0; padding: 0 .5rem; font-size: .875rem; line-height: 1.25rem; overflow-wrap: anywhere;
    color: var(--color-text-body, inherit); }
  .studio-agent-voice-failed { display: none; margin: 0; padding: 0 .5rem; font-size: .8125rem; color: var(--color-text-secondary, inherit); }
  [data-studio-controller-failed~="agent-chat-voice"] > .studio-agent-voice-failed { display: block; }
  /* One row where both fit; on a phone the chip takes the first line and the
     talk button the whole of the second. */
  .studio-agent-voice-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; min-width: 0; }
  .studio-agent-voice-row .studio-mic { display: contents; }
  .studio-agent-voice-row .studio-mic-chip { flex: 1 1 14rem; min-width: 0; }
  .studio-agent-voice-row .studio-mic-panel { flex: 1 0 100%; max-width: none; order: 3; }
  .studio-agent-voice-row .studio-mic-failed { flex: 1 0 100%; order: 4; }
  .studio-agent-voice-row .studio-recorder { flex: 1 1 10rem; min-width: 0; flex-flow: row wrap; justify-content: flex-end; gap: .5rem; }
  .studio-agent-voice-row .studio-recorder-button { flex: 1 1 10rem; min-width: 0; padding: .625rem 1rem; }
  .studio-agent-voice-row .studio-recorder-timer { display: none; }
  .studio-agent-voice-row [data-voice-recorder-state="recording"] .studio-recorder-timer { display: inline; }
  .studio-agent-voice-row .studio-recorder-status { flex: 1 0 100%; min-height: 0; max-width: none; font-size: .875rem; }
  .studio-agent-voice-row .studio-recorder-status:empty,
  .studio-agent-voice-row [data-voice-recorder-state="silent"] .studio-recorder-status { display: none; }
  .studio-agent-voice-row .studio-recorder-failed { flex: 1 0 100%; }
</style>
<div class="studio-agent-voice" role="group" aria-label="Talk to <%= name %>"
     data-studio-controller="agent-chat-voice" data-agent-chat-voice data-test="agent-chat-voice"
     data-agent-chat-voice-state="idle"
     data-agent-chat-voice-soul="<%= soul %>" data-agent-chat-voice-name="<%= name %>"
     data-agent-chat-voice-takes-url="<%= studio_voice_takes_path %>"
     <%= tag.attributes("data-agent-chat-voice-embedder": studio_agent_chat_embedder(studio_agent_chat_viewer)) %>>
  <p class="studio-agent-voice-status" role="status" aria-live="polite"
     data-agent-chat-voice-status data-test="agent-chat-voice-status"></p>
  <div class="studio-agent-voice-row">
    <%= render "studio/voice/microphone_chip", copy: words["chip"] %>
    <%= render "studio/voice/recorder", id: "#{soul}-voice-recorder", mode: "hold", copy: words["recorder"] %>
  </div>
  <p class="studio-agent-voice-failed">Voice didn't load on this page. Reload to try again, or type instead.</p>
</div>
