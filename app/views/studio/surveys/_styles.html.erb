<%# Survey styles, scoped under .studio-survey. Plain CSS on the theme's CSS
    custom properties (--color-cta, --color-surface, ...) rather than Tailwind
    utilities, so the page looks the same in every host whatever its Tailwind
    scan picks up, and follows the host's dark and light palettes for free.
    Motion is opt-out: prefers-reduced-motion drops every transition. %>
<style>
  /* overflow-x: clip, not hidden: the slide-in must never widen the page, and
     clip makes no scroll container, so the sticky nav still sticks. */
  .studio-survey { --sv-accent: var(--color-cta, #8E82FE); display: flex; justify-content: center; padding: 1.25rem 1rem 2rem; color: var(--color-text-body); overflow-x: clip; }
  .studio-survey [hidden] { display: none !important; }
  .studio-survey__shell { width: 100%; max-width: 36rem; }
  .studio-survey__sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .studio-survey__top { margin-bottom: 1.75rem; }
  .studio-survey__progress { height: 6px; border-radius: 999px; background: var(--color-surface-alt); overflow: hidden; }
  .studio-survey__progress-fill { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--sv-accent); transition: width .35s cubic-bezier(.2, .8, .2, 1); }
  .studio-survey__count { min-height: 1.25rem; margin: .5rem 0 0; font-size: .8125rem; line-height: 1.25rem; color: var(--color-text-muted); }
  .studio-survey__step { border: 0; margin: 0 0 2.25rem; padding: 0; min-width: 0; }
  .studio-survey__title { margin: 0 0 .75rem; font-size: 1.75rem; line-height: 1.2; font-weight: 800; color: var(--color-text); outline: none; }
  .studio-survey__intro-copy { margin: 0 0 1rem; font-size: 1.0625rem; line-height: 1.55; color: var(--color-text-body); white-space: pre-line; }
  .studio-survey__meta { margin: 0; font-size: .8125rem; color: var(--color-text-muted); }
  .studio-survey__question { display: block; width: 100%; padding: 0; margin: 0 0 .5rem; font-size: 1.375rem; line-height: 1.3; font-weight: 700; color: var(--color-text); outline: none; }
  .studio-survey__qnum { display: block; margin-bottom: .375rem; font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-muted); }
  .studio-survey.is-enhanced .studio-survey__qnum { display: none; }
  .studio-survey__req { color: var(--sv-accent); margin-left: .125rem; }
  .studio-survey__help { margin: 0 0 1rem; font-size: .9375rem; line-height: 1.5; color: var(--color-text-secondary); }
  .studio-survey__body { margin-top: 1rem; }
  .studio-survey__error { margin: .75rem 0 0; font-size: .875rem; font-weight: 600; color: var(--color-danger-ink, var(--color-danger)); }
  .studio-survey__input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }

  .studio-survey__scale { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .5rem; }
  .studio-survey__tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; min-height: 4.75rem; padding: .75rem .25rem; border: 2px solid var(--color-border); border-radius: 1rem; background: var(--color-surface); color: var(--color-text-body); cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; transition: transform .12s ease, border-color .15s ease, background-color .15s ease; }
  .studio-survey__tile:hover { border-color: var(--color-border-strong); }
  .studio-survey__tile:active { transform: scale(.95); }
  .studio-survey__face { font-size: 2.125rem; line-height: 1; transition: transform .18s cubic-bezier(.3, 1.6, .5, 1); }
  .studio-survey__num { font-size: 1.5rem; line-height: 1; font-weight: 800; color: var(--color-text); }
  .studio-survey__tile-label { font-size: .6875rem; line-height: 1.15; text-align: center; color: var(--color-text-secondary); }
  .studio-survey__ends { display: flex; justify-content: space-between; gap: 1rem; margin-top: .5rem; font-size: .75rem; color: var(--color-text-muted); }

  .studio-survey__options { display: flex; flex-direction: column; gap: .5rem; }
  .studio-survey__option { position: relative; display: flex; align-items: center; gap: .75rem; min-height: 3.25rem; padding: .75rem 1rem; border: 2px solid var(--color-border); border-radius: .875rem; background: var(--color-surface); color: var(--color-text-body); font-size: 1rem; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: border-color .15s ease, background-color .15s ease; }
  .studio-survey__option:hover { border-color: var(--color-border-strong); }
  .studio-survey__mark { flex: none; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border: 2px solid var(--color-text-muted); border-radius: 999px; background: var(--color-surface); }
  .studio-survey__mark--box { border-radius: .375rem; }
  .studio-survey__option-label { flex: 1 1 auto; min-width: 0; }

  .studio-survey__tile:has(input:checked), .studio-survey__option:has(input:checked) { border-color: var(--sv-accent); background: color-mix(in srgb, var(--sv-accent) 14%, var(--color-surface)); color: var(--color-text); }
  .studio-survey__tile:has(input:checked) .studio-survey__face { transform: scale(1.18); }
  .studio-survey__tile:has(input:checked) .studio-survey__tile-label { color: var(--color-text); font-weight: 600; }
  .studio-survey__option:has(input:checked) .studio-survey__mark { border-color: var(--sv-accent); background: var(--sv-accent); box-shadow: inset 0 0 0 3px var(--color-surface); }
  .studio-survey__option:has(input:checked) .studio-survey__mark--box { box-shadow: none; }
  .studio-survey__option:has(input:checked) .studio-survey__mark--box::after { content: ""; width: .35rem; height: .65rem; margin-top: -.15rem; border: solid var(--btn-primary-fg, #fff); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .studio-survey__tile:has(input:focus-visible), .studio-survey__option:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--sv-accent) 70%, transparent); outline-offset: 2px; }

  .studio-survey__kbd { display: none; font-size: .625rem; font-weight: 600; color: var(--color-text-muted); border: 1px solid var(--color-border); border-radius: .25rem; padding: 0 .3rem; line-height: 1.4; }
  .studio-survey__tile .studio-survey__kbd { position: absolute; top: .3rem; right: .35rem; }
  .studio-survey__option .studio-survey__kbd { margin-left: auto; }
  @media (hover: hover) and (pointer: fine) { .studio-survey.is-enhanced .studio-survey__option .studio-survey__kbd { display: inline-block; } }
  /* On a scale tile the badge needs the room a phone-width tile does not have. */
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) { .studio-survey.is-enhanced .studio-survey__tile .studio-survey__kbd { display: inline-block; } }

  .studio-survey__text { width: 100%; font-size: 1rem; }
  textarea.studio-survey__text { min-height: 9rem; resize: vertical; line-height: 1.5; }
  .studio-survey__counter { margin: .375rem 0 0; text-align: right; font-size: .75rem; color: var(--color-text-muted); }

  .studio-survey__nav { display: flex; align-items: center; gap: .75rem; }
  .studio-survey.is-enhanced .studio-survey__nav { position: sticky; bottom: 0; padding: .75rem 0 calc(.75rem + env(safe-area-inset-bottom, 0px)); background: linear-gradient(to top, var(--color-page) 72%, transparent); }
  .studio-survey__nav .btn { min-height: 3rem; min-width: 6.5rem; }
  .studio-survey__forward { margin-left: auto; }
  .studio-survey__status { min-height: 1.25rem; margin: .5rem 0 0; font-size: .75rem; text-align: center; color: var(--color-text-muted); }
  .studio-survey__hint { margin: .25rem 0 0; font-size: .75rem; text-align: center; color: var(--color-text-muted); }
  @media (hover: none), (pointer: coarse) { .studio-survey__hint { display: none; } }

  .studio-survey__card { padding: 2rem 1.5rem; text-align: center; border: 1px solid var(--color-border); border-radius: 1.25rem; background: var(--color-surface); }
  .studio-survey__burst { font-size: 3rem; line-height: 1; margin-bottom: .75rem; }

  @keyframes studio-survey-in-fwd { from { opacity: 0; transform: translateX(1.5rem); } to { opacity: 1; transform: none; } }
  @keyframes studio-survey-in-back { from { opacity: 0; transform: translateX(-1.5rem); } to { opacity: 1; transform: none; } }
  @keyframes studio-survey-shake { 0%, 100% { transform: none; } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .studio-survey__step.is-active[data-dir="fwd"] { animation: studio-survey-in-fwd .3s cubic-bezier(.2, .8, .2, 1); }
  .studio-survey__step.is-active[data-dir="back"] { animation: studio-survey-in-back .3s cubic-bezier(.2, .8, .2, 1); }
  .studio-survey__step.is-invalid .studio-survey__body { animation: studio-survey-shake .3s ease; }
  @media (prefers-reduced-motion: reduce) {
    .studio-survey *, .studio-survey *::before, .studio-survey *::after { animation: none !important; transition: none !important; }
  }

  @media (min-width: 640px) {
    .studio-survey { padding-top: 3rem; }
    .studio-survey__question { font-size: 1.625rem; }
    .studio-survey__title { font-size: 2.125rem; }
    .studio-survey__scale { gap: .75rem; }
    .studio-survey__tile { min-height: 5.5rem; }
    .studio-survey__face { font-size: 2.5rem; }
    .studio-survey__tile-label { font-size: .75rem; }
  }
</style>
