<%# /surveys/:slug — the survey (Studio::SurveysController#show, docs/SURVEYS.md).

    ONE FORM, TWO PRESENTATIONS. Without JavaScript every question renders in
    order under the title and intro, and the Submit button posts the lot.
    studio/survey (the survey controller on the root) adds .is-enhanced and
    turns the same markup into one question
    per screen, opening on question 1 with no intro screen, with a progress
    bar, Back (from question 2 on) and Next, number-key and Enter shortcuts, and an
    autosave on each answer. Submit is still the same POST either way, so the
    server's validation is the one rule. %>
<% total = @survey.questions.size %>
<% minutes = [(total / 3.0).ceil, 1].max %>
<% content_for(:title, @survey.title) %>
<%= render "studio/surveys/styles" %>

<main class="studio-survey" data-studio-survey data-studio-controller="survey"
      data-answer-base="<%= studio_survey_path(@survey.slug) %>/answers/"
      data-csrf="<%= form_authenticity_token %>"
      data-resume-index="<%= @resume_index %>"
      data-has-errors="<%= @errors.any? %>"
      data-total="<%= total %>">
  <div class="studio-survey__shell">
    <div class="studio-survey__top" data-survey-top hidden>
      <div class="studio-survey__progress" role="progressbar" aria-label="Survey progress"
           aria-valuemin="0" aria-valuemax="<%= total %>" aria-valuenow="0" data-survey-progress>
        <span class="studio-survey__progress-fill" data-survey-progress-fill></span>
      </div>
      <p class="studio-survey__count" aria-live="polite" data-survey-count></p>
    </div>

    <%= form_with url: studio_survey_path(@survey.slug), method: :post, local: true,
                  html: { class: "studio-survey__form", data: { survey_form: true } } do %>
      <%# The head is not a step: the survey opens straight on question 1. The
          title stays the page's h1 for a screen reader; when it says what
          question 1 asks, the stepper hides it visually rather than paint the
          same words twice. The intro is a quiet lead line over question 1. %>
      <header class="studio-survey__head<%= " studio-survey__head--echo" if @survey.title_repeats_first_question? %>" data-survey-head>
        <h1 class="studio-survey__title" id="studio-survey-title"><%= @survey.title %></h1>
        <% if @survey.intro %>
          <p class="studio-survey__intro-copy" data-survey-intro><%= @survey.intro %></p>
        <% end %>
        <p class="studio-survey__meta">
          <%= pluralize(total, "question") %> · about <%= pluralize(minutes, "minute") %><% if @survey.required_keys.any? %> · <span aria-hidden="true">*</span> required<% end %>
        </p>
        <% if @errors.any? %>
          <p class="studio-survey__error" role="alert">A few answers need another look before this can be sent.</p>
        <% end %>
      </header>

      <% @survey.questions.each_with_index do |question, index| %>
        <%= render "studio/surveys/question", question: question, index: index, total: total,
                                              response: @response, error: @errors[question.key] %>
      <% end %>

      <div class="studio-survey__nav">
        <button type="button" class="btn btn-neutral" data-survey-back hidden>Back</button>
        <button type="button" class="btn btn-primary studio-survey__forward" data-survey-next hidden>Next</button>
        <button type="submit" class="btn btn-primary studio-survey__forward" data-survey-submit>Submit</button>
      </div>
      <p class="studio-survey__status" aria-live="polite" data-survey-status></p>
      <p class="studio-survey__hint" data-survey-hint hidden>Press a number to choose · Enter to continue</p>
    <% end %>
  </div>
</main>
