<%#
  PAGE-SCOPED modal host — a self-contained modal shell mounted on its OWN
  Alpine store, for a page that must bring its own modals rather than rely on
  the app's shared host.

  Why this exists as a separate partial rather than a local on
  studio/modals/_host: this is a NON-ISOLATED engine, so an app view at the same
  path SHADOWS the engine's. `mcritchie-studio` and `turf-monster` both ship
  their own app/views/studio/modals/_host.html.erb — older, simpler copies that
  know nothing of a store: local. A page rendering "studio/modals/host" in those
  apps silently gets the fork, and its page-scoped store is never registered.
  This partial's path is unforked in every app, so it renders the engine's code
  everywhere. (The living style guide hand-rolled the same thing inline for the
  same reason; it can rebase onto this later.)

  Two independent problems it solves at once:

    1. Apps that DO have a shared host (mcritchie-studio, turf-monster) register
       their own modal set. A page needing crop-photo would have to ask every
       app to add it.
    2. Apps that have NO host at all (mcritchie-industries, moms-app) would have
       nowhere to open a modal from.

  Both go away when the page owns its host.

  Animations come from the shared motion layer
  (app/assets/tailwind/studio_engine/engine-motion.css) — the .modal-card-* and
  .modal-backdrop-* classes — rather than an inline copy, so this stays small.
  A consumer that does not bundle engine-motion.css still gets a working modal,
  just without the spring.

  Locals:
    store      — REQUIRED. Alpine store name, e.g. "emailModals". Must be unique
                 on the page; never "modals" (that is the shared host's).
    card_class — optional card sizing/skin override. Default is the shared
                 host's max-w-sm card.

  Usage: render this partial with a block, exactly like the shared host, and put
  one `template x-if` per modal id inside it — see app/views/studio/emails/
  index.html.erb for the live call site. Guard each registration with optional
  chaining (`current()?.id`): the outer template unmounts one tick AFTER the
  stack empties, so a bare `.id` throws on every close.

  (No inline ERB example here on purpose. An ERB comment ends at its FIRST "%" +
  ">", so an example containing one silently closes the comment and dumps the
  rest of it onto the page as visible text. That shipped once.)
%>
<%
  scoped_store = local_assigns.fetch(:store)
  card_class   = local_assigns.fetch(:card_class,
                   "bg-surface rounded-xl border border-subtle shadow-2xl p-6 max-w-sm w-full")
%>
<style>
  /* Scroll lock, applied by the store's _sync() while the stack is non-empty.
     Shipped here too because an app with no shared host never defines it. */
  body.modal-open { overflow: hidden; }
</style>

<script>
  (function() {
    var STORE_NAME    = '<%= scoped_store %>';
    // Keep in sync with .modal-card-unmount in engine-motion.css — the entry is
    // spliced off the stack only after the exit animation has played.
    var CLOSE_ANIM_MS = 220;

    // window.StudioModals.holdAtLeast(ms) — the minimum-visible-duration
    // convention shared with the app-level host, so a spinner can't flash past
    // the user. Defined defensively: this page may be the only host on it.
    window.StudioModals = window.StudioModals || {};
    window.StudioModals.holdAtLeast = window.StudioModals.holdAtLeast || function(minMs) {
      var startedAt = Date.now();
      return {
        then: function(callback) {
          var remaining = Math.max(0, minMs - (Date.now() - startedAt));
          if (remaining === 0) { callback(); return; }
          setTimeout(callback, remaining);
        }
      };
    };

    // Named, so the dual-guard below can call it directly on a Turbo visit.
    // Alpine's deferred script fires alpine:init exactly ONCE per full document
    // load; this registration lives in a PAGE BODY, so it was absent during that
    // one init. Without the guard, a Turbo Drive visit to this page leaves the
    // store undefined and every x-data on it throws.
    var _returnFocusTo = null;
    // The backdrop node, kept in the same closure and for the same proxy reason.
    var _backdropEl = null;

    function registerScopedStore() {
      if (Alpine.store(STORE_NAME)) return;

      Alpine.store(STORE_NAME, {
        stack: [],

        // FOCUS — the same contract as the shared host (studio/modals/_host).
        // Both hosts render [role=dialog]; a fix in only one of them leaves every
        // page that brings its own store still trapping keyboard users behind an
        // overlay, which is the "engine-wide" half of this defect.
        //
        // The return target is held in the closure below, NOT on the store: an
        // Alpine store is a reactive Proxy, so a DOM node assigned to it reads back
        // as a proxy and every identity check against it (===, contains) is false.
        captureFocus: function(el) {
          _returnFocusTo = document.activeElement;
          _backdropEl = el;
          if (el && el.focus) el.focus();
        },

        // RE-FOCUS AFTER A REPLACE, without re-capturing the return target. See
        // the long note in _host.html.erb: captureFocus runs from x-init on the
        // backdrop, and a replace keeps current() truthy, so the outer template
        // never re-mounts and x-init never re-runs. The inner content DOES
        // re-mount and unmounts the focused control, activeElement falls back to
        // the document body, and the tab handler bound on the backdrop stops seeing
        // the key. (Written out rather than as a literal tag: this comment ships
        // inside the rendered script, and studio/emails asserts the page emits no
        // body element of its own — a tag in prose trips it.)
        // _returnFocusTo is untouched on purpose — re-capturing would overwrite
        // the opener with a node inside the dialog.
        refocus: function() {
          var run = function() {
            if (_backdropEl && _backdropEl.focus && document.contains(_backdropEl)) {
              _backdropEl.focus();
            }
          };
          if (window.Alpine && window.Alpine.nextTick) window.Alpine.nextTick(run);
          else setTimeout(run, 0);
        },

        releaseFocus: function() {
          var target = _returnFocusTo;
          _returnFocusTo = null;
          _backdropEl = null;
          if (target && target.focus && document.contains(target)) target.focus();
        },

        focusables: function(el) {
          if (!el) return [];
          var sel = 'a[href], button:not([disabled]), input:not([disabled]), ' +
                    'select:not([disabled]), textarea:not([disabled]), [tabindex]';
          return Array.prototype.slice.call(el.querySelectorAll(sel)).filter(function(n) {
            return n.tabIndex >= 0 && n.offsetParent !== null;
          });
        },

        cycleFocus: function(el, event) {
          var items = this.focusables(el);
          if (items.length === 0) { if (el && el.focus) el.focus(); return; }

          var idx = items.indexOf(document.activeElement);
          var next;
          if (event && event.shiftKey) {
            next = idx <= 0 ? items[items.length - 1] : items[idx - 1];
          } else {
            next = (idx === -1 || idx === items.length - 1) ? items[0] : items[idx + 1];
          }
          next.focus();
        },

        dialogLabel: function() {
          var entry = this.current();
          if (!entry) return 'Dialog';
          var p = entry.props || {};
          // TRIMMED, not merely truthy. `title: '   '` is a truthy string, so it used to
          // pass straight through — and the accessible-name computation then trims it to
          // empty and announces a bare "dialog", the exact outcome this fallback chain
          // exists to prevent. An empty string already fell through (it is falsy); a
          // whitespace-only one did not, which is the more likely typo of the two.
          var named = function(v) {
            return (typeof v === 'string' && v.trim() !== '') ? v : null;
          };
          return named(p.ariaLabel) || named(p.title) || String(entry.id).replace(/[-_]/g, ' ');
        },

        // open(id, props, opts) — opts.replace swaps the top entry in place
        // (what submitFormWithProgress does to turn crop-photo into saving).
        open: function(id, props, opts) {
          props = props || {};
          opts  = opts  || {};
          var entry = { id: id, props: props };

          // Did this call re-mount the INNER content template without re-mounting the
          // OUTER one? That is the whole question the focus trap turns on.
          var remounted = false;
          if (opts.replace && this.stack.length > 0) {
            this.stack.splice(this.stack.length - 1, 1, entry);
            remounted = true;
          } else {
            // THE COMMENT THIS REPLACES SAID "only on a REPLACE", on the premise that a
            // fresh push takes current() falsy -> truthy so the outer template mounts and
            // x-init captures for us. That is TRUE only when the stack was EMPTY, and
            // silently false for a stacked push: current() was already truthy, so the
            // outer template does not re-mount, x-init never re-runs, and the inner
            // template unmounts whatever was focused. Focus lands on the document body — not a
            // descendant of the backdrop — so the @keydown.tab handler bound there stops
            // firing and native tabbing walks straight onto the page behind.
            remounted = this.stack.length > 0;
            this.stack.push(entry);
          }
          this._sync();
          if (remounted) this.refocus();
        },

        swap: function(id, props, opts) {
          opts = opts || {};
          opts.replace = true;
          this.open(id, props, opts);
        },

        // Flip _closing so the exit animation plays, then splice.
        close: function() {
          var entry = this.current();
          if (!entry) return;

          var self = this;
          entry._closing = true;
          setTimeout(function() {
            var index = self.stack.indexOf(entry);
            if (index !== -1) self.stack.splice(index, 1);
            self._sync();
            // Only when the LAST modal leaves — a stacked flow unmounts one dialog
            // and mounts the next, and restoring in between yanks focus out of a
            // flow the user is still inside.
            //
            // NOT RESTORING IS NOT THE SAME AS DOING NOTHING. Closing down TO an
            // underlying modal re-mounts the inner template, so focus falls to the document body
            // with that dialog still open — the trap is off while the user is still
            // inside it. The gate was right; the else was missing.
            if (self.stack.length === 0) self.releaseFocus();
            else self.refocus();
          }, CLOSE_ANIM_MS);
        },

        closeAll: function() {
          // Teardown path (Turbo/bfcache): drop the target rather than restoring
          // into a document that is about to be replaced.
          _returnFocusTo = null;
          this.stack = [];
          this._sync();
        },

        // Keeps dismissible: false entries — a still-in-flight upload must not
        // silently lose the card its promise will resolve against.
        closeAllDismissible: function() {
          this.stack = this.stack.filter(function(entry) {
            return entry.props && entry.props.dismissible === false;
          });
          this._sync();
          // Same re-mount, same release: a surviving non-dismissible card is still on
          // screen and the cards dropped from under it took focus with them. Nothing is
          // done when the stack empties — deliberately unlike close(): this is the
          // Turbo/bfcache teardown path, where closeAll() already declines to restore
          // into a document about to be replaced.
          if (this.stack.length > 0) this.refocus();
        },

        // isOpen(id) — on the stack in ANY lifecycle state, including a card
        // mid-close (close() flips _closing at once and splices only after
        // CLOSE_ANIM_MS). isLive() below is the "still up" question.
        isOpen: function(id) {
          return this.stack.some(function(entry) { return entry.id === id; });
        },

        // isLive(id) / isLive([id, ...]) — on the stack and NOT on its way
        // out. Mirrors the shared host's primitive so a page-scoped store
        // answers the same question the same way; see studio/modals/_host
        // for the full lifecycle rationale. Tests _closing ALONE: a leaving
        // swap() entry carries _swappingOut AND _closing, so _swappingOut on
        // its own must never count as leaving.
        isLive: function(id) {
          var ids = Array.isArray(id) ? id : [id];
          return this.stack.some(function(entry) {
            return entry && !entry._closing && ids.indexOf(entry.id) !== -1;
          });
        },

        current: function() {
          return this.stack.length ? this.stack[this.stack.length - 1] : null;
        },

        // Mount on open, unmount while closing. _settled pins the entry after
        // its first render so a stale Alpine re-evaluation cannot re-fire the
        // bounce-in keyframe mid-life (which reads as a flash).
        cardClasses: function() {
          var entry = this.current();
          if (!entry) return '';
          if (entry._closing) return 'modal-card-unmount';
          if (!entry._settled) { entry._settled = true; }
          return 'modal-card-mount';
        },

        _sync: function() {
          document.body.classList.toggle('modal-open', this.stack.length > 0);
        }
      });
    }

    if (window.Alpine) { registerScopedStore(); }
    else { document.addEventListener('alpine:init', registerScopedStore); }

    // bfcache + Turbo snapshot cleanup, so a modal left open does not reappear
    // on a back navigation.
    function clearStaleScopedModals() {
      if (!window.Alpine || !Alpine.store) return;

      var store = Alpine.store(STORE_NAME);
      if (store && typeof store.closeAllDismissible === 'function') store.closeAllDismissible();
    }
    window.addEventListener('pageshow', function(e) { if (e.persisted) clearStaleScopedModals(); });
    document.addEventListener('turbo:before-cache', clearStaleScopedModals);
  })();
</script>

<template x-if="$store.<%= scoped_store %>.current()">
  <div class="fixed inset-0 z-[120] flex items-center justify-center p-4 modal-backdrop-mount"
       :class="$store.<%= scoped_store %>.current()?._closing && 'modal-backdrop-unmount'"
       style="background:rgba(0,0,0,0.6)"
       role="dialog"
       aria-modal="true"
       tabindex="-1"
       x-init="$store.<%= scoped_store %>.captureFocus($el)"
       :aria-label="$store.<%= scoped_store %>.dialogLabel()"
       @keydown.tab.prevent="$store.<%= scoped_store %>.cycleFocus($el, $event)"
       @keydown.escape.window="$store.<%= scoped_store %>.current() && $store.<%= scoped_store %>.current().props.dismissible !== false && $store.<%= scoped_store %>.close()"
       @click.self="$store.<%= scoped_store %>.current() && $store.<%= scoped_store %>.current().props.dismissible !== false && $store.<%= scoped_store %>.close()">
    <div class="<%= card_class %> max-h-[85dvh] overflow-y-auto" :class="$store.<%= scoped_store %>.cardClasses()">
      <%# Consumer-provided registrations — one <template x-if> per modal id. %>
      <%= yield if block_given? %>
    </div>
  </div>
</template>
