<%# locals: (label:, delay:, size:, options: {}) %>
<%#
  The page-load overlay (Studio::LoaderHelper#studio_loader_overlay). Rendered
  hidden, once per page; studio/loader shows it when a Turbo visit or a form
  marked data-studio-loader-overlay outlasts data-delay ms, and
  window.StudioLoader.show(caption) / hide() drive it for any other long wait.
  The caption line is empty until a caller names one.
%>
<%= tag.div(class: "studio-loader-overlay", hidden: true, data: { studio_loader_overlay: "", delay: delay }) do %>
  <div class="studio-loader-overlay-panel">
    <%= studio_loader(size: size, label: label, **options) %>
    <p class="studio-loader-caption" data-studio-loader-caption></p>
  </div>
<% end %>
