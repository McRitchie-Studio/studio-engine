<%# "How to change your microphone in Chrome": a native modal <dialog> inside
    the microphone chip (studio/voice/_microphone_chip). showModal() makes the
    page behind it inert, so focus stays inside; Esc and Close shut it, and
    focus goes back where it was (studio/microphone_chip). It opens after a
    switch, on a refused microphone, on the second silent take in a row on one
    microphone, and from the picker's help link. The lead line on top says
    which; the browser decides between Chrome's steps and one generic line
    (browserFamily, studio/microphone). The picture is a drawn, simplified
    address bar, never a screenshot.

    Locals: copy (the chip's merged copy), title_id. %>
<% help = copy.fetch("help") %>
<dialog class="studio-mic-help" data-microphone-dialog aria-labelledby="<%= title_id %>">
  <div class="studio-mic-help-body">
    <div class="studio-mic-help-lead" data-microphone-help-lead hidden>
      <p class="studio-mic-help-headline" data-microphone-help-headline></p>
      <p class="studio-mic-help-tip" data-microphone-help-tip></p>
    </div>

    <h2 id="<%= title_id %>" class="studio-mic-help-title" data-microphone-help-title><%= help.fetch("title_chrome") %></h2>

    <div class="studio-mic-help-chrome" data-microphone-help-chrome>
      <svg class="studio-mic-mock" viewBox="0 0 320 168" role="img" aria-label="A drawing of Chrome's address bar: the site settings icon left of the address is circled, and below it the Microphone setting is on with its list of microphones.">
        <rect x="4" y="6" width="312" height="36" rx="18" class="mock-bar"/>
        <circle cx="26" cy="24" r="14" class="mock-ring"/>
        <g class="mock-ink" stroke-width="2" stroke-linecap="round">
          <line x1="19" y1="20" x2="33" y2="20"/><circle cx="23" cy="20" r="2.5" class="mock-knob"/>
          <line x1="19" y1="28" x2="33" y2="28"/><circle cx="29" cy="28" r="2.5" class="mock-knob"/>
        </g>
        <text x="48" y="29" class="mock-text" font-size="13"><%= request.host %></text>
        <rect x="12" y="54" width="232" height="106" rx="10" class="mock-panel"/>
        <g class="mock-ink" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <rect x="26" y="68" width="8" height="13" rx="4"/><path d="M23 77a7 7 0 0 0 14 0M30 84v4"/>
        </g>
        <text x="46" y="82" class="mock-text" font-size="13" font-weight="600">Microphone</text>
        <rect x="196" y="70" width="34" height="18" rx="9" class="mock-on"/>
        <circle cx="221" cy="79" r="6" class="mock-knob-on"/>
        <rect x="26" y="102" width="204" height="44" rx="8" class="mock-ring"/>
        <text x="38" y="129" class="mock-text" font-size="12">MacBook Pro Microphone</text>
        <path d="M212 120l5 5 5-5" class="mock-ink" stroke-width="2" fill="none" stroke-linecap="round"/>
        <g font-size="11" font-weight="700" text-anchor="middle">
          <circle cx="50" cy="8" r="8" class="mock-badge"/><text x="50" y="12" class="mock-badge-text">1</text>
          <circle cx="252" cy="70" r="8" class="mock-badge"/><text x="252" y="74" class="mock-badge-text">2</text>
          <circle cx="252" cy="118" r="8" class="mock-badge"/><text x="252" y="122" class="mock-badge-text">3</text>
        </g>
      </svg>
      <ol class="studio-mic-help-steps" data-microphone-help-steps>
        <% help.fetch("steps_chrome").each_with_index do |step, i| %>
          <li>
            <span class="studio-mic-step" aria-hidden="true"><%= i + 1 %></span>
            <span><%= step %></span>
          </li>
        <% end %>
      </ol>
    </div>

    <p class="studio-mic-help-other" data-microphone-help-other hidden><%= help.fetch("other") %></p>

    <form method="dialog" class="studio-mic-help-actions">
      <button type="submit" class="btn btn-primary studio-mic-help-close" data-microphone-help-close><%= help.fetch("close") %></button>
    </form>
  </div>
</dialog>
