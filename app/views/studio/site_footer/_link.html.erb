<%# One footer link (a normalized row from Studio::SiteFooter.link). A nil href
    is a disabled label. An off-site link opens in a new tab, so the visitor
    keeps the page. A booking link opens the booking popup when the app has a
    booking_url; its href stays as the fallback. %>
<% if link[:unlinked] %>
  <%# Its href was refused (not a relative path, http, https, mailto or tel). %>
  <span class="ftr-link-plain"><%= link[:label] %></span>
<% elsif link[:disabled] %>
  <span class="ftr-link-disabled" aria-disabled="true" title="Coming soon"><%= link[:label] %></span>
<% else %>
  <%# An email address or a URL as a label is one word however many hyphens and
      slashes it holds: .ftr-link-solid keeps it on one line. %>
  <%= link_to link[:label], link[:href], { class: Studio::SiteFooter.solid_label?(link[:label]) ? "ftr-link ftr-link-solid" : "ftr-link" }
        .merge(link[:external] ? { target: "_blank", rel: "noopener" } : {})
        .merge(link[:booking] && booking ? { data: { booking_popup: true, studio_booking: true } } : {}) %>
<% end %>
