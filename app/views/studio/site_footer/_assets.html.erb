<%# The site footer's styles. Rendered once per page, by
    `studio_site_footer_assets`.

    SCOPED CSS, NOT UTILITIES. Everything the footer needs to lay out is here,
    reading the theme's custom properties with a fallback beside each, so it
    renders the same in an app whose Tailwind build has never seen these views.

    NOTHING OF THE MAP. Its styles and its mount script are
    studio/site_footer/_map_assets, which only studio/site_footer/_map renders,
    so a footer with no address names no Leaflet anywhere on the page. %>
<style>
  .ftr { --ftr-primary: var(--color-primary, #8b5cf6); --ftr-primary-rgb: var(--color-primary-500-rgb, 139 92 246);
    --ftr-line: var(--color-border, rgb(127 127 127 / .25)); --ftr-ink: var(--color-text, inherit);
    --ftr-link-ink: var(--color-text-secondary, currentColor);
    background: var(--color-surface-alt, transparent); color: var(--color-text-body, inherit);
    border-top: 1px solid var(--ftr-line); }
  .ftr a { transition: color .15s ease; }
  .ftr-wrap { max-width: 72rem; margin-inline: auto; padding-inline: 1rem; }
  /* LINK INK. A link is painted in --ftr-link-ink at FULL opacity, never the
     inherited body colour faded: that read 4.5:1 or better only where the body
     ink happened to be dark enough, and failed in light mode for a consumer
     whose body ink is light. The default is the engine's --color-text-secondary,
     which ThemeResolver derives to clear WCAG AA 4.5:1 on every surface in both
     themes (--color-surface-alt, this band's background, among them). An app
     that maps the theme tokens onto its own palette sets --color-text-secondary
     to an ink that clears 4.5:1 on its --color-surface-alt, or sets
     --ftr-link-ink on .ftr directly (docs/SITE_FOOTER.md, "Colours").
     test/lib/site_footer_link_contrast_test.rb measures it. */
  .ftr-link { color: var(--ftr-link-ink); text-decoration: none; }
  /* A label that is an address (an email address, a URL) stays on one line: a browser
     would otherwise wrap it after a hyphen or a slash. Its track is at least as
     wide as it is (the grid below), and the tracks beside it give way. It is
     broken only on a screen narrower than any phone, where no layout holds it. */
  .ftr-link-solid { white-space: nowrap; }
  @media (max-width: 299px) { .ftr-link-solid { white-space: normal; overflow-wrap: anywhere; } }
  /* A refused href renders its label as text, in the link ink. */
  .ftr-link-plain { color: var(--ftr-link-ink); }
  /* A disabled label ("Coming soon") is faded on purpose: WCAG exempts an
     inactive control from the contrast minimum. */
  .ftr-link-disabled { color: var(--ftr-link-ink); opacity: .38; cursor: not-allowed; }
  .ftr-link:hover, .ftr-link:focus-visible { color: var(--ftr-primary); }

  /* Brand, then the link columns (.ftr-col), on a grid with explicit tracks.
       below 768px: the brand across the top, the link columns two to a row
       from 768px:  the brand across the top, every link column in one row
       from 1024px: the brand in that row too, at 1.7 shares
     A track is `Nfr`, never `minmax(0, Nfr)`: an fr track is at least as wide as
     its longest unbreakable word, so the column holding an email address grows
     to hold it and its neighbours give way. Nothing moves to another row.
     --ftr-tracks is one track per link column (Studio::SiteFooter.tracks): the
     first is wider by default, and a column's `width:` hint sets its own.
     A footer with more than four link columns (.ftr-cols-many) keeps the brand
     across the top and wraps the columns four to a row. */
  .ftr-cols { display: grid; gap: 3rem 2rem; padding-block: 4rem; grid-template-columns: 1.2fr 1fr; }
  .ftr-brand { grid-column: 1 / -1; }
  /* The smallest phones (320px): two columns still share a row beside an email
     address, by a narrower gutter and a slightly smaller address. */
  @media (max-width: 359px) {
    .ftr-cols { column-gap: 1rem; }
    .ftr-col .ftr-link-solid { font-size: .875rem; }
  }
  @media (min-width: 768px) {
    .ftr-cols { grid-template-columns: var(--ftr-tracks, 1fr); }
    .ftr-cols-many { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1024px) {
    .ftr-cols:not(.ftr-cols-many) { grid-template-columns: 1.7fr var(--ftr-tracks,); }
    .ftr-cols:not(.ftr-cols-many) .ftr-brand { grid-column: auto; }
  }
  .ftr-home { display: inline-flex; align-items: center; gap: .75rem; color: inherit; text-decoration: none; }
  .ftr-logo { width: 3rem; height: 3rem; object-fit: contain; }
  /* A dark mark on a light page: inverted in light mode, as drawn in dark. */
  .ftr-logo-invert { filter: invert(1); }
  .dark .ftr-logo-invert { filter: none; }
  .ftr-wordmark { font-size: 1.5rem; font-weight: 800; line-height: 1.25; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ftr-ink); }
  .ftr-wordmark span { display: block; }
  .ftr-wordmark-accent { color: var(--ftr-primary); }
  .ftr-tagline { margin: 1.5rem 0 0; line-height: 1.625; color: var(--color-text-secondary, inherit); }
  .ftr-email { margin: .75rem 0 0; }
  .ftr-socials { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .ftr-social { display: inline-flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem;
    border-radius: 9999px; background: var(--ftr-primary); color: #fff; transition: transform .15s ease, filter .15s ease; }
  a.ftr-social:hover { transform: translateY(-2px); filter: brightness(1.12); }
  .ftr-social[data-pending] { background: transparent; color: inherit; opacity: .5; border: 1px dashed currentColor; }
  .ftr-social-letter { font-weight: 700; font-size: .95rem; line-height: 1; }
  .ftr-heading { margin: 0 0 1rem; font-size: 1rem; font-weight: 700; color: var(--ftr-ink); }
  .ftr-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }

  .ftr-location { border-top: 1px solid var(--ftr-line); padding-block: 3.5rem 2rem; text-align: center; }
  .ftr-location-title { margin: 0; font-size: 1.875rem; line-height: 2.25rem; font-weight: 800; letter-spacing: -.025em; color: var(--ftr-ink); }
  .ftr-address { margin-top: 1rem; font-style: normal; line-height: 1.625; }
  .ftr-legal { padding-block: 2rem; text-align: center; font-size: .875rem; line-height: 1.25rem; }
  .ftr-legal p { margin: 0; }
  .ftr-legal .ftr-copyright { margin-top: .5rem; color: var(--color-text-muted, inherit); }
  /* With no map between them, a rule separates the legal line from what is above. */
  .ftr-legal-ruled { border-top: 1px solid var(--ftr-line); }

  @media (prefers-reduced-motion: reduce) { .ftr a, .ftr-social { transition: none; } }
</style>
