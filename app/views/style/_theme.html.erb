<%#  Theme section of the living style guide (admin/style) — the LANDING section.
     Theme owns "the colors": it leads with the role editor, which names each role's CSS
     variable and the derived tokens, with a live dark/light preview, then the logos, the semantic tokens and
     the type. GET /admin/theme redirects here.
     
     Save-in-place: this section intercepts Save + Regenerate and submits them via
     fetch, so the page never navigates away, the live preview stays put, and the
     outcome is a toast. The fetch asks for JSON and the controller answers it 204
     once it has written.
     The editor is studio/theme_editor's dsThemeEditor factory, which
     studio/alpine_shims publishes.

     Rendered in two contexts:
       * live in the host app (StyleController sets @theme_setting + @theme_defaults)
         so custom saved colors and the CSRF token are present.
       * in the guard test as a bare template (no controller, no DB) so every
         DB / request-scoped read is guarded and degrades to config defaults. %>
<%
  # Reference the model directly (guarded): in the minimal dummy app it may not
  # autoload, so fall back to the known role list + identity column mapping.
  roles = begin
    ThemeSetting::ROLES
  rescue StandardError
    %i[primary dark light success warning danger accent]
  end
  defaults = (Studio.respond_to?(:theme_config) ? Studio.theme_config : {}) || {}
  setting  = local_assigns[:theme_setting] || (@theme_setting if defined?(@theme_setting))

  db_col_for = ->(role) {
    begin
      ThemeSetting.db_column_for(role)
    rescue StandardError
      role
    end
  }

  current_hex = ->(role) {
    db_val = setting ? setting.read_attribute(db_col_for.call(role)) : nil
    (db_val.presence if db_val.respond_to?(:presence)) || defaults[role] || "#888888"
  }

  # Seed the live-preview editor with role -> hex, resolved from saved values.
  seed_colors = roles.index_with { |role| current_hex.call(role) }

  # Each role's CSS variable (there is no --color-heading or --color-primary var for a page to
  # paint with: cta and text are the semantic names). Dark and light are each theme's page.
  role_vars = { primary: "--color-cta", dark: "--color-page (dark)", light: "--color-page (light)", success: "--color-success",
                warning: "--color-warning", danger: "--color-danger", accent: "--color-accent" }

  # Not roles: Studio::ThemeResolver works these out from the roles, so they read here and
  # no one edits them.
  derived_tokens = [["Surface", "--color-surface"], ["Text", "--color-text"], ["Border (strong)", "--color-border-strong"]]

  csrf_ok = respond_to?(:protect_against_forgery?) && protect_against_forgery?
%>
<section id="theme" class="space-y-8" style="scroll-margin-top: calc(var(--nav-h, 0px) + 5rem)"
         x-data="dsThemeEditor(<%= seed_colors.to_json %>)">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <h2 class="type-h3 text-heading">Theme</h2>
      <p class="text-muted text-sm max-w-2xl">
        The color foundation. The 7-role system, editable here. Edits preview live; Save writes them
        and Regenerate clears the theme cache. Both persist <strong>in place</strong> — the page never
        leaves. Every specimen on this page restyles from these roles.
      </p>
    </div>
    <form action="/admin/theme/regenerate" method="post" accept-charset="UTF-8" @submit.prevent="regenerate($event)">
      <% if csrf_ok %>
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" autocomplete="off">
      <% end %>
      <button type="submit" class="btn btn-outline btn-sm" :disabled="saving">Regenerate cache</button>
    </form>
  </div>

  <%# THE LOGOS, first in the section. A host may supply its own block in
      app/views/style/host/_logos.html.erb, the same seam as host modals: the hub's has
      one-click PNG downloads, which draw through a script only the hub carries. %>
  <% if lookup_context.exists?("logos", ["style/host"], true) %>
    <%= render "style/host/logos" %>
  <% else %>
  <% logos = Studio.respond_to?(:theme_logos) ? Array(Studio.theme_logos) : [] %>
  <% if logos.any? %>
    <div class="space-y-3">
      <p class="label-upper">Logos</p>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-5">
        <% logos.each do |logo| %>
          <% file = logo.is_a?(Hash) ? logo[:file] : logo %>
          <% title = logo.is_a?(Hash) ? logo[:title] : file %>
          <div class="card p-4 space-y-3">
            <p class="text-sm text-heading font-medium"><%= title %></p>
            <div class="flex items-center justify-center w-20 h-20 rounded-lg" style="background-color: #ddd; background-image: linear-gradient(45deg, #777 25%, transparent 25%, transparent 75%, #777 75%), linear-gradient(45deg, #777 25%, transparent 25%, transparent 75%, #777 75%); background-size: 12px 12px; background-position: 0 0, 6px 6px;">
              <img src="/<%= file %>" alt="<%= title %>" class="max-w-16 max-h-16 rounded">
            </div>
            <code class="font-mono text-2xs text-muted break-all"><%= file %></code>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%# ---- Role-color editor (posts to /admin/theme, intercepted in place) - %>
    <form action="/admin/theme" method="post" accept-charset="UTF-8" class="card p-6 space-y-4"
          @submit.prevent="saveTheme($event)">
      <input type="hidden" name="_method" value="patch" autocomplete="off">
      <% if csrf_ok %>
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" autocomplete="off">
      <% end %>
      <h3 class="type-h4 text-heading">Role colors</h3>
      <p class="text-muted text-sm">Every specimen on this page reads these through its CSS variable, so it follows the app and its light or dark mode.</p>

      <% roles.each do |role| %>
        <% db_col = db_col_for.call(role) %>
        <% has_custom = setting && setting.read_attribute(db_col).present? %>
        <div class="flex items-center gap-4">
          <input type="color"
                 :value="colors.<%= role %>"
                 @input="colors.<%= role %> = $event.target.value; updatePreview()"
                 class="w-10 h-10 rounded cursor-pointer border border-subtle shrink-0"
                 style="padding: 1px"
                 aria-label="<%= role.to_s.titleize %> color">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-heading font-medium text-sm"><%= role.to_s.titleize %></span>
              <% if has_custom %><span class="text-xs text-muted">(custom)</span><% end %>
              <% if role_vars[role.to_sym] %><code class="font-mono text-2xs text-muted truncate"><%= role_vars[role.to_sym] %></code><% end %>
            </div>
            <input type="text"
                   name="theme_setting[<%= db_col %>]"
                   x-model="colors.<%= role %>"
                   @input="updatePreview()"
                   class="text-xs text-secondary font-mono bg-transparent border-0 border-b border-dashed border-subtle w-24 outline-none"
                   spellcheck="false">
          </div>
          <% if defaults[role] %>
            <button type="button" class="text-xs text-muted hover:text-heading transition shrink-0"
                    @click="colors.<%= role %> = '<%= defaults[role] %>'; updatePreview()"
                    title="Reset to default (<%= defaults[role] %>)">Reset</button>
          <% end %>
        </div>
      <% end %>

      <div class="pt-4 border-t border-subtle space-y-2" data-test="style-derived-tokens">
        <p class="label-upper">Derived, read only</p>
        <% derived_tokens.each do |label, var| %>
          <div class="flex items-center gap-4">
            <div class="w-10 h-6 rounded border border-subtle shrink-0" style="background: var(<%= var %>)"></div>
            <span class="text-heading font-medium text-sm"><%= label %></span>
            <code class="font-mono text-2xs text-muted truncate"><%= var %></code>
          </div>
        <% end %>
      </div>

      <div class="pt-4 border-t border-subtle">
        <button type="submit" class="btn btn-primary" :disabled="saving"
                x-text="saving ? 'Saving…' : 'Save theme'">Save theme</button>
      </div>
    </form>

    <%# The half beside the editor: Typography, then the live dark/light preview, which
        appears once a role color has been edited. %>
    <div class="space-y-6 min-w-0">
      <%= render "style/type_ladder" %>
    <div class="space-y-3" x-show="edited" x-cloak data-test="style-theme-preview">
      <p class="label-upper">Preview</p>
      <p class="text-muted text-sm">A live dark/light mock — it tracks the editor as you type, before you save.</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-subtle overflow-hidden">
          <div class="px-3 py-1.5 bg-surface-alt"><span class="text-2xs font-bold uppercase tracking-wider text-secondary">Dark</span></div>
          <div class="p-4" :style="{ backgroundColor: colors.dark }">
            <p class="font-bold text-sm mb-2" style="color: #ffffff">Heading</p>
            <div class="flex gap-2">
              <button type="button" class="rounded-lg px-2.5 py-1 text-2xs font-bold text-white" :style="{ backgroundColor: colors.primary }">Primary</button>
              <button type="button" class="rounded-lg px-2.5 py-1 text-2xs font-bold text-white" :style="{ backgroundColor: colors.success }">Accent</button>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-subtle overflow-hidden">
          <div class="px-3 py-1.5 bg-surface-alt"><span class="text-2xs font-bold uppercase tracking-wider text-secondary">Light</span></div>
          <div class="p-4" :style="{ backgroundColor: colors.light }">
            <p class="font-bold text-sm mb-2" style="color: #0f172a">Heading</p>
            <div class="flex gap-2">
              <button type="button" class="rounded-lg px-2.5 py-1 text-2xs font-bold text-white" :style="{ backgroundColor: colors.primary }">Primary</button>
              <button type="button" class="rounded-lg px-2.5 py-1 text-2xs font-bold text-white" :style="{ backgroundColor: colors.success }">Accent</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <%# Semantic tokens: the utilities a page paints with, under the role colours. %>
  <div class="space-y-3">
    <p class="label-upper">Semantic tokens</p>
    <div class="grid gap-3 grid-cols-2 md:grid-cols-5">
      <% [["Page", "bg-page", :bg], ["Surface", "bg-surface", :bg], ["Surface Alt", "bg-surface-alt", :bg], ["Inset", "bg-inset", :bg],
          ["Heading", "text-heading", :text], ["Body", "text-body", :text], ["Secondary", "text-secondary", :text], ["Muted", "text-muted", :text],
          ["Border", "border-subtle", :border], ["Border Strong", "border-strong", :border]].each do |name, utility, kind| %>
        <div class="card p-3 flex items-center gap-3">
          <% case kind
             when :bg %>
            <div class="w-8 h-8 rounded-full border border-subtle shrink-0 <%= utility %>"></div>
          <% when :text %>
            <div class="w-8 h-8 rounded-full border border-subtle shrink-0 bg-surface flex items-center justify-center">
              <span class="text-sm font-bold <%= utility %>">A</span>
            </div>
          <% else %>
            <div class="w-8 h-8 rounded-full shrink-0 border-2 bg-transparent <%= utility %>"></div>
          <% end %>
          <div class="min-w-0">
            <p class="text-heading text-sm font-semibold truncate"><%= name %></p>
            <code class="font-mono text-2xs text-muted truncate block"><%= utility %></code>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  </section>
