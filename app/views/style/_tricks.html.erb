<%#  Tricks section of the living style guide (admin/style). Buttons come first,
     then what you can add to a button, then the other primitives. Each specimen
     (the shared _specimen partial) shows the real engine class live, with its name
     and a usage snippet to copy.

     The Leveling group is gated by Studio.feature?(:leveling). With it off, its
     specimens render "disabled but present": visible, greyed and flagged, never hidden. %>
<%
  # Keyed by the WHOLE class, never "btn-" + a name: Tailwind compiles only the
  # @utility names it can read in source.
  button_variants = {
    "btn-primary"   => "Primary",
    "btn-secondary" => "Secondary",
    "btn-success"   => "Success",
    "btn-danger"    => "Danger",
    "btn-warning"   => "Warning",
    "btn-neutral"   => "Neutral",
    "btn-outline"   => "Outline",
    "btn-google"    => "Continue with Google"
  }

  leveling_on = Studio.feature?(:leveling)

  # An ERB snippet cannot be written literally inside an ERB template: the scanner
  # closes the tag at the first `%` + `>` it sees, whatever Ruby string it sits in.
  # So assemble the markers: the raw template never contains one.
  erb = ->(code) { "<" + "%= " + code + " %" + ">" }
  erb_end = "<" + "% end %" + ">"
%>
<section id="tricks" class="section-target space-y-12">
  <%= render "studio/section_header", title: "Tricks" %>
  <p class="text-muted text-sm max-w-2xl">Buttons first, then what you can add to them.</p>

  <!-- Buttons -->
  <section class="space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Buttons</h3>
      <p class="text-muted text-sm"><code class="font-mono text-2xs">.btn</code> plus one role and one size.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% button_variants.each do |name, label| %>
        <%= render layout: "style/specimen",
              locals: { klass: ".btn .#{name}",
                        usage: %(<button class="btn #{name}">#{label}</button>) } do %>
          <button type="button" class="btn <%= name %>"><%= label %></button>
        <% end %>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".btn-sm / .btn (default) / .btn-lg",
                      usage: %(<button class="btn btn-primary btn-sm">Small</button>\n<button class="btn btn-primary">Default</button>\n<button class="btn btn-primary btn-lg">Large</button>) } do %>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button type="button" class="btn btn-primary btn-sm">Small</button>
          <button type="button" class="btn btn-primary">Default</button>
          <button type="button" class="btn btn-primary btn-lg">Large</button>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Button tricks -->
  <section id="button-tricks" class="section-subtarget space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Button tricks</h3>
      <p class="text-muted text-sm">Add any of these to a <code class="font-mono text-2xs">.btn</code>.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%# The CARD shape: the button carries its own background and the ring still
          rings, because the primitive punches the host's box out of both wedge
          layers. The WRAPPER shape (bare host + opaque child) is staged by the
          Modals section's glow cards. engine-motion.css section 9b has both. %>
      <%= render layout: "style/specimen",
            locals: { klass: ".edge-rotate-glow  (knobs: --edge-rotate-glow-color / -color-b)",
                      note: "Adds a glow that rotates around the button's edge.",
                      usage: %(<button class="btn btn-primary edge-rotate-glow">Save</button>\n<button class="btn btn-primary edge-rotate-glow"\n        style="--edge-rotate-glow-color: #F08030; --edge-rotate-glow-color-b: #6890F0">Two colors</button>) } do %>
        <button type="button" class="btn btn-primary edge-rotate-glow">Save</button>
        <button type="button" class="btn btn-primary edge-rotate-glow"
                style="--edge-rotate-glow-color: #F08030; --edge-rotate-glow-color-b: #6890F0">Two colors</button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".studio-border-glow",
                      note: "Adds a moving rainbow border with a soft halo.",
                      usage: %(<button class="btn btn-primary studio-border-glow">Save</button>) } do %>
        <button type="button" class="btn btn-primary studio-border-glow">Save</button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".sheen .sheen--loop",
                      note: "Adds a band of light that sweeps across the button.",
                      usage: %(<button class="btn btn-primary sheen">Once</button>\n<button class="btn btn-primary sheen sheen--loop">Loop</button>) } do %>
        <button type="button" class="btn btn-primary sheen">Once</button>
        <button type="button" class="btn btn-primary sheen sheen--loop">Loop</button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".pulse-cta  (knobs: --pulse-cta-color / -speed / -scale)",
                      note: "Adds a slow beat with a ring that spreads from the edge.",
                      usage: %(<button class="btn btn-primary pulse-cta">Save</button>\n<button class="btn btn-success pulse-cta" style="--pulse-cta-color: var(--color-success)">Go</button>) } do %>
        <button type="button" class="btn btn-primary pulse-cta">Save</button>
        <button type="button" class="btn btn-success pulse-cta" style="--pulse-cta-color: var(--color-success)">Go</button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".fizz-stack  (studio/fizz)",
                      note: "Adds bubbles that rise from behind the button.",
                      usage: [erb.call(%(render layout: "studio/fizz", locals: { seed: "save" } do)),
                              %(  <button class="btn btn-primary">Save</button>),
                              erb_end].join("\n") } do %>
        <%= render layout: "studio/fizz", locals: { seed: "style-fizz" } do %>
          <button type="button" class="btn btn-primary">Save</button>
        <% end %>
        <%= render layout: "studio/fizz", locals: { seed: "style-fizz-colors", colors: %w[#8b5cf6 #8b5cf6 #8b5cf6 #22d3ee #22d3ee #22d3ee #f59e0b #f59e0b #f59e0b #ef4444 #ef4444 #ef4444 #10b981 #10b981 #10b981 #ec4899 #ec4899 #ec4899] } do %>
          <button type="button" class="btn btn-neutral">Six colors</button>
        <% end %>
      <% end %>

      <%# The live button: press and hold for two seconds. The card clips, so this one
          sets fizz_portal and its bubbles rise past the card's edge. %>
      <%= render layout: "style/specimen",
            locals: { klass: ".hold-btn  (studio/hold_button)",
                      note: "Makes the button confirm only after a two-second hold.",
                      usage: %(render "studio/hold_button", hold_id: "confirm", duration: 2000, fizz_portal: true) } do %>
        <div class="w-full max-w-xs" x-data="{ submitting: false }">
          <%= render "studio/hold_button", hold_id: "style-hold", duration: 2000, fizz_portal: true,
                default_text: "Hold to Confirm", hold_text: "Almost there…", success_text: "Confirmed!" %>
          <button type="button" class="btn btn-neutral btn-sm mt-3 mx-auto block"
                  @click="document.querySelector('.hold-btn[data-hold-id=style-hold]').classList.remove('process','success','error','loading')">Reset</button>
        </div>
      <% end %>

      <%# The same button, re-themed from an ancestor: no new CSS. %>
      <%= render layout: "style/specimen",
            locals: { klass: ".hold-btn  (--hold-* overrides)",
                      note: "Recolors a hold button from any parent element.",
                      usage: %(<div style="--hold-bg-from:#f0abfc;--hold-success-to:#4c1d95">…</div>) } do %>
        <div class="w-full max-w-xs" x-data="{ submitting: false }"
             style="--hold-bg-from:#f0abfc;--hold-bg-mid:#a855f7;--hold-bg-to:#6b21a8;
                    --hold-success-from:#c4b5fd;--hold-success-to:#4c1d95;--hold-success-glow-rgb:139 92 246">
          <%= render "studio/hold_button", hold_id: "style-hold-custom", duration: 2000,
                default_text: "Hold to Confirm", success_text: "Confirmed!",
                fizz_colors: %w[#f0abfc #6b21a8 #a855f7 #a5b4fc #312e81 #6366f1 #fbcfe8 #831843 #ec4899
                                #bae6fd #0c4a6e #0ea5e9 #ddd6fe #4c1d95 #8b5cf6 #fde68a #78350f #f59e0b] %>
          <button type="button" class="btn btn-neutral btn-sm mt-3 mx-auto block"
                  @click="document.querySelector('.hold-btn[data-hold-id=style-hold-custom]').classList.remove('process','success','error','loading')">Reset</button>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "window.studioConfetti.burst(el)",
                      note: "Fires confetti out from behind the button.",
                      usage: %(<button class="btn btn-primary" x-data @click="window.studioConfetti.burst($el)">Save</button>) } do %>
        <button type="button" class="btn btn-primary" x-data
                @click="window.studioConfetti && window.studioConfetti.burst($el)">Burst</button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "window.studioConfetti.cannons()",
                      note: "Fires confetti in from both sides of the screen.",
                      usage: %(<button class="btn btn-success" x-data @click="window.studioConfetti.cannons()">Done</button>) } do %>
        <button type="button" class="btn btn-success" x-data
                @click="window.studioConfetti && window.studioConfetti.cannons()">Cannons</button>
      <% end %>
    </div>
  </section>

  <!-- Page header -->
  <section class="space-y-5" data-page-header-specimen>
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Page header</h3>
      <p class="text-muted text-sm"><code class="font-mono text-2xs">studio/_page_header</code>: crumbs above the title, tabs on the right, other links under it; the open pill glides.</p>
    </div>
    <div class="grid gap-4 lg:grid-cols-2">
      <%# The classes alone, not the partial: the partial's row is sticky, joins the
          pinned stack and holds the page's h1, and a page has one of each. %>
      <% [["At rest", {}], ["Stuck", { stuck: "" }]].each do |state, data| %>
        <%= render layout: "style/specimen",
              locals: { klass: "studio/_page_header (#{state.downcase})",
                        usage: %(<%= render "studio/page_header",\n      title: "Models", meta: "v1.2.3", label: "Models",\n      crumbs: studio_crumbs(parent: :admin),\n      tabs: [{ label: "Users", href: users_path, current: "page" }, { label: "Teams", href: teams_path }],\n      links: [{ label: "Sessions", href: sessions_path }] %\>) } do %>
          <%= tag.div(class: "page-header w-full px-4", data: data) do %>
            <div class="page-header-trail">
              <nav class="page-header-crumbs" aria-label="Breadcrumb (specimen)">
                <ol>
                  <li><a href="#tricks" class="page-header-crumb">Admin</a></li>
                  <li><span class="page-header-crumb-current">Models</span></li>
                </ol>
              </nav>
              <a href="#tricks" class="page-header-parent"><span aria-hidden="true">&lsaquo;</span> Admin</a>
            </div>
            <div class="page-header-lead">
              <p class="page-header-title">Models</p>
              <p class="page-header-meta label-upper">v1.2.3</p>
            </div>
            <div class="page-header-tabs">
              <div class="page-header-track">
                <a href="#tricks" class="btn btn-sm btn-primary">Users</a>
                <a href="#tricks" class="btn btn-sm btn-neutral">Teams</a>
              </div>
            </div>
            <div class="page-header-links">
              <a href="#tricks" class="page-header-link">Sessions</a>
              <a href="#tricks" class="page-header-link">Invites</a>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Section header -->
  <section class="space-y-5" data-section-header-specimen>
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Section header</h3>
      <p class="text-muted text-sm">
        <code class="font-mono text-2xs">studio/_section_header</code>: a section's title that sticks under
        the page row until the next section's takes its place. This page's own section titles are these.
        The rule is in <code class="font-mono text-2xs">docs/PAGE_HEADER.md</code>.
      </p>
    </div>
    <div class="grid gap-4 lg:grid-cols-2">
      <%# The classes alone, not the partial: the partial's header sticks and joins the
          pinned stack, and a specimen must do neither. %>
      <% [["At rest", {}], ["Stuck", { stuck: "" }]].each do |state, data| %>
        <%= render layout: "style/specimen",
              locals: { klass: "studio/_section_header (#{state.downcase})",
                        usage: %(<section id="modals" class="section-target">\n  <%= render "studio/section_header", title: "Modals" %\>\n  ...\n</section>) } do %>
          <%= tag.p("Modals", class: "section-header px-4", data: data) %>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Surfaces, text and form -->
  <section class="space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Surfaces, text &amp; form</h3>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: ".card", usage: %(<div class="card p-5">...</div>) } do %>
        <div class="card p-5 text-sm text-body w-full max-w-xs text-center">Surface card</div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".card-hover", usage: %(<div class="card-hover p-5">...</div>) } do %>
        <div class="card-hover p-5 text-sm text-body w-full max-w-xs text-center">Hover me</div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".badge", usage: %(<span class="badge">Neutral</span>) } do %>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span class="badge text-body">Neutral</span>
          <span class="badge" style="color: var(--color-success-ink); border-color: var(--color-success)">Success</span>
          <span class="badge" style="color: var(--color-warning); border-color: var(--color-warning)">Warning</span>
          <span class="badge" style="color: var(--color-danger); border-color: var(--color-danger)">Danger</span>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".input-field", usage: %(<input class="input-field" placeholder="you@example.com">) } do %>
        <input type="text" class="input-field" placeholder="you@example.com" aria-label="Sample input">
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".label-upper", usage: %(<p class="label-upper">Section label</p>) } do %>
        <p class="label-upper">Section label</p>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".empty-state", usage: %(<div class="empty-state">Nothing here yet</div>) } do %>
        <div class="empty-state w-full max-w-xs text-sm text-muted">Nothing here yet</div>
      <% end %>
    </div>
  </section>

  <!-- Tints and shades: the scrim primitive -->
  <%= render "style/glass" %>

  <%= render "style/scrims" %>

  <!-- Time stamps: the "at" format -->
  <section class="space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Time stamps — the &ldquo;at&rdquo; format</h3>
      <p class="text-muted text-sm"><code class="font-mono text-2xs">at_time_tag</code> stamps when something happened, on the reader&rsquo;s own clock.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: "at_time_tag(time)",
                      usage: erb.call("at_time_tag(release.shipped_at)") } do %>
        <span class="text-sm text-body"><%= at_time_tag(Time.current) %></span>
      <% end %>

      <%# The date joins only when the stamp is not today — the rule is easiest to
          read as two specimens side by side. %>
      <%= render layout: "style/specimen",
            locals: { klass: "at_time_tag — not today",
                      usage: erb.call("at_time_tag(task.created_at)") + "\n# the date joins only when it is not today" } do %>
        <span class="text-sm text-body"><%= at_time_tag(3.days.ago) %></span>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "at_time_tag — another year",
                      usage: erb.call("at_time_tag(old_record.created_at)") + "\n# the year joins only when it differs" } do %>
        <span class="text-sm text-body"><%= at_time_tag(1.year.ago) %></span>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "at_time_tag(time, prefix: nil)",
                      usage: erb.call("at_time_tag(time, prefix: nil)") + %(\n# bare clock, for a cell that already says "at") } do %>
        <span class="text-sm text-body"><%= at_time_tag(Time.current, prefix: nil) %></span>
      <% end %>

      <%# STATIC ILLUSTRATION, not the primitive: a reader inside the US never sees
          the flag, so a live specimen cannot show them what it looks like. Hand-built
          to match the hydrated markup exactly (clock, then ml-2, then the flag). %>
      <%= render layout: "style/specimen",
            locals: { klass: "outside the US — the flag trails",
                      usage: %(# The flag is added CLIENT-side from the browser's IANA zone.\n# Inside the US there is no flag at all, and its margin collapses with it.) } do %>
        <div class="flex flex-col items-start gap-1.5 text-sm text-body">
          <span class="whitespace-nowrap"><span>at 6:50a</span><span class="ml-2">🇯🇵</span></span>
          <span class="whitespace-nowrap"><span>at 10:50p</span><span class="ml-2">🇬🇧</span></span>
          <span class="whitespace-nowrap"><span>at 9:50p</span><span class="ml-2">🌐</span></span>
          <span class="whitespace-nowrap text-muted"><span>at 4:50p</span></span>
        </div>
      <% end %>

      <%# The first caller's shape, so a host sees the primitive in a real pill
          rather than only as bare text. %>
      <%= render layout: "style/specimen",
            locals: { klass: "in a status badge",
                      usage: %(<span class="badge">Shipped ) + erb.call("at_time_tag(release.shipped_at)") + "</span>" } do %>
        <span class="badge" style="color: var(--color-success-ink); border-color: var(--color-success)">Shipped <%= at_time_tag(42.minutes.ago) %></span>
      <% end %>
    </div>
  </section>

  <!-- Branded loader -->
  <%
    loader_config = Studio.loader
    loader_art_styles = Studio::Loader::ART_STYLES.keys.select do |style|
      loader_config[:art] && Studio::Loader.art(loader_config[:art], style)
    end
  %>
  <section id="loader" class="section-subtarget space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Branded loader</h3>
      <p class="text-muted text-sm max-w-2xl">This app's icon in its theme colors, in the <strong><%= loader_config[:style].to_s.tr("_", " ") %></strong> style.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: ".studio-loader (this app's style)",
                      usage: [erb.call("studio_loader"), erb.call('studio_loader size: 20, label: "Saving"')].join("\n") } do %>
        <%= studio_loader %>
        <%= studio_loader size: 32 %>
        <%= studio_loader size: 20 %>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "studio_loader_pending (inside a busy button)",
                      usage: ["<button class=\"btn btn-primary\">", "  <span data-loader-idle>Save</span>", "  #{erb.call('studio_loader_pending')}", "</button>"].join("\n") } do %>
        <button type="button" class="btn btn-primary" aria-busy="true">
          <%= studio_loader_pending %><span class="ml-2">Saving…</span>
        </button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: "studio_loader_overlay (the page-load overlay)",
                      usage: ["#{erb.call('studio_loader_overlay')}  (once, in the layout body)", 'window.StudioLoader.show("Caption") / .hide()'].join("\n") } do %>
        <button type="button" class="btn btn-secondary" data-test="style-show-loader-overlay"
                x-data x-on:click="window.StudioLoader && window.StudioLoader.show('Loading your page…'); setTimeout(() => window.StudioLoader && window.StudioLoader.hide(), 3000)">
          Show the overlay for 3 seconds
        </button>
      <% end %>

      <% Studio::Loader::STYLES.each do |style| %>
        <% signature = Studio::Loader.art_style?(style) %>
        <% unavailable = signature && !loader_art_styles.include?(style) %>
        <%= render layout: "style/specimen",
              locals: { klass: %(style: :#{style}#{signature ? " (signature, needs art)" : ""}),
                        usage: %(config.loader = #{signature ? "{ style: :#{style}, art: \"/brand/loader-#{style}.svg\" }" : ":#{style}"}),
                        disabled: unavailable, disabled_label: "needs this app's art file" } do %>
          <%= studio_loader style: style, size: 72 %>
          <%= studio_loader style: style, size: 28 %>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Motion primitives -->
  <section class="space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Motion primitives</h3>
      <p class="text-muted text-sm">Tune any knob inline with <code class="font-mono text-2xs">style="--knob: value"</code>.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: ".spinner  (knob: --spinner-size)",
                      usage: %(<span class="spinner"></span>\n<span class="spinner" style="--spinner-size: 2rem"></span>) } do %>
        <span class="spinner"></span>
        <span class="spinner" style="--spinner-size: 1.6rem"></span>
        <span class="spinner" style="--spinner-size: 2.4rem; --spinner-thickness: 3px"></span>
        <button type="button" class="btn btn-primary">
          <span class="spinner" style="--spinner-color: currentColor; --spinner-track: rgba(255,255,255,.35)"></span>
          <span class="ml-2">Saving</span>
        </button>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".loading-dots  (3 span children)",
                      usage: %(<span class="loading-dots"><span></span><span></span><span></span></span>) } do %>
        <span class="loading-dots"><span></span><span></span><span></span></span>
        <span class="loading-dots" style="--loading-dots-size: 12px; --loading-dots-color: var(--color-cta)"><span></span><span></span><span></span></span>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".ping .ping--dot  (knob: --ping-color)",
                      usage: %(<span class="ping ping--dot"></span>) } do %>
        <span class="ping ping--dot"></span>
        <span class="ping ping--dot" style="--ping-color: var(--color-success)"></span>
        <span class="ping ping--dot" style="--ping-color: var(--color-danger); --ping-size: 0.9rem"></span>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".fade-edge-{t,b,l,r,x,y}  (knob: --fade-edge-size)",
                      usage: %(<div class="fade-edge-y overflow-y-auto">...long content...</div>) } do %>
        <div class="fade-edge-y overflow-y-auto h-32 w-full max-w-xs bg-surface rounded-lg p-3 text-sm text-body space-y-2">
          <p>Scroll me - the top and bottom edges dissolve.</p>
          <p>The mask softens content near either end of the container.</p>
          <p>No JavaScript, no gradient overlay - just a mask-image.</p>
          <p>It masks the element itself, so it works over any background.</p>
          <p>Keep scrolling to watch the fade track the edge.</p>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".progress-meter  (knob: --progress)",
                      usage: %(<div class="progress-meter" style="--progress: 62%">\n  <div class="progress-meter-track"><span class="progress-meter-label">62%</span></div>\n  <div class="progress-meter-fill"><span class="progress-meter-label">62%</span></div>\n</div>) } do %>
        <div class="w-full max-w-xs space-y-3">
          <div class="progress-meter" style="--progress: 25%">
            <div class="progress-meter-track"><span class="progress-meter-label">25%</span></div>
            <div class="progress-meter-fill"><span class="progress-meter-label">25%</span></div>
          </div>
          <div class="progress-meter" style="--progress: 62%">
            <div class="progress-meter-track"><span class="progress-meter-label">62%</span></div>
            <div class="progress-meter-fill"><span class="progress-meter-label">62%</span></div>
          </div>
          <div class="progress-meter" style="--progress: 88%; --progress-fill: var(--color-success)">
            <div class="progress-meter-track"><span class="progress-meter-label">88% complete</span></div>
            <div class="progress-meter-fill"><span class="progress-meter-label">88% complete</span></div>
          </div>
          <div class="progress-meter progress-meter--indeterminate">
            <div class="progress-meter-track"></div>
            <div class="progress-meter-fill"></div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Effects -->
  <section class="space-y-5">
    <div class="space-y-1">
      <h3 class="type-h4 text-heading">Effects</h3>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: ".text-gradient  (knobs: --text-gradient-from / -to / -angle)",
                      usage: %(<h2 class="text-gradient text-3xl font-extrabold">Level up</h2>) } do %>
        <div class="text-center space-y-2">
          <p class="text-gradient text-3xl font-extrabold">Level up</p>
          <p class="text-gradient text-xl font-bold" style="--text-gradient-from: var(--color-success); --text-gradient-to: var(--color-cta)">Season complete</p>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".studio-glow / .studio-glow--pulse  (knob: --studio-glow-color)",
                      usage: %(<button class="btn btn-primary studio-glow">Launch</button>) } do %>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <button type="button" class="btn btn-primary studio-glow">Launch</button>
          <span class="studio-glow studio-glow--pulse inline-flex h-12 w-12 items-center justify-center rounded-full text-white font-extrabold"
                style="background: var(--color-cta); --studio-glow-color: var(--color-success)">10</span>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".surface-glass  (knobs: --surface-glass-opacity / -blur)",
                      usage: %(<div class="surface-glass rounded-xl p-4">...</div>) } do %>
        <div class="conic-surface w-full max-w-xs rounded-2xl p-4" style="--conic-surface-duration: 22s">
          <div class="surface-glass rounded-xl p-4 text-center text-sm text-heading">Frosted panel over a live backdrop</div>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".conic-surface  (knob: --conic-surface-duration)",
                      usage: %(<div class="conic-surface rounded-2xl p-8">...</div>) } do %>
        <div class="conic-surface w-full max-w-xs rounded-2xl p-8 text-center">
          <p class="text-heading font-bold">Ambient wash</p>
          <p class="text-body text-xs mt-1">Content stays crisp above the rotating gradient.</p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Leveling (capability-gated: Studio.feature?(:leveling)) -->
  <section class="space-y-5">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="type-h4 text-heading">Leveling</h3>
        <% if leveling_on %>
          <span class="badge" style="color: var(--color-success-ink); border-color: var(--color-success)">enabled on this app</span>
        <% else %>
          <span class="badge" style="color: var(--color-warning); border-color: var(--color-warning)">disabled on this app</span>
        <% end %>
      </div>
      <p class="text-muted text-sm max-w-2xl">Level pills, gated by <code class="font-mono text-2xs">Studio.feature?(:leveling)</code>.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render layout: "style/specimen",
            locals: { klass: ".level-badge .level-badge-1 … .level-badge-10",
                      disabled: !leveling_on,
                      usage: %(<span class="level-badge level-badge-10">Level 10</span>) } do %>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <% (1..10).each do |lvl| %>
            <span class="level-badge level-badge-<%= lvl %>">Level <%= lvl %></span>
          <% end %>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".level-badge (in a chip context)",
                      disabled: !leveling_on,
                      usage: %(<span class="text-heading font-semibold text-sm">Earn a free entry</span>\n<span class="level-badge level-badge-8">Level 8</span>) } do %>
        <div class="w-full max-w-xs space-y-2">
          <div class="card flex items-center justify-between gap-3 px-3 py-2">
            <span class="text-heading font-semibold text-sm">Earn a free entry</span>
            <span class="level-badge level-badge-8">Level 8</span>
          </div>
          <div class="card flex items-center justify-between gap-3 px-3 py-2">
            <span class="text-heading font-semibold text-sm">Legendary status</span>
            <span class="level-badge level-badge-10">Level 10</span>
          </div>
        </div>
      <% end %>

      <%= render layout: "style/specimen",
            locals: { klass: ".level-up-pop  (fires the pop + glow burst)",
                      disabled: !leveling_on,
                      usage: %(<span class="level-badge level-badge-10 level-up-pop">Level 10</span>) } do %>
        <div x-data="{ pop: true }" class="flex flex-col items-center gap-3 py-2">
          <span class="level-badge level-badge-10" :class="pop && 'level-up-pop'">Level 10</span>
          <button type="button" class="btn btn-neutral btn-sm"
                  @click="pop=false; setTimeout(() => pop=true, 30)">Replay pop</button>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Site footer and booking -->
  <%= render "style/site_footer" %>
</section>
