<%#  Tasks section of the living style guide (admin/style).

     The shared board primitive, LIVE. Phase D lifted the columns / cards / drag +
     optimistic move / reorder that the three near-identical McRitchie Studio boards
     (tasks / news / content) each hand-rolled into one engine primitive
     (studio/board/_board + the window.studioBoard factory + vendored SortableJS).
     The first block below renders that real primitive with `demo: true` — you can
     DRAG a card between columns and the move animates + toasts, but nothing POSTs.
     The blocks under it stay a static reference: the stage-* badge palette
     (components/_badge) that is the pipeline spine, and the standard-vs-custom
     split of what a board inherits vs sets. %>
<%
  # LIVE specimen — the real studio/board/_board primitive, demo mode. Plain Hash
  # records (the style guide has no models); each card id becomes id="card-<id>".
  # Each demo card carries its current `zone` (the column it sits in) — in a real
  # board the record knows its own stage; here the Hash does.
  live_board_columns = [
    { key: "designed",  label: "Designed",  badge_class: "stage-fresh",
      cards: [
        { id: "engine-board-primitive", zone: "designed", title: "Engine board primitive", repo: "studio-engine", who: "SH" },
        { id: "coinflow-buy-rail",      zone: "designed", title: "Coinflow buy rail",      repo: "turf-monster",  who: "JA" }
      ] },
    { key: "building",  label: "Building",  badge_class: "stage-shaping",
      cards: [{ id: "navbar-rpc-preload", zone: "building", title: "Navbar RPC preload", repo: "turf-monster", who: "CA" }] },
    { key: "submitted", label: "Submitted", badge_class: "stage-structured",
      cards: [{ id: "magic-link-ttl-bump", zone: "submitted", title: "Magic-link TTL bump", repo: "studio-engine", who: "SH" }] },
    { key: "shipped",   label: "Shipped",   badge_class: "stage-shipped",
      cards: [{ id: "ses-email-backend", zone: "shipped", title: "SES email backend", repo: "mcritchie", who: "ST" }] }
  ]

  # Copy-paste-for-an-agent usage. Built by array-join, NOT a heredoc: a heredoc as
  # the last expression of an ERB scriptlet trips Erubi, and literal ERB tags in the
  # body would close the tag. Plain render() calls read clearly for an agent.
  board_usage_snippet = [
    "# once at layout level (a <script> in the board template never runs):",
    'render "studio/board_assets"',
    "",
    "# then the board itself:",
    'render "studio/board/board",',
    "  columns: @columns,            # [{ key:, label:, cards:, badge_class: }]",
    '  card_partial: "tasks/task_card",',
    "  reorder_url: tasks_reorder_path,        # POST { slugs: [...], zone: }",
    '  move_url: "/tasks/:id.json",            # PATCH { task: { stage: } }',
    '  move_param: { resource: "task", attr: "stage" },',
    '  live_channel: "deployments"'
  ].join("\n")

  # The static reference palette below (unchanged): each column maps to a stage-*
  # badge scheme.
  board_columns = [
    { key: "stage-fresh",      label: "Fresh",      count: 2 },
    { key: "stage-shaping",    label: "Shaping",    count: 1 },
    { key: "stage-structured", label: "Structured", count: 1 },
    { key: "stage-refined",    label: "Refined",    count: 1 },
    { key: "stage-shipped",    label: "Shipped",    count: 1 }
  ]

  demo_cards = {
    "stage-fresh" => [
      { title: "Expand design system page", repo: "studio-engine", who: "SH" },
      { title: "Coinflow buy rail",         repo: "turf-monster",  who: "JA" }
    ],
    "stage-shaping"    => [{ title: "Navbar RPC preload",   repo: "turf-monster",  who: "CA" }],
    "stage-structured" => [{ title: "Magic-link TTL bump",  repo: "studio-engine", who: "SH" }],
    "stage-refined"    => [{ title: "Release ticker card",  repo: "mcritchie",     who: "AV" }],
    "stage-shipped"    => [{ title: "SES email backend",    repo: "mcritchie",     who: "ST" }]
  }
%>
<section id="tasks" class="space-y-8" style="scroll-margin-top: calc(var(--nav-h, 0px) + 5rem)">
  <div class="space-y-1">
    <h2 class="text-2xl font-bold text-heading">Tasks</h2>
    <p class="text-muted text-sm max-w-2xl">
      The shared board primitive that every board builds from &mdash; columns, cards, the
      <code class="font-mono text-2xs">stage-*</code> badge palette, and the drag / optimistic
      move + reorder. McRitchie Studio's <code class="font-mono text-2xs">/deployments</code> board is
      the top-of-line; the specimen below is the <strong>real</strong>
      <code class="font-mono text-2xs">studio/board/board</code> primitive in
      <code class="font-mono text-2xs">demo: true</code> mode &mdash; drag a card, no save.
    </p>
  </div>

  <%# ---- The LIVE primitive (demo mode) --------------------------------- %>
  <%# Render the factory once (a <script> in the board template would never run), then
      the board. demo: true → drag animates + toasts locally, nothing POSTs. %>
  <%= render "studio/board_assets" %>
  <div class="space-y-3">
    <div class="flex items-center gap-2">
      <span class="badge" style="color: var(--color-success); border-color: var(--color-success)">Live</span>
      <p class="label-upper"><code class="font-mono text-2xs">studio/board/board</code> &middot; demo &mdash; drag a card between columns</p>
    </div>
    <%= render "studio/board/board",
          demo: true,
          columns: live_board_columns,
          card_partial: "style/board/demo_card",
          card_as: :card,
          reorder_url: "#",
          move_url: "#",
          move_param: { resource: "task", attr: "stage" },
          group: "studio-board-demo",
          empty_label: "Drop tasks here" %>
    <div class="relative" x-data="{ copied: false }">
      <pre class="bg-inset text-body text-2xs rounded-lg px-3 py-2 pr-16 overflow-x-auto"><code x-ref="boardUsage"><%= board_usage_snippet %></code></pre>
      <button type="button"
              class="btn btn-neutral btn-sm absolute top-2 right-2"
              aria-label="Copy usage snippet"
              @click="navigator.clipboard?.writeText($refs.boardUsage.innerText); copied = true; setTimeout(() => copied = false, 1200)">
        <span x-text="copied ? 'Copied' : 'Copy'">Copy</span>
      </button>
    </div>
  </div>

  <%# ---- The ENRICHED board chrome (0.28.0) ------------------------------ %>
  <%# One specimen that exercises the five additive hooks the /tasks pilot surfaced,
      all opt-in: (1) board_state + header_slot chrome home, (2) a coloured count
      chip via count_class, (3) archive_zone exit re-parent, (4) the exit marker,
      (5) a toggle-able column (show_expr) + a per-column kickoff slot + min_width.
      No outer Alpine wrapper: the Show/Hide-archived toggle in header_slot and the
      archived column's show_expr both bind to the SAME studioBoard state. %>
  <% chrome_header = capture do %>
    <div class="flex items-center gap-3 flex-wrap">
      <button type="button"
              class="px-3 py-1.5 rounded-lg text-sm font-medium transition border border-subtle"
              :class="state.showArchived ? 'bg-primary text-white border-primary' : 'bg-surface text-secondary hover:text-heading'"
              @click="toggleState('showArchived')"
              data-test="chrome-archived-toggle">
        <span x-text="state.showArchived ? 'Hide archived' : 'Show archived'">Show archived</span>
      </button>
      <span class="label-upper"><code class="font-mono text-2xs">header_slot</code> chrome &middot; binds to <code class="font-mono text-2xs">state.showArchived</code> &mdash; no outer wrapper</span>
    </div>
  <% end %>
  <% chrome_kickoff = capture do %>
    <span class="inline-flex items-center gap-1 rounded border border-primary/30 bg-primary/10 px-1.5 py-0.5 text-2xs font-semibold uppercase tracking-wide text-primary">kickoff slot</span>
  <% end %>
  <%
    # Per-column count_class colours (raw classes, the task_stage_count_classes shape),
    # a kickoff chip + widened min_width on Designed, and a toggle-able Archived column
    # (show_expr) the board re-parents into (archive_zone).
    chrome_columns = [
      { key: "designed", label: "Designed",
        count_class: "bg-blue-500/10 text-blue-500 border border-blue-500/30",
        kickoff: chrome_kickoff, min_width: "sm:min-w-[15rem]",
        cards: [{ id: "chrome-count-color", zone: "designed", title: "Coloured count chip", repo: "studio-engine", who: "SH" }] },
      { key: "building", label: "Building",
        count_class: "bg-yellow-500/10 text-yellow-400 border border-yellow-500/30",
        cards: [{ id: "chrome-bindable-col", zone: "building", title: "Bindable columns", repo: "turf-monster", who: "CA" }] },
      { key: "shipped", label: "Shipped",
        count_class: "bg-emerald-500/10 text-emerald-500 border border-emerald-500/30",
        cards: [{ id: "chrome-exit-marker", zone: "shipped", title: "Exit re-parent marker", repo: "mcritchie", who: "ST" }] },
      { key: "archived", label: "Archived",
        count_class: "bg-gray-500/10 text-gray-400 border border-gray-500/30",
        show_expr: "state.showArchived",
        cards: [{ id: "chrome-archived-card", zone: "archived", title: "Archived (re-parent target)", repo: "mcritchie", who: "ST" }] }
    ]
  %>
  <div class="space-y-3">
    <div class="flex items-center gap-2">
      <span class="badge" style="color: var(--color-primary); border-color: var(--color-primary)">Enriched</span>
      <p class="label-upper"><code class="font-mono text-2xs">studio/board/board</code> &middot; 0.28.0 chrome &mdash; coloured counts, toggle-able column, archive re-parent</p>
    </div>
    <%= render "studio/board/board",
          demo: true,
          columns: chrome_columns,
          card_partial: "style/board/demo_card",
          card_as: :card,
          reorder_url: "#",
          move_url: "#",
          move_param: { resource: "task", attr: "stage" },
          group: "studio-board-chrome",
          board_state: { showArchived: false },
          archive_zone: "archived",
          header_slot: chrome_header,
          empty_label: "Drop tasks here" %>
  </div>

  <%# ---- The DEPTH-CHART shape (0.29.0 / DG) ----------------------------- %>
  <%# The two-level side→position GRID + per-card lock the depth chart needs, all
      additive: groups: renders labelled sections (Offense/Defense) whose position
      lanes lay out in a grid (not the flat row); group: false keeps a drag WITHIN
      its lane; zone_attr "position" is the lane; 🔒 starters carry `locked: true`
      so the factory filters them from dragging (locked_selector) and a drag can't
      cross them. reorder is 1..N (depth) — demonstrated statically here (demo). %>
  <%
    dc_groups = [
      { key: "offense", label: "Offense", cols_class: "grid-cols-2 sm:grid-cols-3",
        columns: [
          { key: "QB", label: "QB", cards: [
            { id: "dc-qb1", zone: "QB", title: "Starter QB", repo: "depth 1", who: "1", locked: true },
            { id: "dc-qb2", zone: "QB", title: "Backup QB",  repo: "depth 2", who: "2" },
            { id: "dc-qb3", zone: "QB", title: "3rd string", repo: "depth 3", who: "3" } ] },
          { key: "RB", label: "RB", cards: [
            { id: "dc-rb1", zone: "RB", title: "RB1", repo: "depth 1", who: "1" },
            { id: "dc-rb2", zone: "RB", title: "RB2", repo: "depth 2", who: "2" } ] },
          { key: "WR", label: "WR", cards: [
            { id: "dc-wr1", zone: "WR", title: "WR1", repo: "depth 1", who: "1" } ] } ] },
      { key: "defense", label: "Defense", cols_class: "grid-cols-2 sm:grid-cols-3",
        columns: [
          { key: "EDGE", label: "EDGE", cards: [
            { id: "dc-edge1", zone: "EDGE", title: "EDGE1", repo: "depth 1", who: "1" },
            { id: "dc-edge2", zone: "EDGE", title: "EDGE2", repo: "depth 2", who: "2" } ] },
          { key: "CB", label: "CB", cards: [
            { id: "dc-cb1", zone: "CB", title: "Starter CB", repo: "depth 1", who: "1", locked: true },
            { id: "dc-cb2", zone: "CB", title: "CB2",        repo: "depth 2", who: "2" } ] } ] }
    ]
  %>
  <div class="space-y-3">
    <div class="flex items-center gap-2">
      <span class="badge" style="color: var(--color-warning); border-color: var(--color-warning)">Grid + Lock</span>
      <p class="label-upper"><code class="font-mono text-2xs">studio/board/board</code> &middot; DG (0.29.0) &mdash; two-level side&rarr;position grid, reorder within a lane, &#128274; pinned starters stay put</p>
    </div>
    <%= render "studio/board/board",
          demo: true,
          groups: dc_groups,
          card_partial: "style/board/demo_card",
          card_as: :card,
          reorder_url: "#",
          group: false,
          zone_attr: "position",
          locked_selector: ".kanban-locked",
          card_locals: { zone_attr: "position" },
          empty_label: "&mdash;".html_safe %>
  </div>

  <%# ---- The static reference sketch ------------------------------------- %>
  <div class="fade-edge-x overflow-x-auto pb-2">
    <div class="flex gap-4 min-w-max">
      <% board_columns.each do |col| %>
        <div class="w-56 flex-none" data-stage="<%= col[:key] %>">
          <div class="mb-3 px-1 flex items-center gap-2">
            <h3 class="text-sm font-bold text-heading uppercase tracking-wider"><%= col[:label] %></h3>
            <%= render "components/badge", text: col[:count].to_s, scheme: col[:key] %>
          </div>
          <div class="rounded-xl border-2 border-dashed border-subtle min-h-40 p-2 space-y-2">
            <% (demo_cards[col[:key]] || []).each do |c| %>
              <div class="card p-3 space-y-2 cursor-grab active:cursor-grabbing" draggable="true">
                <div class="flex items-start gap-2">
                  <span class="text-muted select-none leading-none" aria-hidden="true">⠿</span>
                  <p class="text-sm font-semibold text-heading leading-snug flex-1"><%= c[:title] %></p>
                </div>
                <div class="flex items-center justify-between gap-2">
                  <%= render "components/badge", text: c[:repo], scheme: "neutral" %>
                  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-2xs font-bold text-white shrink-0" style="background: var(--color-cta)"><%= c[:who] %></span>
                </div>
              </div>
            <% end %>
            <div class="flex items-center justify-center h-16 text-muted text-xs">Drop tasks here</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---- The stage palette ---------------------------------------------- %>
  <div class="space-y-3">
    <p class="label-upper">Stage palette — the pipeline spine</p>
    <div class="flex flex-wrap gap-2">
      <% %w[stage-fresh stage-shaping stage-structured stage-refined stage-cohered stage-shipped stage-closed].each do |stage| %>
        <span data-stage="<%= stage %>"><%= render "components/badge", text: stage.sub("stage-", ""), scheme: stage %></span>
      <% end %>
    </div>
    <p class="text-muted text-xs">
      Seven stage roles from <code class="font-mono text-2xs">components/_badge</code>. Every pipeline
      (tasks, deployments, and any future board) draws its columns from this one palette, so a card
      reads the same wherever it lives.
    </p>
  </div>

  <%# ---- Standard vs custom -------------------------------------------- %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="card p-5 space-y-2">
      <div class="flex items-center gap-2">
        <span class="badge" style="color: var(--color-success); border-color: var(--color-success)">Shared</span>
        <p class="text-heading font-semibold text-sm">What every board inherits</p>
      </div>
      <ul class="text-secondary text-sm space-y-1 list-disc list-inside">
        <li>Column layout + horizontal scroll with faded edges</li>
        <li>The <code class="font-mono text-2xs">stage-*</code> badge palette + count chips (colour via <code class="font-mono text-2xs">count_class</code>)</li>
        <li>Card chrome (<code class="font-mono text-2xs">.card</code>) and the drag / rank handle</li>
        <li>Empty-column drop state</li>
        <li>Chrome-state home (<code class="font-mono text-2xs">board_state</code> + <code class="font-mono text-2xs">header_slot</code>) &mdash; filters/toggles without an outer wrapper</li>
        <li>Toggle-able columns (<code class="font-mono text-2xs">show_expr</code>), a kickoff slot, and archive re-parent (<code class="font-mono text-2xs">archive_zone</code>)</li>
      </ul>
    </div>
    <div class="card p-5 space-y-2">
      <div class="flex items-center gap-2">
        <span class="badge" style="color: var(--color-warning); border-color: var(--color-warning)">Custom</span>
        <p class="text-heading font-semibold text-sm">What each board sets</p>
      </div>
      <ul class="text-secondary text-sm space-y-1 list-disc list-inside">
        <li>Which stages become columns</li>
        <li>The card body — fields, chips, avatars, live timers</li>
        <li>Filter/toggle logic + header actions, composed onto the shared chrome state</li>
        <li>Live-update wiring (Turbo Streams on the deploy board)</li>
      </ul>
    </div>
  </div>
</section>
