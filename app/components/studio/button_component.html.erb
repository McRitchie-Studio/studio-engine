<%= content_tag(link? ? :a : :button, **element_attributes) do %><% if pending_loader? %><%= studio_loader_pending(style: :spinner, size: 16) %><% end %><% if icon? %><span class="inline-flex shrink-0" aria-hidden="true" data-loader-idle><%= icon %></span><% end %><% if busy_label.present? && !link? %><span data-loader-idle><%= text %></span><span data-loader-busy><%= busy_label %></span><% else %><span><%= text %></span><% end %><% end %>
