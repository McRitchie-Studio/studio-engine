<%# studio/_carousel, rendered by name (E2eLabController#carousel). The slides are the
    host's blocks; the region, track, controls and controller are the engine's. %>
<main class="max-w-5xl mx-auto px-4 py-10 space-y-12">
  <%= render layout: "studio/carousel",
        locals: { label: "Apps", items: (1..9).to_a, per_view: 3, data: { lab: "apps" } } do |n| %>
    <a href="#app-<%= n %>" class="card-hover block h-full p-5" data-lab-card="<%= n %>">
      <span class="block font-semibold text-heading">App <%= n %></span>
      <span class="block text-sm text-muted">One line of what it is.</span>
    </a>
  <% end %>

  <%= render layout: "studio/carousel",
        locals: { label: "Quotes", items: %w[One Two Three Four Five], per_view: 2,
                  slide_label: ->(word) { "Quote #{word}" }, data: { lab: "quotes" } } do |word| %>
    <div class="card h-full p-5 text-body"><%= word %></div>
  <% end %>

  <%= render layout: "studio/carousel",
        locals: { label: "Pair", items: %w[Left Right], per_view: 3, data: { lab: "pair" } } do |word| %>
    <div class="card h-full p-5 text-body"><%= word %></div>
  <% end %>
  <%# Widgets that own the arrow keys, and a carousel nested in a slide: a key
      pressed in any of them is theirs, so this row never moves for it. %>
  <%= render layout: "studio/carousel",
        locals: { label: "Widgets", items: %w[slider tabs nested four five], per_view: 2,
                  data: { lab: "widgets" } } do |kind| %>
    <div class="card h-full p-5 text-body">
      <% case kind
         when "slider" %>
        <div role="slider" tabindex="0" aria-label="Volume" aria-valuemin="0" aria-valuemax="10"
             aria-valuenow="5" data-lab-widget="slider">Volume 5</div>
      <% when "tabs" %>
        <div role="tablist" aria-label="Views">
          <button type="button" role="tab" aria-selected="true" data-lab-widget="tab">One</button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1">Two</button>
        </div>
      <% when "nested" %>
        <%= render layout: "studio/carousel",
              locals: { label: "Inner", items: %w[A B C D], per_view: 1, data: { lab: "inner" } } do |letter| %>
          <div class="card h-full p-3 text-body"><%= letter %></div>
        <% end %>
      <% else %>
        <%= kind %>
      <% end %>
    </div>
  <% end %>
</main>
