<%# A PANEL SLIDING OUT WHEN TURBO TAKES ITS SNAPSHOT (e2e/sidebar_turbo_snapshot.spec.js).

    Both panels are the engine's own partial: the link sidebar, and a host's panel
    with a link inside it that closes the panel on its own @click, the way a host
    writes one. `lab-fade` is the other x-transition shape: x-transition.opacity,
    which writes inline style and names no class. `lab-rest-class` on the host panel
    is a class the panel keeps at rest, so a spec can hold the cleanup to the
    classes the transition named. %>
<main class="p-8" x-data="{ hostOpen: false, fadeOpen: false }" data-test="lab-page" data-lab-page="<%= @lab_page %>">
  <p data-test="lab-body">sidebar snapshot lab, page <%= @lab_page %></p>

  <button type="button" class="rounded border border-subtle px-3 py-2 text-sm"
          data-test="open-host-panel" @click="hostOpen = true">Open host panel</button>
  <button type="button" class="rounded border border-subtle px-3 py-2 text-sm"
          data-test="toggle-fade" @click="fadeOpen = !fadeOpen">Toggle fade</button>
  <div x-show="fadeOpen" x-cloak x-transition.opacity.duration.3000ms data-test="lab-fade">fading</div>

  <%= render "components/link_sidebar_trigger" %>
  <%= render "components/link_sidebar" %>

  <% host_body = capture do %>
    <div class="flex-1 overflow-y-auto p-4">
      <%= link_to "Other page", @lab_other_url, "@click": "hostOpen = false", data: { test: "host-panel-link" } %>
    </div>
  <% end %>
  <%= render "components/sidebar_panel",
        id: "lab-host-panel",
        title: "Host Panel",
        open: "hostOpen",
        close_action: "hostOpen = false",
        display_class: "flex",
        panel_class: "lab-rest-class",
        body_html: host_body %>
</main>
