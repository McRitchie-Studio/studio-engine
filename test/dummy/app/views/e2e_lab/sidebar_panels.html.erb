<%# TWO SIDEBARS ON ONE PAGE — the shape that broke.

    components/_sidebar_panel is shared: the link sidebar renders through it, and so
    does any host panel. Every panel it renders stamps its close button
    data-link-sidebar-close, and the link sidebar's own click bridge claims that
    attribute in the CAPTURE phase. Unscoped, it claimed the HOST panel's × too —
    stopImmediatePropagation before that panel's own @click could run — so the ×
    silently did nothing and this sidebar closed instead.

    Neither panel is hand-rolled here: both are the engine's own partial, and the
    bridge under test lives inside components/_link_sidebar. The page only supplies
    locals and the Alpine scope a host supplies — `hostOpen` is this page standing in
    for a host's own open/closed state. %>
<main class="p-8" x-data="{ hostOpen: false }">
  <p data-test="lab-body">sidebar panels lab</p>

  <% if params[:busy] == "photo" %>
    <%# A photo behind the panel, which shows a line in the blur that small text hides. %>
    <div class="fixed inset-0 -z-10 bg-cover bg-center" style="background-image: url('/e2e/img/lab-photo.avif')" data-test="lab-photo"></div>
  <% elsif params[:busy].present? %>
    <%# A busy page behind the panel, standing in for a board: small text and hard
        edges, which is what a blur has to separate the panel from. %>
    <button type="button" class="rounded border border-subtle px-3 py-2 text-sm" data-test="lab-theme"
            @click="document.documentElement.classList.toggle('dark')">Light or dark</button>
    <div class="fixed inset-x-0 bottom-0 top-40 -z-10 grid grid-cols-12 gap-2 overflow-hidden p-2" data-test="lab-busy">
      <% 144.times do |index| %>
        <a href="#busy-<%= index %>" class="rounded border border-strong bg-surface-alt p-2 text-xs text-heading" data-test="lab-busy-card">
          Task <%= index %> <span class="<%= index.even? ? "text-primary" : "text-muted" %>">fix the row and ship it</span>
        </a>
      <% end %>
    </div>
  <% end %>

  <button type="button"
          class="rounded border border-subtle px-3 py-2 text-sm"
          data-test="open-host-panel"
          @click="hostOpen = true">Open host panel</button>

  <%= render "components/link_sidebar_trigger" %>
  <%= render "components/link_sidebar", sidebar_style: (:glass if params[:glass].present?) %>

  <% host_body = capture do %>
    <div class="flex-1 overflow-y-auto p-4">
      <p data-test="host-panel-body">a host's own panel</p>
    </div>
  <% end %>
  <%= render "components/sidebar_panel",
        id: "lab-host-panel",
        title: "Host Panel",
        open: "hostOpen",
        close_action: "hostOpen = false",
        escape_action: "hostOpen = false",
        display_class: "flex",
        body_html: host_body %>
</main>
