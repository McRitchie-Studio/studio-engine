<%# studio/_carousel, style: :cascade, rendered by name (E2eLabController#carousel_cascade).
    e2e/carousel_cascade.spec.js. Seven captioned cards, each a link with a test hook:
    "cascade" takes the cascade's defaults (five in view, the middle card open);
    "cascade-three" shows three (visible: 3) from its first card (start: 0);
    "cascade-loop" loops (loop: true) from its first card, so the last two sit on
    its left, and autoplays only when asked (?autoplay=1, one second);
    "cascade-five" loops five cards, all five in view, so every move takes one
    card round the seam; "cascade-portfolio" is the image-only pattern (the hub
    Portfolio): each card is only its picture, the row draws no dots (dots: false),
    the open card wears a ring, and one caption under the stack follows the open
    card on the carousel's change event (studio:carousel:change); each card has an
    id (portfolio-app-<n>), so a #fragment opens the row on it. "scoped" is a
    caption wrapper holding two rows: the captions follow the first ("scoped"),
    never the second ("scoped-other").
    window.__carouselChanges logs every change event on the page. %>
<% cards = (1..7).to_a %>
<% picture = lambda do |n| %>
  <% svg = %(<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(#{n * 47} 70% 55%)"/><stop offset="1" stop-color="hsl(#{n * 47 + 60} 70% 32%)"/></linearGradient></defs><rect width="400" height="300" fill="url(#g)"/></svg>) %>
  <%= "data:image/svg+xml,#{ERB::Util.url_encode(svg)}" %>
<% end %>
<% card = lambda do |n, prefix| %>
  <a href="#<%= prefix %>-open-<%= n %>" class="card block p-5 aspect-[4/3] flex items-end text-white no-underline"
     data-lab-card="<%= n %>" data-test="<%= prefix %>-card"
     style="background: linear-gradient(160deg, hsl(<%= n * 47 %> 70% 55%), hsl(<%= n * 47 + 60 %> 70% 32%))">
    <span class="font-semibold">Card <%= n %></span>
  </a>
<% end %>
<main class="max-w-5xl mx-auto px-4 py-10 space-y-12">
  <%= render layout: "studio/carousel",
        locals: { label: "Cascade", items: cards, style: :cascade,
                  slide_label: ->(n) { "Card #{n}" }, caption: ->(n) { "Card #{n}, caption" },
                  data: { lab: "cascade" } } do |n| %>
    <%= capture { card.call(n, "cascade") } %>
  <% end %>
  <%= render layout: "studio/carousel",
        locals: { label: "Three", items: cards, style: :cascade, visible: 3, start: 0,
                  slide_label: ->(n) { "Three #{n}" }, caption: ->(n) { "Three #{n}" },
                  data: { lab: "cascade-three" } } do |n| %>
    <%= capture { card.call(n, "three") } %>
  <% end %>
  <%= render layout: "studio/carousel",
        locals: { label: "Loop", items: cards, style: :cascade, loop: true,
                  autoplay: (1 if params[:autoplay].present?),
                  slide_label: ->(n) { "Loop #{n}" }, caption: ->(n) { "Loop #{n}" },
                  data: { lab: "cascade-loop" } } do |n| %>
    <%= capture { card.call(n, "loop") } %>
  <% end %>
  <%= render layout: "studio/carousel",
        locals: { label: "Five", items: cards.first(5), style: :cascade, loop: true,
                  slide_label: ->(n) { "Five #{n}" }, caption: ->(n) { "Five #{n}" },
                  data: { lab: "cascade-five" } } do |n| %>
    <%= capture { card.call(n, "five") } %>
  <% end %>

  <%# THE IMAGE-ONLY PATTERN (docs: README, The carousel). The card is the picture
      alone, filling it; the open card wears a ring (in-data-current: the slide the
      carousel marks open); the captions sit in one stack under the row, every one in
      the same grid cell, and the carousel-captions controller marks the open one. %>
  <div data-studio-controller="carousel-captions" data-lab-stage="portfolio">
    <%= render layout: "studio/carousel",
          locals: { label: "Portfolio", items: cards, style: :cascade, loop: true, dots: false,
                    slide_label: ->(n) { "App #{n}" }, data: { lab: "cascade-portfolio" } } do |n| %>
      <a href="#portfolio-open-<%= n %>" id="portfolio-app-<%= n %>" aria-label="App <%= n %>" data-test="portfolio-card" data-lab-card="<%= n %>"
         class="block aspect-[4/3] overflow-hidden rounded-2xl bg-surface-alt transition-shadow duration-300 in-data-current:ring-2 in-data-current:ring-primary in-data-current:shadow-xl">
        <img src="<%= capture { picture.call(n) }.strip %>" alt="" class="h-full w-full object-cover">
      </a>
    <% end %>
    <div class="grid pt-4 text-center">
      <% cards.each_with_index do |n, index| %>
        <div class="col-start-1 row-start-1 opacity-0 invisible transition-opacity duration-200 motion-reduce:transition-none data-current:opacity-100 data-current:visible"
             data-carousel-captions-target="caption" data-test="portfolio-caption"<%= " data-current".html_safe if index.zero? %><%= ' aria-hidden="true"'.html_safe unless index.zero? %>>
          <h2 class="type-h4 text-heading">App <%= n %></h2>
          <p class="text-sm text-secondary">The caption for app <%= n %>, under the stack.</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# ONE CAROUSEL PER CAPTION WRAPPER. The captions follow the wrapper's own row (its
      carousel target, else the first row inside it); a second row inside the same
      wrapper moves nothing here. %>
  <div data-studio-controller="carousel-captions" data-lab-stage="scoped">
    <%= render layout: "studio/carousel",
          locals: { label: "Scoped", items: cards.first(3), style: :cascade, start: 0, dots: false,
                    slide_label: ->(n) { "Scoped #{n}" }, data: { lab: "scoped" } } do |n| %>
      <%= capture { card.call(n, "scoped") } %>
    <% end %>
    <div class="grid pt-4 text-center">
      <% cards.first(3).each_with_index do |n, index| %>
        <p class="col-start-1 row-start-1 opacity-0 invisible transition-opacity duration-200 motion-reduce:transition-none data-current:opacity-100 data-current:visible"
           data-carousel-captions-target="caption"<%= " data-current".html_safe if index.zero? %><%= ' aria-hidden="true"'.html_safe unless index.zero? %>>Scoped caption <%= n %></p>
      <% end %>
    </div>
    <%= render layout: "studio/carousel",
          locals: { label: "Scoped other", items: cards.first(3), style: :cascade, start: 0, dots: false,
                    slide_label: ->(n) { "Other #{n}" }, data: { lab: "scoped-other" } } do |n| %>
      <%= capture { card.call(n, "other") } %>
    <% end %>
  </div>
</main>

<%= javascript_tag nonce: true do %>
  // The lab's log of every change event, for e2e/carousel_cascade.spec.js.
  window.__carouselChanges = []
  document.addEventListener("studio:carousel:change", ({ target, detail }) => {
    window.__carouselChanges.push({
      lab: target.dataset.lab, index: detail.index, previous: detail.previous, total: detail.total,
      slide: detail.slide.getAttribute("aria-label"), marked: detail.slide.hasAttribute("data-current")
    })
  })
<% end %>
